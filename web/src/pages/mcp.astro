---
import BaseLayout from "../layouts/BaseLayout.astro";

const mcpConfigJson = "claude mcp add --transport http openswissdata https://mcp.openswissdata.com/mcp/jsonrpc";
const freeTools = ["tariff_lookup", "kyc_check", "cross_walk"];

const tools = [
  {
    pack: "TARES",
    name: "tariff_lookup",
    desc: "Recherche d’un tarif suisse à huit chiffres, avec unité, conditions et limites du résumé.",
    args: { hs8: "09011100", lang: "fr" },
    scope: "tariff:read",
  },
  {
    pack: "TARES",
    name: "tariff_semantic_search",
    desc: "Recherche par similarité dans un index distinct des fichiers : son actualisation n’est pas automatique.",
    args: { query: "bijoux en or 18 carats", top_k: 5 },
    scope: "tariff:semantic",
  },
  {
    pack: "TARES",
    name: "tariff_changelog",
    desc: "Changements observés entre les versions TARES archivées. La profondeur dépend des versions disponibles.",
    args: { hs8: "09011100", since: "2025-01-01" },
    scope: "tariff:semantic",
  },
  {
    pack: "Classifications",
    name: "cross_walk",
    desc: "Correspondances sourcées entre NOGA, NACE et ISIC, avec relation exacte ou approchée et limites explicites.",
    args: { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    scope: "classifications:read",
  },
  {
    pack: "Classifications",
    name: "classify_text",
    desc: "Suggestions de codes NOGA 2025 à partir d’un texte. Le score de similarité n’est pas une probabilité ni une décision officielle.",
    args: { text: "vente de café en grain et torréfaction", top_k: 3 },
    scope: "classifications:semantic",
  },
  {
    pack: "FINMA",
    name: "kyc_check",
    desc: "Recherche par nom dans le registre FINMA et, séparément, les avertissements. Un nom similaire ne prouve pas une identité.",
    args: { name: "UBS Switzerland AG" },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "finma_search",
    desc: "Recherche approchée par nom dans le registre FINMA ; les avertissements restent distincts.",
    args: { name: "Vontobel", top_k: 5, include_warnings: true },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "entity_history",
    desc: "Changements observés dans les instantanés disponibles. Les dates d’observation ne sont pas des dates de décision officielle.",
    args: { uid: "CHE-101.329.561" },
    scope: "finma:history",
  },
];
---
<BaseLayout
  title="MCP server openswissdata — datasets fédéraux suisses pour Claude Code & Cursor"
  description="TARES, NOGA et FINMA via JSON-RPC. Trois outils sans compte, 100 requêtes par jour et par IP. Autres outils soumis aux droits existants."
>

<div class="bg-grid"></div>

<!-- ========== HERO ========== -->
<section class="v4-hero">
  <div class="container-v4">
    <div class="reveal-v4">
      <div class="v4-eyebrow">
        <span>Model Context Protocol</span>
        <span style="opacity:.4">·</span>
        <span class="check">3 outils sans compte · 100 requêtes/jour/IP</span>
      </div>

      <h1 class="v4-h1" style="max-width:24ch;">
        Un serveur MCP suisse pour <span class="accent">Claude Code &amp; Cursor.</span>
      </h1>

      <p class="v4-lede" style="max-width:62ch;">
        Branchez les datasets fédéraux suisses (TARES, NOGA, FINMA) directement dans votre agent IA. JSON-RPC 2.0, embeddings multilingues pré-calculés, manifest cryptographique signé. <strong>Free tier 100 req/jour.</strong>
      </p>

      <div class="v4-spec-row">
        <div class="v4-spec">
          <div class="v4-spec-label">Endpoints</div>
          <div class="v4-spec-value">8 tools</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">URL</div>
          <div class="v4-spec-value">mcp.openswissdata.com</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">Spec</div>
          <div class="v4-spec-value">MCP 2025-11-25</div>
        </div>
      </div>

      <div class="v4-cta-row">
        <a href="#install" class="v4-btn v4-btn-primary">Installer dans Claude Code <span class="arrow">→</span></a>
        <a href="#tools" class="v4-btn v4-btn-secondary">Documentation</a>
        <a href="#playground" class="v4-btn-mono">Sandbox playground</a>
      </div>

      <div class="v4-permission-line">
        <span><strong>Standard ouvert :</strong> JSON-RPC 2.0 over HTTPS</span>
        <span style="opacity:.4">·</span>
        <span><strong>Auth :</strong> Bearer token (OAuth 2.1 disponible)</span>
        <span style="opacity:.4">·</span>
        <span class="ok">Hébergement européen</span>
      </div>
    </div>
  </div>
</section>

<!-- ========== INSTALL ========== -->
<section class="v4-personas" id="install" style="padding-top:60px;">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Installation</strong>
      <span class="sep">/</span>
      <span>Connexion HTTP</span>
    </div>
    <h2 class="v4-section-h2">Connectez openswissdata à Claude Code.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Étape 1 · Ajouter le serveur</p>
      <p style="margin-bottom:14px;">Dans un terminal où Claude Code est installé :</p>

      <pre style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-bottom:24px;">{mcpConfigJson}</pre>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Étape 2 · Redémarrer Claude Code</p>
      <p style="margin-bottom:14px;">Vérifiez la connexion avec <code>/mcp</code>. Trois outils sont accessibles sans compte ; les autres nécessitent des droits existants.</p>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Étape 3 · Tester</p>
      <p>Demandez par exemple : <em>« Consulte le tarif TARES 09011100 avec tariff_lookup »</em>. Vérifiez ensuite l’unité et les conditions retournées.</p>
    </div>

    <p style="font-size:13px;margin-top:14px;">Installation Claude Code : <a href="https://code.claude.com/docs/en/mcp">documentation officielle</a>. Les exemples JSON-RPC ci-dessous permettent aussi de tester le service.</p>
  </div>
</section>

<!-- ========== TOOLS ========== -->
<section class="v4-datasets" id="tools">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>8 tools disponibles</strong>
      <span class="sep">/</span>
      <span>JSON-RPC 2.0</span>
      <span class="sep">/</span>
      <span>spec 2025-11-25</span>
    </div>
    <h2 class="v4-section-h2">Trois packs de données. Huit outils.</h2>

    {["TARES", "Classifications", "FINMA"].map(packName => (
      <div style="margin-bottom:32px;">
        <h3 style="font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;font-weight:600;">{`// pack ${packName}`}</h3>
        <div style="display:grid;grid-template-columns:1fr;gap:14px;">
          {tools.filter(t => t.pack === packName).map(tool => {
            const authHeader = freeTools.includes(tool.name) ? "" : '  -H "Authorization: Bearer <access_token>" \\\n';
            const curlExample = `curl -X POST https://mcp.openswissdata.com/mcp/jsonrpc \\
  -H "Content-Type: application/json" \\
${authHeader}  -d '${JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: tool.name, arguments: tool.args } }, null, 2)}'`;
            return (
              <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:22px;">
                <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px;">
                  <code style="font-family:var(--font-mono);font-size:14px;font-weight:600;color:var(--ink);">{tool.name}</code>
                  <span style="font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:var(--green-soft);color:var(--green);border:1px solid rgba(21,128,61,.2);padding:3px 8px;border-radius:4px;font-weight:600;white-space:nowrap;">{freeTools.includes(tool.name) ? 'Sans compte' : 'Droits requis'}</span>
                </div>
                <p style="font-size:14px;color:var(--ink-soft);margin-bottom:14px;line-height:1.5;">{tool.desc}</p>
                <details style="font-family:var(--font-mono);font-size:12px;">
                  <summary style="cursor:pointer;color:var(--ink);font-weight:500;padding:6px 0;">Exemple d'appel curl ↓</summary>
                  <pre style="background:#0A0A0C;color:#fafafa;padding:14px 16px;border-radius:6px;margin-top:8px;line-height:1.6;overflow-x:auto;font-size:11.5px;">{curlExample}</pre>
                </details>
                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                  <span style="font-family:var(--font-mono);font-size:10px;background:var(--bg-soft);border:1px solid var(--line);color:var(--ink-soft);padding:3px 8px;border-radius:3px;">scope: {tool.scope}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ========== PLAYGROUND ========== -->
<div class="container-v4"><p class="mcp-availability" style="padding:20px;border:1px solid var(--line);border-radius:12px;line-height:1.8;margin:24px 0;">Accès sans compte : tariff_lookup, kyc_check et cross_walk (100 requêtes/jour par IP). Les autres outils exigent les droits correspondants ; les nouvelles souscriptions payantes sont fermées. STATENT est suspendu en attente de preuve de droit de redistribution. Les index vectoriels ne sont pas actualisés par les collectes de fichiers.</p></div>
<section class="v4-personas" id="playground">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Sandbox playground</strong>
      <span class="sep">/</span>
      <span>essaie tout de suite</span>
    </div>
    <h2 class="v4-section-h2">Sans installer Claude Code, teste les endpoints depuis ton navigateur.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <div class="mcp-playground-row">
        <div>
          <label for="pg-tool" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Tool</label>
          <select id="pg-tool" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);">
            {tools.filter(t => freeTools.includes(t.name)).map(t => <option value={t.name}>{t.name}</option>)}
          </select>
        </div>
        <div>
          <label for="pg-args" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Arguments JSON</label>
          <input id="pg-args" type="text" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);" />
        </div>
      </div>
      <button id="pg-run" class="v4-btn v4-btn-primary" style="width:auto;">Try it <span class="arrow">→</span></button>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--ink-mute);margin-top:10px;">→ Free tier : 100 req/jour par IP. Pas besoin de compte pour tester.</p>

      <pre id="pg-output" style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-top:18px;min-height:200px;">→ Sélectionne un tool, ajuste les arguments, clique sur "Try it"…</pre>
    </div>
  </div>
</section>

<!-- ========== PRICING ========== -->
<section class="v4-datasets">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Pricing</strong>
      <span class="sep">/</span>
      <span>généreux par design</span>
    </div>
    <h2 class="v4-section-h2">Testez gratuitement. Consultez les offres.</h2>

    <p class="subscription-notice">Les nouveaux abonnements Pro et Business sont temporairement indisponibles. L’accès gratuit et les achats de fichiers restent disponibles.</p>

      <div class="mcp-pricing-grid">
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Free</div>
        <div class="mcp-pc-price">0 CHF</div>
        <p class="mcp-pc-sub">100 req/jour par IP. Aucun compte requis pour tester.</p>
        <a href="#install" class="v4-btn v4-btn-secondary mcp-pc-cta">Tester maintenant <span class="arrow">→</span></a>
      </div>
      <div class="mcp-pc pop">
        <span class="mcp-pc-badge">indisponible</span>
        <div class="mcp-pc-tier" style="color:var(--accent);">Pro</div>
        <div class="mcp-pc-price">49 CHF<small>/mois</small></div>
        <p class="mcp-pc-sub">5 000 req/mois. Offre actuellement fermée aux nouvelles souscriptions.</p>
        <p class="subscription-status">Souscriptions temporairement fermées</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Business</div>
        <div class="mcp-pc-price">199 CHF<small>/mois</small></div>
        <p class="mcp-pc-sub">50 000 req/mois + tools avancés. Fintechs &amp; intégrateurs ERP.</p>
        <p class="subscription-status">Souscriptions temporairement fermées</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Enterprise</div>
        <div class="mcp-pc-price">Sur devis</div>
        <p class="mcp-pc-sub">Volumes, formats et accompagnement à définir selon votre besoin.</p>
        <a href="mailto:contact@openswissdata.com?subject=openswissdata%20Enterprise%20(devis)" class="v4-btn v4-btn-secondary mcp-pc-cta">Demander un devis <span class="arrow">→</span></a>
      </div>
    </div>
    <div style="text-align:center;margin-top:20px;">
      <a href="/pricing" class="v4-btn-mono">Comparer les offres en détail</a>
    </div>
  </div>
</section>

<!-- ========== CTA FINAL ========== -->
<section class="v4-cta-final">
  <div class="container-v4">
    <h2>Des données suisses pour vos agents.</h2>
    <p>Free tier 100 req/jour. Aucun compte requis pour tester. Open spec MCP 2025-11-25.</p>
    <div class="v4-cta-final-row">
      <a href="#install" class="v4-btn v4-btn-primary">Connecter maintenant <span class="arrow">→</span></a>
      <a href="/datasets/classifications" class="v4-btn v4-btn-secondary">Voir les classifications</a>
      <a href="/legal/provenance" class="v4-btn-mono">Provenance &amp; signature</a>
    </div>
  </div>
</section>

<style>
  .mcp-pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 24px;
  }
  .mcp-pc {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
  }
  .mcp-pc.pop { border: 2px solid var(--accent); position: relative; }
  .mcp-pc-badge {
    position: absolute;
    top: -10px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    font-weight: 600;
  }
  .mcp-pc-tier {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .mcp-pc-price {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -.018em;
    margin-bottom: 4px;
    line-height: 1;
  }
  .mcp-pc-price small { font-size: 13px; font-weight: 500; color: var(--ink-mute); }
  .mcp-pc-sub {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0 0 16px;
    flex: 1;
  }
  .mcp-pc form { margin: 0; }
  .mcp-pc-cta { width: 100%; justify-content: center; font-size: 13px; padding: 10px; }
  .mcp-playground-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  @media (max-width: 1024px) {
    .mcp-pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .mcp-pricing-grid { grid-template-columns: 1fr; }
    .mcp-playground-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const TOOL_DEFAULTS = {
    "tariff_lookup": { hs8: "09011100", lang: "fr" },
    "tariff_semantic_search": { query: "bijoux en or 18 carats", top_k: 5 },
    "tariff_changelog": { hs8: "09011100", since: "2025-01-01" },
    "cross_walk": { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    "classify_text": { text: "vente de café en grain et torréfaction", top_k: 3 },
    "kyc_check": { name: "UBS Switzerland AG" },
    "finma_search": { name: "Vontobel", top_k: 5 },
    "entity_history": { uid: "CHE-101.329.561" },
  };
  const sel = document.getElementById('pg-tool');
  const args = document.getElementById('pg-args');
  const run = document.getElementById('pg-run');
  const out = document.getElementById('pg-output');
  function refreshArgs() {
    args.value = JSON.stringify(TOOL_DEFAULTS[sel.value] || {});
  }
  if (sel) {
    refreshArgs();
    sel.addEventListener('change', refreshArgs);
  }
  if (run) {
    run.addEventListener('click', async () => {
      out.textContent = "→ Calling " + sel.value + "...";
      try {
        const parsedArgs = JSON.parse(args.value);
        const res = await fetch('https://mcp.openswissdata.com/mcp/jsonrpc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: "2.0",
            id: Date.now(),
            method: "tools/call",
            params: { name: sel.value, arguments: parsedArgs }
          })
        });
        const json = await res.json();
        out.textContent = JSON.stringify(json, null, 2);
      } catch (err) {
        out.textContent = "✗ Error: " + (err.message || err);
      }
    });
  }
</script>

</BaseLayout>
