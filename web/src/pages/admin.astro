---
import "../styles/fonts-geist.css";
import '../styles/admin.css';
const sections = [
 ['overview','Vue d’ensemble','▦'],['clients','Clients','◎'],['mail','Messagerie','✉'],
 ['audience','Audience','↗'],['visibility','Visibilité','⌕'],['data','Données','▤'],['operations','Automatisations','↻'],
];
---
<!doctype html>
<html lang="fr-CH">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="same-origin" />
  <title>Le bureau · OpenSwissData</title><link rel="icon" href="/favicon.svg" />
</head>
<body>
  <a id="skip-content" class="skip" href="#gate">Aller au contenu</a>
  <div id="gate" class="gate" role="main" tabindex="-1"><a class="brand" href="/"><img src="/favicon.svg" alt=""/>openswissdata<span>LE BUREAU</span></a><div class="gate-card"><p class="eyebrow">VOTRE ESPACE PRIVÉ</p><h1 id="gate-title" tabindex="-1">Tout commence<br/>par une vue claire.</h1><p id="gate-status" role="status">Vérification de votre accès…</p><form id="login-form" hidden><label>Votre adresse administrateur<input type="email" name="email" autocomplete="email" required placeholder="vous@exemple.ch"/></label><button class="primary" type="submit">Recevoir mon lien de connexion <span>→</span></button><p class="fine">Le lien est envoyé à votre adresse habituelle. L’accès reste réservé aux comptes autorisés.</p></form></div><p class="gate-foot">OpenSwissData · Données suisses, idées claires.</p></div>
  <div id="workspace" hidden>
    <aside class="sidebar"><a class="brand" href="/admin"><img src="/favicon.svg" alt=""/>openswissdata<span>LE BUREAU</span></a><p class="nav-caption">VOTRE ACTIVITÉ</p><nav aria-label="Navigation principale">{sections.map(([id,label,icon])=><a href={`#${id}`} data-nav={id}><span class="nav-icon" aria-hidden="true">{icon}</span>{label}<span class="nav-badge" id={`badge-${id}`}></span></a>)}</nav><div class="sidebar-bottom"><div class="live-dot">Espace privé</div><a href="/" target="_blank" rel="noopener">Voir le site <span>↗</span></a><button id="logout" class="text-button">Se déconnecter</button></div></aside>
    <div class="workspace-main">
      <header class="topbar"><div class="breadcrumb">OpenSwissData <span>/</span> <strong id="section-label">Vue d’ensemble</strong></div><div class="top-actions"><span class="today" id="today"></span><button id="refresh" class="icon-button" aria-label="Actualiser les données" title="Actualiser">↻</button><details class="account-popover"><summary class="avatar" aria-label="Menu du compte administrateur">CA</summary><div><p class="fine">Votre espace privé</p><button id="logout-top" class="text-button">Se déconnecter</button></div></details></div></header>
      <main id="content" tabindex="-1">
        <div class="page-heading"><div><p class="eyebrow" id="page-kicker">VOTRE ACTIVITÉ, EN CLAIR</p><h1 id="page-title" tabindex="-1">Vue d’ensemble</h1><p id="page-description">Les chiffres utiles. Les prochaines actions. Le reste à portée de main.</p></div><label class="period" id="period-control">Période<select id="period"><option value="7">7 derniers jours</option><option value="30" selected>30 derniers jours</option><option value="90">90 derniers jours</option><option value="365">12 derniers mois</option></select></label></div>
        <div id="notice" class="notice" hidden role="alert"></div>
        <p id="page-status" class="sr-only" role="status" aria-atomic="true"></p><div id="view"><div class="loading-panel"><div class="spinner"></div>Lecture de votre activité…</div></div>
        <footer class="workspace-footer"><span id="freshness">Sources en cours de lecture</span><span>Heure suisse · Données privées</span></footer>
      </main>
    </div>
  </div>
  <dialog id="detail" aria-labelledby="detail-label"><div class="dialog-top"><span class="eyebrow" id="detail-label">FICHE CLIENT</span><button class="icon-button" id="close-detail" aria-label="Fermer">✕</button></div><div id="detail-body"></div><div id="dialog-toast" class="toast dialog-toast" hidden role="status"></div></dialog>
  <div id="toast" class="toast" hidden role="status"></div>
  <script>import '../scripts/admin';</script>
</body></html>
