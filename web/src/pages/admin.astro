---
import "../styles/fonts-geist.css";
import '../styles/admin.css';
import AdminIcon from '../components/AdminIcon.astro';
const sections = [
 ['overview','Vue d’ensemble','Votre point de départ'],['clients','Clients','Relations et prochaines actions'],['mail','Messagerie','Échanges et langues'],
 ['audience','Audience','Visites et utilisation'],['visibility','Visibilité','Votre présence sur Google'],['data','Données','Versions et qualité'],['operations','Automatisations','Passages et incidents'],
];
---
<!doctype html>
<html lang="fr-CH">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="same-origin" />
  <title>Le bureau · OpenSwissData</title><link rel="icon" href="/favicon.svg" />
</head>
<body>
  <a id="skip-content" class="skip" href="#gate">Aller au contenu</a>
  <div id="gate" class="gate" role="main" tabindex="-1">
    <a class="brand" href="/"><img src="/favicon.svg" alt=""/>openswissdata<span>LE BUREAU</span></a>
    <div class="gate-layout">
      <div class="gate-intro"><p class="eyebrow">LE BUREAU OPEN SWISSDATA</p><p class="gate-statement">Une vue claire.<br/><em>La suite à portée de main.</em></p><p>Vos clients, vos échanges et la vie du service, dans un même espace.</p><div class="gate-topics"><span><AdminIcon name="clients"/>Relations clients</span><span><AdminIcon name="mail"/>Échanges & langues</span><span><AdminIcon name="audience"/>Activité & visibilité</span></div></div>
      <div class="gate-card"><p class="eyebrow">VOTRE ESPACE PRIVÉ</p><h1 id="gate-title" tabindex="-1">Retrouver<br/>votre bureau.</h1><p id="gate-status" role="status">Vérification de votre accès…</p><form id="login-form" hidden><label>Votre adresse administrateur<input type="email" name="email" autocomplete="email" required placeholder="vous@exemple.ch"/></label><button class="primary" type="submit">Recevoir mon lien de connexion <AdminIcon name="arrow"/></button><p class="fine">Le lien est envoyé à votre adresse habituelle. L’accès reste réservé aux comptes autorisés.</p></form></div>
    </div><p class="gate-foot">OpenSwissData · Données suisses, idées claires.</p>
  </div>
  <div id="workspace" hidden>
    <button id="spaces-dismiss" class="spaces-dismiss" type="button" tabindex="-1" aria-label="Fermer le menu des espaces"></button>
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/admin"><img src="/favicon.svg" alt=""/>openswissdata<span>LE BUREAU</span></a>
      <button id="spaces-toggle" class="spaces-toggle" type="button" aria-expanded="false" aria-controls="workspace-navigation"><AdminIcon name="more"/><span>Les espaces</span></button>
      <nav id="workspace-navigation" aria-label="Tous les espaces du bureau">
        <p class="nav-caption">AU QUOTIDIEN</p>
        {sections.map(([id,label,description],i)=><>{i===3&&<p class="nav-caption nav-separator">COMPRENDRE & PILOTER</p>}<a href={`#${id}`} data-nav={id}><AdminIcon class="nav-icon" name={id}/><span class="nav-copy"><span>{label}</span><small>{description}</small></span><span class="nav-badge" id={`badge-${id}`}></span></a></>)}
      </nav>
      <div class="sidebar-bottom"><div class="live-dot">Votre bureau privé</div><a href="/" target="_blank" rel="noopener">Voir le site <span>↗</span></a><button id="logout" class="text-button">Se déconnecter</button></div>
    </aside>
    <div class="workspace-main">
      <header class="topbar"><div class="breadcrumb"><span class="breadcrumb-brand">Le bureau</span><span aria-hidden="true" class="breadcrumb-separator">/</span><strong id="section-label">Vue d’ensemble</strong></div><div class="top-actions"><span class="today" id="today"></span><button id="refresh" class="icon-button" aria-label="Actualiser les données" title="Actualiser"><AdminIcon name="refresh"/></button><details class="account-popover"><summary class="avatar" aria-label="Menu du compte administrateur">CA</summary><div><p class="fine">Votre espace privé</p><a class="text-button" href="/" target="_blank" rel="noopener">Voir le site ↗</a><button id="logout-top" class="text-button">Se déconnecter</button></div></details></div></header>
      <main id="content" tabindex="-1">
        <div class="page-heading"><div><p class="eyebrow" id="page-kicker">VOTRE ACTIVITÉ, EN CLAIR</p><h1 id="page-title" tabindex="-1">Vue d’ensemble</h1><p id="page-description">Ventes, clients et prochaines actions.</p></div><label class="period" id="period-control">Période<select id="period"><option value="7">7 derniers jours</option><option value="30" selected>30 derniers jours</option><option value="90">90 derniers jours</option><option value="365">365 derniers jours</option></select></label></div>
        <div id="notice" class="notice" hidden role="alert"></div>
        <p id="page-status" class="sr-only" role="status" aria-atomic="true"></p><div id="view"><div class="loading-panel"><div class="spinner"></div>Lecture de votre activité…</div></div>
        <footer class="workspace-footer"><span id="freshness">Sources en cours de lecture</span><span>Heure suisse · Données privées</span></footer>
      </main>
    </div>
    <nav class="mobile-dock" aria-label="Accès rapides du bureau">
      {sections.slice(0,3).map(([id,label])=><a href={`#${id}`} data-nav={id}><AdminIcon name={id}/><span>{id==='overview'?'Vue d’ensemble':label}</span></a>)}
      <button id="spaces-more" type="button" aria-expanded="false" aria-controls="workspace-navigation"><AdminIcon name="more"/><span>Les espaces</span></button>
    </nav>
  </div>
  <dialog id="detail" aria-labelledby="detail-label"><div class="dialog-top"><span class="eyebrow" id="detail-label">FICHE CLIENT</span><button class="icon-button" id="close-detail" aria-label="Fermer">✕</button></div><div id="detail-body"></div><div id="dialog-toast" class="toast dialog-toast" hidden role="status"></div></dialog>
  <div id="toast" class="toast" hidden role="status"></div>
  <script>import '../scripts/admin';</script>
</body></html>
