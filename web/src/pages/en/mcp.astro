---
import BaseLayout from "../../layouts/BaseLayout.astro";

const mcpConfigJson = "claude mcp add --transport http openswissdata https://mcp.openswissdata.com/mcp/jsonrpc";
const freeTools = ["tariff_lookup", "kyc_check", "cross_walk"];

const tools = [
  {
    pack: "TARES",
    name: "tariff_lookup",
    desc: "Look up an eight-digit Swiss tariff code with its unit, conditions and summary limitations.",
    args: { hs8: "09011100", lang: "fr" },
    scope: "tariff:read",
  },
  {
    pack: "TARES",
    name: "tariff_semantic_search",
    desc: "Similarity search in a separate index; file updates do not automatically refresh this index.",
    args: { query: "18-carat gold jewellery", top_k: 5 },
    scope: "tariff:semantic",
  },
  {
    pack: "TARES",
    name: "tariff_changelog",
    desc: "Changes observed between archived TARES versions. Coverage depends on the versions available.",
    args: { hs8: "09011100", since: "2025-01-01" },
    scope: "tariff:semantic",
  },
  {
    pack: "Classifications",
    name: "cross_walk",
    desc: "Sourced mappings between NOGA, NACE and ISIC with exact or approximate relationships and explicit limits.",
    args: { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    scope: "classifications:read",
  },
  {
    pack: "Classifications",
    name: "classify_text",
    desc: "NOGA 2025 suggestions from a text. Similarity is not a probability or an official classification decision.",
    args: { text: "retail of coffee beans and roasting", top_k: 3 },
    scope: "classifications:semantic",
  },
  {
    pack: "FINMA",
    name: "kyc_check",
    desc: "Name search in the FINMA registry and separately in warnings. A similar name does not establish identity.",
    args: { name: "UBS Switzerland AG" },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "finma_search",
    desc: "Approximate name search in the FINMA registry; warnings remain separate.",
    args: { name: "Vontobel", top_k: 5, include_warnings: true },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "entity_history",
    desc: "Changes observed in available snapshots. Observation dates are not official decision dates.",
    args: { uid: "CHE-101.329.561" },
    scope: "finma:history",
  },
];
---
<BaseLayout
  title="openswissdata MCP server — Swiss federal datasets for Claude Code & Cursor"
  description="TARES, NOGA and FINMA over JSON-RPC. Three tools without an account, 100 requests per day per IP. Other tools require existing rights."
>

<div class="bg-grid"></div>

<!-- ========== HERO ========== -->
<section class="v4-hero">
  <div class="container-v4">
    <div class="reveal-v4">
      <div class="v4-eyebrow">
        <span>Model Context Protocol</span>
        <span style="opacity:.4">·</span>
        <span class="check">3 tools without an account · 100 requests/day/IP</span>
      </div>

      <h1 class="v4-h1" style="max-width:24ch;">
        A Swiss MCP server for <span class="accent">Claude Code &amp; Cursor.</span>
      </h1>

      <p class="v4-lede" style="max-width:62ch;">
        Plug Swiss federal datasets (TARES, NOGA, FINMA) directly into your AI agent. JSON-RPC 2.0, pre-computed multilingual embeddings, signed cryptographic manifest. <strong>Free tier 100 req/day.</strong>
      </p>

      <div class="v4-spec-row">
        <div class="v4-spec">
          <div class="v4-spec-label">Endpoints</div>
          <div class="v4-spec-value">8 tools</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">URL</div>
          <div class="v4-spec-value">mcp.openswissdata.com</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">Spec</div>
          <div class="v4-spec-value">MCP 2025-11-25</div>
        </div>
      </div>

      <div class="v4-cta-row">
        <a href="#install" class="v4-btn v4-btn-primary">Install in Claude Code <span class="arrow">→</span></a>
        <a href="#tools" class="v4-btn v4-btn-secondary">Documentation</a>
        <a href="#playground" class="v4-btn-mono">Sandbox playground</a>
      </div>

      <div class="v4-permission-line">
        <span><strong>Open standard:</strong> JSON-RPC 2.0 over HTTPS</span>
        <span style="opacity:.4">·</span>
        <span><strong>Auth:</strong> Bearer token (OAuth 2.1 available)</span>
        <span style="opacity:.4">·</span>
        <span class="ok">Hosted in Switzerland-EU</span>
      </div>
    </div>
  </div>
</section>

<!-- ========== INSTALL ========== -->
<section class="v4-personas" id="install" style="padding-top:60px;">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Installation</strong>
      <span class="sep">/</span>
      <span>HTTP connection</span>
    </div>
    <h2 class="v4-section-h2">Connect openswissdata to Claude Code.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Step 1 · Add the server</p>
      <p style="margin-bottom:14px;">In a terminal with Claude Code installed:</p>

      <pre style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-bottom:24px;">{mcpConfigJson}</pre>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Step 2 · Restart Claude Code</p>
      <p style="margin-bottom:14px;">Check the connection using <code>/mcp</code>. Three tools work without an account; the others require existing access rights.</p>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Step 3 · Test</p>
      <p>For example, ask: <em>“Look up TARES tariff 09011100 using tariff_lookup”</em>. Then check the returned unit and conditions.</p>
    </div>

    <p style="font-size:13px;margin-top:14px;">Claude Code setup: <a href="https://code.claude.com/docs/en/mcp">official documentation</a>. The JSON-RPC examples below also let you test the service.</p>
  </div>
</section>

<!-- ========== TOOLS ========== -->
<section class="v4-datasets" id="tools">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>8 tools available</strong>
      <span class="sep">/</span>
      <span>JSON-RPC 2.0</span>
      <span class="sep">/</span>
      <span>spec 2025-11-25</span>
    </div>
    <h2 class="v4-section-h2">Three data packs. Eight tools.</h2>

    {["TARES", "Classifications", "FINMA"].map(packName => (
      <div style="margin-bottom:32px;">
        <h3 style="font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;font-weight:600;">{`// pack ${packName}`}</h3>
        <div style="display:grid;grid-template-columns:1fr;gap:14px;">
          {tools.filter(t => t.pack === packName).map(tool => {
            const authHeader = freeTools.includes(tool.name) ? "" : '  -H "Authorization: Bearer <access_token>" \\\n';
            const curlExample = `curl -X POST https://mcp.openswissdata.com/mcp/jsonrpc \\
  -H "Content-Type: application/json" \\
${authHeader}  -d '${JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: tool.name, arguments: tool.args } }, null, 2)}'`;
            return (
              <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:22px;">
                <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px;">
                  <code style="font-family:var(--font-mono);font-size:14px;font-weight:600;color:var(--ink);">{tool.name}</code>
                  <span style="font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:var(--green-soft);color:var(--green);border:1px solid rgba(21,128,61,.2);padding:3px 8px;border-radius:4px;font-weight:600;white-space:nowrap;">{freeTools.includes(tool.name) ? 'No account' : 'Access rights required'}</span>
                </div>
                <p style="font-size:14px;color:var(--ink-soft);margin-bottom:14px;line-height:1.5;">{tool.desc}</p>
                <details style="font-family:var(--font-mono);font-size:12px;">
                  <summary style="cursor:pointer;color:var(--ink);font-weight:500;padding:6px 0;">curl example ↓</summary>
                  <pre style="background:#0A0A0C;color:#fafafa;padding:14px 16px;border-radius:6px;margin-top:8px;line-height:1.6;overflow-x:auto;font-size:11.5px;">{curlExample}</pre>
                </details>
                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                  <span style="font-family:var(--font-mono);font-size:10px;background:var(--bg-soft);border:1px solid var(--line);color:var(--ink-soft);padding:3px 8px;border-radius:3px;">scope: {tool.scope}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ========== PLAYGROUND ========== -->
<div class="container-v4"><p class="mcp-availability" style="padding:20px;border:1px solid var(--line);border-radius:12px;line-height:1.8;margin:24px 0;">Available without an account: tariff_lookup, kyc_check and cross_walk (100 requests/day per IP). Other tools require the relevant access rights; new paid subscriptions are closed. STATENT is suspended pending evidence of redistribution rights. Vector indexes are not refreshed by file collection jobs.</p></div>
<section class="v4-personas" id="playground">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Sandbox playground</strong>
      <span class="sep">/</span>
      <span>try it right now</span>
    </div>
    <h2 class="v4-section-h2">Without installing Claude Code, test the endpoints from your browser.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <div class="mcp-playground-row">
        <div>
          <label for="pg-tool" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Tool</label>
          <select id="pg-tool" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);">
            {tools.filter(t => freeTools.includes(t.name)).map(t => <option value={t.name}>{t.name}</option>)}
          </select>
        </div>
        <div>
          <label for="pg-args" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Arguments JSON</label>
          <input id="pg-args" type="text" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);" />
        </div>
      </div>
      <button id="pg-run" class="v4-btn v4-btn-primary" style="width:auto;">Try it <span class="arrow">→</span></button>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--ink-mute);margin-top:10px;">→ Free tier: 100 req/day per IP. No account required to test.</p>

      <pre id="pg-output" style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-top:18px;min-height:200px;">→ Select a tool, adjust the arguments, click "Try it"…</pre>
    </div>
  </div>
</section>

<!-- ========== PRICING ========== -->
<section class="v4-datasets">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Pricing</strong>
      <span class="sep">/</span>
      <span>generous by design</span>
    </div>
    <h2 class="v4-section-h2">Free tier capable. Pro for production workflows.</h2>

    <p class="subscription-notice">New Pro and Business subscriptions are temporarily unavailable. Free access and dataset file purchases remain available.</p>

      <div class="mcp-pricing-grid">
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Free</div>
        <div class="mcp-pc-price">0 CHF</div>
        <p class="mcp-pc-sub">100 req/day per IP. No account required to test.</p>
        <a href="#install" class="v4-btn v4-btn-secondary mcp-pc-cta">Test now <span class="arrow">→</span></a>
      </div>
      <div class="mcp-pc pop">
        <span class="mcp-pc-badge">currently closed</span>
        <div class="mcp-pc-tier" style="color:var(--accent);">Pro</div>
        <div class="mcp-pc-price">49 CHF<small>/month</small></div>
        <p class="mcp-pc-sub">5,000 req/month. Currently closed to new subscriptions.</p>
        <p class="subscription-status">New subscriptions temporarily closed</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Business</div>
        <div class="mcp-pc-price">199 CHF<small>/month</small></div>
        <p class="mcp-pc-sub">50,000 req/month + advanced tools. Fintechs &amp; ERP integrators.</p>
        <p class="subscription-status">New subscriptions temporarily closed</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Enterprise</div>
        <div class="mcp-pc-price">Custom</div>
        <p class="mcp-pc-sub">Unlimited volume, SLA, bespoke. Banks &amp; large accounts.</p>
        <a href="mailto:contact@openswissdata.com?subject=openswissdata%20Enterprise%20(quote)" class="v4-btn v4-btn-secondary mcp-pc-cta">Request a quote <span class="arrow">→</span></a>
      </div>
    </div>
    <div style="text-align:center;margin-top:20px;">
      <a href="/pricing" class="v4-btn-mono">Compare plans in detail</a>
    </div>
  </div>
</section>

<!-- ========== FINAL CTA ========== -->
<section class="v4-cta-final">
  <div class="container-v4">
    <h2>Swiss data for your agents.</h2>
    <p>Free tier 100 req/day. No account required to test. Open MCP spec 2025-11-25.</p>
    <div class="v4-cta-final-row">
      <a href="#install" class="v4-btn v4-btn-primary">Connect now <span class="arrow">→</span></a>
      <a href="/en/datasets/classifications" class="v4-btn v4-btn-secondary">See classifications</a>
      <a href="/de/legal/provenance" class="v4-btn-mono">Provenance &amp; signature</a>
    </div>
  </div>
</section>

<style>
  .mcp-pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 24px;
  }
  .mcp-pc {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
  }
  .mcp-pc.pop { border: 2px solid var(--accent); position: relative; }
  .mcp-pc-badge {
    position: absolute;
    top: -10px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    font-weight: 600;
  }
  .mcp-pc-tier {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .mcp-pc-price {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -.018em;
    margin-bottom: 4px;
    line-height: 1;
  }
  .mcp-pc-price small { font-size: 13px; font-weight: 500; color: var(--ink-mute); }
  .mcp-pc-sub {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0 0 16px;
    flex: 1;
  }
  .mcp-pc form { margin: 0; }
  .mcp-pc-cta { width: 100%; justify-content: center; font-size: 13px; padding: 10px; }
  .mcp-playground-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  @media (max-width: 1024px) {
    .mcp-pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .mcp-pricing-grid { grid-template-columns: 1fr; }
    .mcp-playground-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const TOOL_DEFAULTS = {
    "tariff_lookup": { hs8: "09011100", lang: "fr" },
    "tariff_semantic_search": { query: "18-carat gold jewellery", top_k: 5 },
    "tariff_changelog": { hs8: "09011100", since: "2025-01-01" },
    "cross_walk": { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    "classify_text": { text: "retail of coffee beans and roasting", top_k: 3 },
    "kyc_check": { name: "UBS Switzerland AG" },
    "finma_search": { name: "Vontobel", top_k: 5 },
    "entity_history": { uid: "CHE-101.329.561" },
  };
  const sel = document.getElementById('pg-tool');
  const args = document.getElementById('pg-args');
  const run = document.getElementById('pg-run');
  const out = document.getElementById('pg-output');
  function refreshArgs() {
    args.value = JSON.stringify(TOOL_DEFAULTS[sel.value] || {});
  }
  if (sel) {
    refreshArgs();
    sel.addEventListener('change', refreshArgs);
  }
  if (run) {
    run.addEventListener('click', async () => {
      out.textContent = "→ Calling " + sel.value + "...";
      try {
        const parsedArgs = JSON.parse(args.value);
        const res = await fetch('https://mcp.openswissdata.com/mcp/jsonrpc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: "2.0",
            id: Date.now(),
            method: "tools/call",
            params: { name: sel.value, arguments: parsedArgs }
          })
        });
        const json = await res.json();
        out.textContent = JSON.stringify(json, null, 2);
      } catch (err) {
        out.textContent = "✗ Error: " + (err.message || err);
      }
    });
  }
</script>

</BaseLayout>
