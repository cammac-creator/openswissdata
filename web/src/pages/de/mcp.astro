---
import BaseLayout from "../../layouts/BaseLayout.astro";

const mcpConfigJson = "claude mcp add --transport http openswissdata https://mcp.openswissdata.com/mcp/jsonrpc";
const freeTools = ["tariff_lookup", "kyc_check", "cross_walk"];

const tools = [
  {
    pack: "TARES",
    name: "tariff_lookup",
    desc: "Suche nach einer achtstelligen Schweizer Zolltarifnummer mit Einheit, Bedingungen und Grenzen der Zusammenfassung.",
    args: { hs8: "09011100", lang: "de" },
    scope: "tariff:read",
  },
  {
    pack: "TARES",
    name: "tariff_semantic_search",
    desc: "Ähnlichkeitssuche in einem separaten Index; Dateiaktualisierungen erneuern diesen Index nicht automatisch.",
    args: { query: "Schmuck aus 18-Karat-Gold", top_k: 5 },
    scope: "tariff:semantic",
  },
  {
    pack: "TARES",
    name: "tariff_changelog",
    desc: "Beobachtete Änderungen zwischen archivierten TARES-Versionen. Der Zeitraum hängt von den verfügbaren Versionen ab.",
    args: { hs8: "09011100", since: "2025-01-01" },
    scope: "tariff:semantic",
  },
  {
    pack: "Classifications",
    name: "cross_walk",
    desc: "Belegte Zuordnungen zwischen NOGA, NACE und ISIC mit genauer oder ungefährer Beziehung und Grenzen.",
    args: { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    scope: "classifications:read",
  },
  {
    pack: "Classifications",
    name: "classify_text",
    desc: "Vorschläge für NOGA-2025-Codes anhand eines Textes. Ähnlichkeit ist keine Wahrscheinlichkeit oder amtliche Entscheidung.",
    args: { text: "Verkauf von Kaffeebohnen und Rösterei", top_k: 3 },
    scope: "classifications:semantic",
  },
  {
    pack: "FINMA",
    name: "kyc_check",
    desc: "Namenssuche im FINMA-Register und separat in Warnungen. Ein ähnlicher Name beweist keine Identität.",
    args: { name: "UBS Switzerland AG" },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "finma_search",
    desc: "Ungefähre Namenssuche im FINMA-Register; Warnungen bleiben getrennt.",
    args: { name: "Vontobel", top_k: 5, include_warnings: true },
    scope: "finma:read",
  },
  {
    pack: "FINMA",
    name: "entity_history",
    desc: "Beobachtete Änderungen in verfügbaren Datenständen. Beobachtungsdaten sind keine amtlichen Entscheidungsdaten.",
    args: { uid: "CHE-101.329.561" },
    scope: "finma:history",
  },
];
---
<BaseLayout
  title="MCP Server openswissdata — Schweizer Bundes-Datasets für Claude Code & Cursor"
  description="TARES, NOGA und FINMA über JSON-RPC. Drei Tools ohne Konto, 100 Anfragen pro Tag und IP. Weitere Tools benötigen bestehende Rechte."
>

<div class="bg-grid"></div>

<!-- ========== HERO ========== -->
<section class="v4-hero">
  <div class="container-v4">
    <div class="reveal-v4">
      <div class="v4-eyebrow">
        <span>Model Context Protocol</span>
        <span style="opacity:.4">·</span>
        <span class="check">3 Tools ohne Konto · 100 Anfragen/Tag/IP</span>
      </div>

      <h1 class="v4-h1" style="max-width:24ch;">
        Ein Schweizer MCP-Server für <span class="accent">Claude Code &amp; Cursor.</span>
      </h1>

      <p class="v4-lede" style="max-width:62ch;">
        Verbinden Sie die Schweizer Bundes-Datasets (TARES, NOGA, FINMA) direkt mit Ihrem KI-Agenten. JSON-RPC 2.0, vorberechnete mehrsprachige Embeddings, kryptografisch signiertes Manifest. <strong>Free Tier 100 Req/Tag.</strong>
      </p>

      <div class="v4-spec-row">
        <div class="v4-spec">
          <div class="v4-spec-label">Endpoints</div>
          <div class="v4-spec-value">8 Tools</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">URL</div>
          <div class="v4-spec-value">mcp.openswissdata.com</div>
        </div>
        <div class="v4-spec">
          <div class="v4-spec-label">Spec</div>
          <div class="v4-spec-value">MCP 2025-11-25</div>
        </div>
      </div>

      <div class="v4-cta-row">
        <a href="#install" class="v4-btn v4-btn-primary">In Claude Code installieren <span class="arrow">→</span></a>
        <a href="#tools" class="v4-btn v4-btn-secondary">Dokumentation</a>
        <a href="#playground" class="v4-btn-mono">Sandbox Playground</a>
      </div>

      <div class="v4-permission-line">
        <span><strong>Offener Standard:</strong> JSON-RPC 2.0 über HTTPS</span>
        <span style="opacity:.4">·</span>
        <span><strong>Auth:</strong> Bearer Token (OAuth 2.1 verfügbar)</span>
        <span style="opacity:.4">·</span>
        <span class="ok">Hosting in Europa</span>
      </div>
    </div>
  </div>
</section>

<!-- ========== INSTALL ========== -->
<section class="v4-personas" id="install" style="padding-top:60px;">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Installation</strong>
      <span class="sep">/</span>
      <span>HTTP-Verbindung</span>
    </div>
    <h2 class="v4-section-h2">Verbinden Sie openswissdata mit Claude Code.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Schritt 1 · Server hinzufügen</p>
      <p style="margin-bottom:14px;">In einem Terminal mit installiertem Claude Code:</p>

      <pre style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-bottom:24px;">{mcpConfigJson}</pre>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Schritt 2 · Claude Code neu starten</p>
      <p style="margin-bottom:14px;">Prüfen Sie die Verbindung mit <code>/mcp</code>. Drei Tools sind ohne Konto zugänglich; die übrigen benötigen bestehende Zugriffsrechte.</p>

      <p style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:8px;">Schritt 3 · Testen</p>
      <p>Fragen Sie zum Beispiel: <em>„Rufe den TARES-Tarif 09011100 mit tariff_lookup ab“</em>. Prüfen Sie danach die Einheit und Bedingungen.</p>
    </div>

    <p style="font-size:13px;margin-top:14px;">Claude-Code-Einrichtung: <a href="https://code.claude.com/docs/en/mcp">offizielle Dokumentation</a>. Die folgenden JSON-RPC-Beispiele erlauben ebenfalls einen Test.</p>
  </div>
</section>

<!-- ========== TOOLS ========== -->
<section class="v4-datasets" id="tools">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>9 verfügbare Tools</strong>
      <span class="sep">/</span>
      <span>JSON-RPC 2.0</span>
      <span class="sep">/</span>
      <span>Spec 2025-11-25</span>
    </div>
    <h2 class="v4-section-h2">Drei Datenpakete. Acht Tools.</h2>

    {["TARES", "Classifications", "FINMA"].map(packName => (
      <div style="margin-bottom:32px;">
        <h3 style="font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;font-weight:600;">{`// pack ${packName}`}</h3>
        <div style="display:grid;grid-template-columns:1fr;gap:14px;">
          {tools.filter(t => t.pack === packName).map(tool => {
            const authHeader = freeTools.includes(tool.name) ? "" : '  -H "Authorization: Bearer <access_token>" \\\n';
            const curlExample = `curl -X POST https://mcp.openswissdata.com/mcp/jsonrpc \\
  -H "Content-Type: application/json" \\
${authHeader}  -d '${JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: tool.name, arguments: tool.args } }, null, 2)}'`;
            return (
              <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:22px;">
                <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px;">
                  <code style="font-family:var(--font-mono);font-size:14px;font-weight:600;color:var(--ink);">{tool.name}</code>
                  <span style="font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:var(--green-soft);color:var(--green);border:1px solid rgba(21,128,61,.2);padding:3px 8px;border-radius:4px;font-weight:600;white-space:nowrap;">{freeTools.includes(tool.name) ? 'Ohne Konto' : 'Zugriffsrechte nötig'}</span>
                </div>
                <p style="font-size:14px;color:var(--ink-soft);margin-bottom:14px;line-height:1.5;">{tool.desc}</p>
                <details style="font-family:var(--font-mono);font-size:12px;">
                  <summary style="cursor:pointer;color:var(--ink);font-weight:500;padding:6px 0;">curl-Aufruf-Beispiel ↓</summary>
                  <pre style="background:#0A0A0C;color:#fafafa;padding:14px 16px;border-radius:6px;margin-top:8px;line-height:1.6;overflow-x:auto;font-size:11.5px;">{curlExample}</pre>
                </details>
                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                  <span style="font-family:var(--font-mono);font-size:10px;background:var(--bg-soft);border:1px solid var(--line);color:var(--ink-soft);padding:3px 8px;border-radius:3px;">scope: {tool.scope}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ========== PLAYGROUND ========== -->
<div class="container-v4"><p class="mcp-availability" style="padding:20px;border:1px solid var(--line);border-radius:12px;line-height:1.8;margin:24px 0;">Ohne Konto verfügbar: tariff_lookup, kyc_check und cross_walk (100 Anfragen/Tag je IP). Andere Werkzeuge benötigen entsprechende Rechte; neue kostenpflichtige Abonnements sind geschlossen. STATENT ist bis zum Nachweis der Weiterverbreitungsrechte ausgesetzt. Vektorindizes werden nicht durch Dateierhebungen aktualisiert.</p></div>
<section class="v4-personas" id="playground">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Sandbox Playground</strong>
      <span class="sep">/</span>
      <span>jetzt ausprobieren</span>
    </div>
    <h2 class="v4-section-h2">Ohne Claude Code zu installieren, testen Sie die Endpoints im Browser.</h2>

    <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:12px;padding:28px;margin-top:24px;">
      <div class="mcp-playground-row">
        <div>
          <label for="pg-tool" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Tool</label>
          <select id="pg-tool" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);">
            {tools.filter(t => freeTools.includes(t.name)).map(t => <option value={t.name}>{t.name}</option>)}
          </select>
        </div>
        <div>
          <label for="pg-args" style="display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:6px;">Argumente JSON</label>
          <input id="pg-args" type="text" style="width:100%;padding:10px 14px;font-family:var(--font-mono);font-size:13px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);" />
        </div>
      </div>
      <button id="pg-run" class="v4-btn v4-btn-primary" style="width:auto;">Try it <span class="arrow">→</span></button>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--ink-mute);margin-top:10px;">→ Free Tier: 100 Req/Tag pro IP. Kein Account zum Testen nötig.</p>

      <pre id="pg-output" style="background:#0A0A0C;color:#fafafa;padding:18px 22px;border-radius:8px;font-family:var(--font-mono);font-size:13px;line-height:1.6;overflow-x:auto;margin-top:18px;min-height:200px;">→ Tool auswählen, Argumente anpassen, „Try it" klicken…</pre>
    </div>
  </div>
</section>

<!-- ========== PRICING ========== -->
<section class="v4-datasets">
  <div class="container-v4">
    <div class="v4-section-eyebrow">
      <strong>Pricing</strong>
      <span class="sep">/</span>
      <span>grosszügig per Design</span>
    </div>
    <h2 class="v4-section-h2">Free Tier ausreichend. Pro für Produktions-Workflows.</h2>

    <p class="subscription-notice">Neue Pro- und Business-Abonnements sind vorübergehend nicht verfügbar. Der kostenlose Zugang und der Kauf von Datendateien bleiben verfügbar.</p>

      <div class="mcp-pricing-grid">
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Free</div>
        <div class="mcp-pc-price">0 CHF</div>
        <p class="mcp-pc-sub">100 Req/Tag pro IP. Kein Account zum Testen nötig.</p>
        <a href="#install" class="v4-btn v4-btn-secondary mcp-pc-cta">Jetzt testen <span class="arrow">→</span></a>
      </div>
      <div class="mcp-pc pop">
        <span class="mcp-pc-badge">derzeit geschlossen</span>
        <div class="mcp-pc-tier" style="color:var(--accent);">Pro</div>
        <div class="mcp-pc-price">49 CHF<small>/Monat</small></div>
        <p class="mcp-pc-sub">5 000 Req/Monat. Derzeit keine neuen Abonnements.</p>
        <p class="subscription-status">Neue Abonnements derzeit geschlossen</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Business</div>
        <div class="mcp-pc-price">199 CHF<small>/Monat</small></div>
        <p class="mcp-pc-sub">50 000 Req/Monat + erweiterte Tools. Fintechs &amp; ERP-Integratoren.</p>
        <p class="subscription-status">Neue Abonnements derzeit geschlossen</p>
      </div>
      <div class="mcp-pc">
        <div class="mcp-pc-tier">Enterprise</div>
        <div class="mcp-pc-price">Auf Anfrage</div>
        <p class="mcp-pc-sub">Unbegrenztes Volumen, SLA, massgeschneidert. Banken &amp; Grosskunden.</p>
        <a href="mailto:contact@openswissdata.com?subject=openswissdata%20Enterprise%20(Offerte)" class="v4-btn v4-btn-secondary mcp-pc-cta">Offerte anfragen <span class="arrow">→</span></a>
      </div>
    </div>
    <div style="text-align:center;margin-top:20px;">
      <a href="/pricing" class="v4-btn-mono">Angebote im Detail vergleichen</a>
    </div>
  </div>
</section>

<!-- ========== CTA FINAL ========== -->
<section class="v4-cta-final">
  <div class="container-v4">
    <h2>Schweizer Daten für Ihre Agenten.</h2>
    <p>Free Tier 100 Req/Tag. Kein Account zum Testen nötig. Open Spec MCP 2025-11-25.</p>
    <div class="v4-cta-final-row">
      <a href="#install" class="v4-btn v4-btn-primary">Jetzt verbinden <span class="arrow">→</span></a>
      <a href="/de/datasets/classifications" class="v4-btn v4-btn-secondary">Klassifikationen ansehen</a>
      <a href="/de/legal/provenance" class="v4-btn-mono">Provenienz &amp; Signatur</a>
    </div>
  </div>
</section>

<style>
  .mcp-pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 24px;
  }
  .mcp-pc {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
  }
  .mcp-pc.pop { border: 2px solid var(--accent); position: relative; }
  .mcp-pc-badge {
    position: absolute;
    top: -10px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    font-weight: 600;
  }
  .mcp-pc-tier {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .mcp-pc-price {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -.018em;
    margin-bottom: 4px;
    line-height: 1;
  }
  .mcp-pc-price small { font-size: 13px; font-weight: 500; color: var(--ink-mute); }
  .mcp-pc-sub {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0 0 16px;
    flex: 1;
  }
  .mcp-pc form { margin: 0; }
  .mcp-pc-cta { width: 100%; justify-content: center; font-size: 13px; padding: 10px; }
  .mcp-playground-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  @media (max-width: 1024px) {
    .mcp-pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .mcp-pricing-grid { grid-template-columns: 1fr; }
    .mcp-playground-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  const TOOL_DEFAULTS = {
    "tariff_lookup": { hs8: "09011100", lang: "de" },
    "tariff_semantic_search": { query: "Schmuck aus 18-Karat-Gold", top_k: 5 },
    "tariff_changelog": { hs8: "09011100", since: "2025-01-01" },
    "cross_walk": { code: "62.10", source: "NOGA_2025", target: "NACE_2.1" },
    "classify_text": { text: "Verkauf von Kaffeebohnen und Rösterei", top_k: 3 },
    "kyc_check": { name: "UBS Switzerland AG" },
    "finma_search": { name: "Vontobel", top_k: 5 },
    "entity_history": { uid: "CHE-101.329.561" },
  };
  const sel = document.getElementById('pg-tool');
  const args = document.getElementById('pg-args');
  const run = document.getElementById('pg-run');
  const out = document.getElementById('pg-output');
  function refreshArgs() {
    args.value = JSON.stringify(TOOL_DEFAULTS[sel.value] || {});
  }
  if (sel) {
    refreshArgs();
    sel.addEventListener('change', refreshArgs);
  }
  if (run) {
    run.addEventListener('click', async () => {
      out.textContent = "→ Calling " + sel.value + "...";
      try {
        const parsedArgs = JSON.parse(args.value);
        const res = await fetch('https://mcp.openswissdata.com/mcp/jsonrpc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: "2.0",
            id: Date.now(),
            method: "tools/call",
            params: { name: sel.value, arguments: parsedArgs }
          })
        });
        const json = await res.json();
        out.textContent = JSON.stringify(json, null, 2);
      } catch (err) {
        out.textContent = "✗ Error: " + (err.message || err);
      }
    });
  }
</script>

</BaseLayout>
