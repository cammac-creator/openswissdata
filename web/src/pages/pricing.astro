---
import CheckoutNotice from "../components/CheckoutNotice.astro";
import { jsonForHtml } from "../lib/html";
import BaseLayout from "../layouts/BaseLayout.astro";

// Les souscriptions restent fermées tant que leur livraison n’est pas validée.
// Une réouverture doit mettre à jour cette page, les pages MCP et le contrôle serveur.

const faqs = [
  {
    q: "Quelle est la différence entre le free tier et un abonnement ?",
    a: "L’accès gratuit permet de tester le MCP sans carte bancaire. Les nouvelles souscriptions Pro et Business sont temporairement fermées ; les achats de fichiers restent disponibles.",
  },
  {
    q: "Que vend openswissdata exactement ?",
    a: "Pas les données — elles sont publiques. On vend le travail : la normalisation multilingue, l'API/MCP prête à brancher (vous évitez de parser les fichiers officiels bruts), la chaîne de provenance signée Ed25519, et les mises à jour automatiques suivant les publications officielles.",
  },
  {
    q: "Sur quoi reposent vos permissions ?",
    a: "Permissions commerciales écrites officielles : BAZG (douanes, 2026-04-21) et FINMA (2026-05-06). La republication des données OFS/BFS s'appuie sur la liberté de réutilisation des œuvres officielles (LDA art. 5). Chaque livraison inclut un provenance.json vérifiable.",
  },
  {
    q: "Puis-je annuler à tout moment ?",
    a: "Les nouvelles souscriptions sont actuellement fermées. Les abonnements existants se gèrent depuis l’espace client et son portail de facturation.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: "https://www.openswissdata.com/" },
    { "@type": "ListItem", position: 2, name: "Tarifs", item: "https://www.openswissdata.com/pricing/" },
  ],
};
---
<BaseLayout
  title="Tarifs — openswissdata.com"
  description="Tarifs OpenSwissData : accès MCP gratuit et achats de fichiers TARES, FINMA et NOGA. Les nouvelles souscriptions Pro et Business sont temporairement fermées."
  monolingual={true}
>
  <div class="bg-grid"></div>

  <section class="v4-hero ds-page">
    <div class="container-v4">
      <nav class="ds-breadcrumb">
        <a href="/">accueil</a>
        <span class="sep">·</span>
        <span class="current">tarifs</span>
      </nav>
      <p class="subscription-notice">Les nouveaux abonnements Pro et Business sont temporairement indisponibles. L’accès gratuit et les achats de fichiers restent disponibles.<br/><a href="/mcp#install">Tester gratuitement →</a> · <a href="/#datasets">Voir les fichiers →</a></p>
      <div class="v4-hero-grid">
        <div>
          <div class="v4-eyebrow reveal-v4">
            <span>Tarifs</span>
            <span style="opacity:.4">·</span>
            <span class="check">Sans engagement</span>
          </div>
          <h1 class="v4-h1 reveal-v4" data-delay="1">
            Vos données suisses.<br>
            <span class="accent">Un choix clair.</span>
          </h1>
          <p class="v4-lede reveal-v4" data-delay="2">
            Une API et un serveur MCP pour les données fédérales suisses — TARES (douanes), registre FINMA, classifications NOGA/NACE/ISIC. Testez l’accès gratuit ou choisissez vos fichiers. Pas de carte requise pour tester.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="v4-datasets ds-page">
    <div class="container-v4">



      <div class="pr-grid">
        <!-- FREE -->
        <div class="pr-card reveal-v4">
          <div class="pr-tier">Free</div>
          <div class="pr-price">0 CHF</div>
          <p class="pr-sub">Pour tester et prototyper. Aucun compte requis.</p>
          <ul class="pr-feats">
            <li>✓ 100 requêtes/jour par IP</li>
            <li>✓ 3 outils sans compte : tarif, KYC, correspondances</li>
            <li>✓ JSON-RPC 2.0 standard</li>
            <li class="dim">✗ Pas de quota mensuel garanti</li>
            <li class="dim">✗ Pas de support</li>
          </ul>
          <a href="/mcp#install" class="v4-btn v4-btn-secondary pr-cta">Tester maintenant <span class="arrow">→</span></a>
        </div>

        <!-- PRO -->
        <div class="pr-card pr-pop reveal-v4" data-delay="1">
          <span class="pr-badge">indisponible</span>
          <div class="pr-tier" style="color:var(--accent);">Pro</div>
          <div class="pr-price">49 CHF<small>/mois</small></div>
          <p class="pr-sub">Pour les développeurs et workflows en production.</p>
          <ul class="pr-feats">
            <li>✓ 5 000 requêtes/mois</li>
            <li>✓ Clé API persistante</li>
            <li>✓ 8 outils MCP (STATENT suspendu)</li>
            <li>✓ Annulable à tout moment</li>
            <li>✓ Support email</li>
          </ul>
          <p class="subscription-status">Souscriptions temporairement fermées</p>
        </div>

        <!-- BUSINESS -->
        <div class="pr-card reveal-v4" data-delay="2">
          <div class="pr-tier">Business</div>
          <div class="pr-price">199 CHF<small>/mois</small></div>
          <p class="pr-sub">Pour les fintechs et intégrateurs ERP à volume.</p>
          <ul class="pr-feats">
            <li>✓ 50 000 requêtes/mois</li>
            <li>✓ Outils avancés (semantic search, classify, entity history)</li>
            <li>✓ Embeddings multilingues DE/IT/EN</li>
            <li>✓ Support prioritaire</li>
            <li>✓ Annulable à tout moment</li>
          </ul>
          <p class="subscription-status">Souscriptions temporairement fermées</p>
        </div>

        <!-- ENTERPRISE -->
        <div class="pr-card reveal-v4" data-delay="3">
          <div class="pr-tier">Enterprise</div>
          <div class="pr-price">Sur devis</div>
          <p class="pr-sub">Pour les banques, asset managers et grands comptes.</p>
          <ul class="pr-feats">
            <li>Volumes à définir ensemble</li>
            <li>Niveau de service à convenir</li>
            <li>Besoin de formats spécifiques à étudier</li>
            <li>Exigences de documentation à préciser</li>
            <li>Modalités à convenir avant engagement</li>
          </ul>
          <a href="mailto:contact@openswissdata.com?subject=openswissdata%20Enterprise%20(devis)" class="v4-btn v4-btn-secondary pr-cta">Demander un devis <span class="arrow">→</span></a>
        </div>
      </div>

      <!-- ===== DATASETS EN ACHAT UNIQUE (one-shot) ===== -->
      <div class="reveal-v4" style="margin-top:64px;text-align:center;max-width:680px;margin-left:auto;margin-right:auto;">
        <h2 class="ds-section-title">Ou en <span class="serif">achat unique</span></h2>
        <p class="ds-section-intro">
          Pas besoin d'API&nbsp;? Téléchargez les datasets bruts — ZIP <strong>CSV · Parquet · JSON · SQL</strong>,
          versionnés et signés Ed25519. Paiement unique, accès immédiat.
        </p>
      </div>

      <div class="pr-grid" style="margin-top:32px;">
        <!-- TARES -->
        <div class="pr-card reveal-v4">
          <div class="pr-tier">TARES</div>
          <div class="pr-price">299 CHF</div>
          <p class="pr-sub">Tarif douanier suisse HS8 — désignations 4 langues, droits MFN, régimes préférentiels.</p>
          <ul class="pr-feats">
            <li>✓ ~7 500 codes HS8</li>
            <li>✓ 4 formats (CSV/JSON/Parquet/SQL)</li>
            <li>✓ Manifeste signé Ed25519</li>
          </ul>
          <form method="POST" action="/api/checkout/start" style="margin:0;">
        <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="dataset_ids" value="tares" />
            <button type="submit" class="v4-btn v4-btn-secondary pr-cta">Acheter — 299 CHF <span class="arrow">→</span></button>
          </form>
      <CheckoutNotice />
          <a href="/datasets/tares" style="display:inline-block;margin-top:12px;font-size:12px;color:var(--ink-mute);text-decoration:none;">Détails du dataset →</a>
        </div>

        <!-- CLASSIFICATIONS -->
        <div class="pr-card reveal-v4" data-delay="1">
          <div class="pr-tier">Classifications</div>
          <div class="pr-price">399 CHF</div>
          <p class="pr-sub">NOGA · NACE · ISIC avec crosswalks bidirectionnels entre nomenclatures.</p>
          <ul class="pr-feats">
            <li>✓ NOGA 2008/2025 ↔ NACE ↔ ISIC</li>
            <li>✓ 4 formats normalisés</li>
            <li>✓ Manifeste signé Ed25519</li>
          </ul>
          <form method="POST" action="/api/checkout/start" style="margin:0;">
        <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="dataset_ids" value="classifications" />
            <button type="submit" class="v4-btn v4-btn-secondary pr-cta">Acheter — 399 CHF <span class="arrow">→</span></button>
          </form>
      <CheckoutNotice />
          <a href="/datasets/classifications" style="display:inline-block;margin-top:12px;font-size:12px;color:var(--ink-mute);text-decoration:none;">Détails du dataset →</a>
        </div>

        <!-- FINMA -->
        <div class="pr-card reveal-v4" data-delay="2">
          <div class="pr-tier">FINMA</div>
          <div class="pr-price">299 CHF</div>
          <p class="pr-sub">Registre des intermédiaires financiers autorisés + listes de mise en garde.</p>
          <ul class="pr-feats">
            <li>✓ Registre public FINMA structuré</li>
            <li>✓ 4 formats normalisés</li>
            <li>✓ Manifeste signé Ed25519</li>
          </ul>
          <form method="POST" action="/api/checkout/start" style="margin:0;">
        <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="dataset_ids" value="finma" />
            <button type="submit" class="v4-btn v4-btn-secondary pr-cta">Acheter — 299 CHF <span class="arrow">→</span></button>
          </form>
      <CheckoutNotice />
          <a href="/datasets/finma" style="display:inline-block;margin-top:12px;font-size:12px;color:var(--ink-mute);text-decoration:none;">Détails du dataset →</a>
        </div>

        <!-- BUNDLE -->
        <div class="pr-card pr-pop reveal-v4" data-delay="3">
          <span class="pr-badge">−200 CHF</span>
          <div class="pr-tier" style="color:var(--accent);">Bundle 3-en-1</div>
          <div class="pr-price">797 CHF</div>
          <p class="pr-sub">Les 3 datasets en un seul achat. 360 jours de mises à jour inclus.</p>
          <ul class="pr-feats">
            <li>✓ TARES + Classifications + FINMA</li>
            <li>✓ Économie de 200 CHF (−20 %)</li>
            <li>✓ 360 j de mises à jour incluses</li>
          </ul>
          <form method="POST" action="/api/checkout/start" style="margin:0;">
        <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="dataset_ids" value="bundle" />
            <button type="submit" class="v4-btn v4-btn-primary pr-cta">Acheter le bundle — 797 CHF <span class="arrow">→</span></button>
          </form>
      <CheckoutNotice />
          <a href="/bundle" style="display:inline-block;margin-top:12px;font-size:12px;color:var(--ink-mute);text-decoration:none;">Détails du bundle →</a>
        </div>
      </div>

      <section class="ds-section reveal-v4">
        <h2 class="ds-section-title">Ce qu'on vend <span class="serif">vraiment</span></h2>
        <p class="ds-section-intro">
          Les données fédérales suisses sont publiques. Notre valeur n'est pas de les posséder — c'est de vous faire gagner du temps et de sécuriser leur usage :
        </p>
        <div class="ds-meta-grid">
          <div class="ds-meta-card">
            <div class="ds-meta-label">Commodité</div>
            <div class="ds-meta-value">Une API/MCP prête à brancher, multilingue et normalisée — au lieu de parser des fichiers officiels bruts qui changent de format sans prévenir.</div>
          </div>
          <div class="ds-meta-card" data-delay="1">
            <div class="ds-meta-label">Permissions officielles</div>
            <div class="ds-meta-value">Permissions commerciales écrites BAZG et FINMA, et réutilisation des œuvres officielles (LDA art. 5) pour l'OFS. Vérifiables.</div>
          </div>
          <div class="ds-meta-card" data-delay="2">
            <div class="ds-meta-label">Provenance signée</div>
            <div class="ds-meta-value">Chaîne de provenance documentée, manifest signé Ed25519 + horodatage RFC-3161. Vous savez exactement d'où vient chaque donnée.</div>
          </div>
          <div class="ds-meta-card" data-delay="3">
            <div class="ds-meta-label">Toujours à jour</div>
            <div class="ds-meta-value">Mises à jour automatiques suivant les publications officielles, avec changelog. Pas de pipeline à maintenir de votre côté.</div>
          </div>
        </div>
      </section>

      <section class="ds-section reveal-v4">
        <h2 class="ds-section-title">Questions <span class="serif">fréquentes</span></h2>
        <div class="v4-faq-list">
          {faqs.map((f) => (
            <details class="v4-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <footer style="margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.6; color: var(--ink-mute);">
        Les données proviennent de sources fédérales suisses officielles (BAZG, FINMA, OFS / BFS). openswissdata.com n'est affilié à aucune de ces autorités et ne se substitue pas à la consultation directe des portails officiels. Disclaimer « Ceci n'est pas une publication officielle » fourni avec chaque réponse.
      </footer>
    </div>
  </section>

  <script type="application/ld+json" set:html={jsonForHtml(faqJsonLd)} />
  <script type="application/ld+json" set:html={jsonForHtml(breadcrumbJsonLd)} />

  <style>
    .pr-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 18px;
    }
    .pr-card {
      background: var(--bg-card, #fff);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 24px 22px;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .pr-pop { border: 2px solid var(--accent); }
    .pr-badge {
      position: absolute;
      top: -10px;
      right: 16px;
      background: var(--accent);
      color: #fff;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 4px;
      font-weight: 600;
    }
    .pr-tier {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--ink-mute);
      margin-bottom: 8px;
    }
    .pr-price {
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -.02em;
      margin-bottom: 6px;
      line-height: 1;
    }
    .pr-price small {
      font-size: 14px;
      font-weight: 500;
      color: var(--ink-mute);
    }
    .pr-sub {
      font-size: 13px;
      color: var(--ink-soft);
      line-height: 1.45;
      margin: 0 0 16px;
      min-height: 38px;
    }
    .pr-feats {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      font-size: 12.5px;
      color: var(--ink-soft);
      flex: 1;
    }
    .pr-feats li { padding: 4px 0; line-height: 1.4; }
    .pr-feats li.dim { color: var(--ink-mute); }
    .pr-cta { width: 100%; justify-content: center; font-size: 13px; padding: 11px; }
    .pr-note {
      font-size: 13px;
      color: var(--ink-soft);
      text-align: center;
      margin: 0 0 56px;
    }
    @media (max-width: 1024px) { .pr-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .pr-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
