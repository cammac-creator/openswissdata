---
import CheckoutNotice from "../../components/CheckoutNotice.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClassificationsLookup from "../../components/ClassificationsLookup.astro";
import ClassificationsQuality from "../../components/ClassificationsQuality.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import ProductFaq from "../../components/ProductFaq.astro";
import ApiSwitch from "../../components/ApiSwitch.astro";

const datasetJsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Swiss Industry Classifications — NOGA 2008/2025 + NACE Rev 2/2.1 + ISIC Rev 4 with cross-walks",
  description:
    "Unified Swiss industry classification reference: NOGA 2008 (BFS/OFS), NOGA 2025 (NACE-aligned), NACE Rev 2 (EU), NACE Rev 2.1 (EU 2025), ISIC Rev 4 (UN). Documented pairwise links, with explicit limitations between revisions. NOGA/NACE labels in DE/FR/IT/EN; ISIC in FR/EN/ES. Multi-format (CSV/JSON/Parquet/SQL).",
  url: "https://www.openswissdata.com/datasets/classifications",
  identifier: "openswissdata:classifications",
  license: "https://www.openswissdata.com/legal/cgv",
  creator: { "@type": "Organization", name: "openswissdata", url: "https://www.openswissdata.com" },
  publisher: { "@type": "Organization", name: "openswissdata" },
  isBasedOn: [
    { "@type": "Dataset", name: "NOGA 2025 (BFS)", url: "https://www.i14y.admin.ch/" },
    { "@type": "Dataset", name: "NACE Rev 2.1 (Eurostat)", url: "https://ec.europa.eu/eurostat/web/nace" },
    { "@type": "Dataset", name: "ISIC Rev 4 (UN)", url: "https://unstats.un.org/unsd/classifications/Econ/isic" },
  ],
  keywords: ["NOGA 2008", "NOGA 2025", "NACE Rev 2", "NACE Rev 2.1", "ISIC Rev 4", "industry classification", "economic statistics", "Switzerland", "OFS", "BFS", "Eurostat", "cross-walk", "NACE EU"],
  spatialCoverage: { "@type": "Place", name: "Switzerland", geo: { "@type": "GeoCoordinates", addressCountry: "CH" } },
  temporalCoverage: "2008/..",
  isAccessibleForFree: false,
  variableMeasured: ["NOGA 2008 code", "NOGA 2025 code", "NACE Rev 2 code", "NACE Rev 2.1 code", "ISIC Rev 4 code", "Multilingual labels (DE/FR/IT/EN)", "Bidirectional cross-walks"],
  distribution: [
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: "https://www.openswissdata.com/datasets/classifications" },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: "https://www.openswissdata.com/datasets/classifications" },
    { "@type": "DataDownload", encodingFormat: "application/vnd.apache.parquet", contentUrl: "https://www.openswissdata.com/datasets/classifications" },
    { "@type": "DataDownload", encodingFormat: "application/sql", contentUrl: "https://www.openswissdata.com/datasets/classifications" },
  ],
};

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Classifications NOGA + NACE + ISIC",
  description: "5 classifications d'activités économiques unifiées : NOGA 2008/2025, NACE Rev 2/2.1, ISIC Rev 4. Cross-walks bidirectionnels, FR/DE/IT/EN (NOGA/NACE), FR/EN/ES (ISIC). JSON / Parquet / SQL.",
  image: "https://www.openswissdata.com/og-classifications.png",
  url: "https://www.openswissdata.com/datasets/classifications",
  brand: { "@type": "Brand", name: "openswissdata" },
  category: "Reference data — economic activity classifications",
  offers: {
    "@type": "Offer",
    price: "399",
    priceCurrency: "CHF",
    availability: "https://schema.org/InStock",
    url: "https://www.openswissdata.com/datasets/classifications#acheter",
    priceValidUntil: "2026-12-31",
    seller: { "@type": "Organization", name: "openswissdata" },
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: { "@type": "MonetaryAmount", value: "0", currency: "CHF" },
      shippingDestination: { "@type": "DefinedRegion", addressCountry: "CH" },
      deliveryTime: {
        "@type": "ShippingDeliveryTime",
        handlingTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
        transitTime: { "@type": "QuantitativeValue", minValue: 0, maxValue: 0, unitCode: "DAY" },
      },
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "CH",
      returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
      merchantReturnDays: 14,
      returnMethod: "https://schema.org/ReturnByMail",
      returnFees: "https://schema.org/FreeReturn",
    },
  },
};
---
<BaseLayout
  title="Classifications économiques NOGA + NACE + ISIC | openswissdata"
  description="5 classifications d'activités économiques unifiées : NOGA 2008/2025, NACE Rev 2/2.1, ISIC Rev 4. Cross-walks bidirectionnels, FR/DE/IT/EN (NOGA/NACE), FR/EN/ES (ISIC). JSON / Parquet / SQL. Échantillon CSV gratuit — sans compte."
  image="/og-classifications.png"
  productJsonLd={productJsonLd}
  datasetJsonLd={datasetJsonLd}
>
<div class="bg-grid"></div>

<section class="v4-hero ds-page">
  <div class="ds-hero-banner-bg" style="background-image:url('/og-classifications.png');" aria-hidden="true"></div>
  <div class="container-v4">
    <nav class="ds-breadcrumb">
      <a href="/">accueil</a>
      <span class="sep">·</span>
      <a href="/bundle">datasets</a>
      <span class="sep">·</span>
      <span class="current">Classifications</span>
    </nav>

    <div class="v4-hero-grid">
      <div>
        <div class="v4-eyebrow reveal-v4">
          <span>Classifications · 5 standards</span>
          <span style="opacity:.4">·</span>
          <span>BFS · permission demandée 2026-04-17</span>
        </div>

        <h1 class="v4-h1 reveal-v4" data-delay="1">
          NOGA, NACE, ISIC<br>
          <span class="accent">alignés.</span>
        </h1>

        <p class="v4-lede reveal-v4" data-delay="2">
          Cinq nomenclatures unifiées (NOGA 2008, NOGA 2025, NACE Rev 2, NACE Rev 2.1, ISIC Rev 4) avec leurs <strong>cross-walks bidirectionnels</strong>.
          NOGA et NACE : FR/DE/IT/EN ; ISIC : FR/EN/ES.
        </p>

        <div class="v4-spec-row reveal-v4" data-delay="3">
          <div class="v4-spec">
            <div class="v4-spec-label">Standards</div>
            <div class="v4-spec-value">5 unifiés</div>
          </div>
          <div class="v4-spec">
            <div class="v4-spec-label">Codes</div>
            <div class="v4-spec-value">6 444</div>
          </div>
          <div class="v4-spec">
            <div class="v4-spec-label">Cross-walks</div>
            <div class="v4-spec-value">par paire</div>
          </div>
        </div>

        <div class="v4-cta-row reveal-v4" data-delay="4">
          <a href="#acheter" class="v4-btn v4-btn-primary">Acheter — 399 CHF <span class="arrow">→</span></a>
          <a href="/api/catalog/classifications?format=csv" download class="v4-btn v4-btn-secondary">Démo gratuite — 50 codes CSV ↓</a>
        </div>

        <div class="v4-permission-line reveal-v4" data-delay="5">
          <span><strong>Sources :</strong> BFS · Eurostat · UN Statistics</span>
          <span style="opacity:.4">·</span>
          <span>NOGA 2025 + NACE 2.1 inclus</span>
        </div>
      </div>

      <div class="ds-price-box reveal-v4" data-delay="2">
        <div class="ds-price-box-label">One-shot Standard</div>
        <div class="ds-price-box-amount">399<span class="ds-price-box-currency">CHF</span></div>
        <div class="ds-price-box-renew">+160 CHF/an mises à jour (optionnel) · 360 jours d'updates inclus</div>
      </div>
    </div>
  </div>
</section>

<TrustStrip
  sources={["BFS / OFS", "Eurostat", "UN Statistics"]}
  badges={["5 nomenclatures unifiées", "Cross-walks par paire", "Manifest signé Ed25519"]}
/>

<section class="v4-datasets ds-page">
  <div class="container-v4">
    <div class="ds-meta-grid">
      <div class="ds-meta-card reveal-v4">
        <div class="ds-meta-label">Contenu</div>
        <div class="ds-meta-value">5 nomenclatures + cross-walks par paire · FR/DE/IT/EN (NOGA/NACE), FR/EN/ES (ISIC) · CSV, JSON, Parquet, SQL</div>
      </div>
      <div class="ds-meta-card reveal-v4" data-delay="1">
        <div class="ds-meta-label">Mises à jour</div>
        <div class="ds-meta-value">Refresh annuel + révisions majeures · 360 jours inclus · renouvellement 160 CHF/an</div>
      </div>
    </div>

    <section class="ds-section reveal-v4">
      <div class="v4-section-eyebrow">
        <strong>Périmètre</strong>
        <span class="sep">/</span>
        <span>5 standards officiels</span>
      </div>
      <h2 class="v4-section-h2">Cinq <span class="serif">standards</span> dans un seul bundle.</h2>
      <p class="v4-section-intro">
        Tous les standards sont normalisés au même format de table, avec les mêmes champs (code, label_fr/de/it/en, parent, niveau).
        Chaque code conserve son niveau et son parent. Les correspondances indiquent leur source et leur précision.
      </p>

      <div class="ds-table-wrap">
        <table class="ds-table">
          <thead>
            <tr><th>Standard</th><th>Périmètre</th><th>Émetteur</th><th>Langues</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>NOGA 2008</strong></td><td class="dim">Activités économiques suisses (héritage)</td><td class="dim">BFS</td><td class="mono">FR/DE/IT/EN</td></tr>
            <tr><td><strong>NOGA 2025</strong></td><td class="dim">Activités économiques suisses (actuel, janvier 2026)</td><td class="dim">BFS</td><td class="mono">FR/DE/IT/EN</td></tr>
            <tr><td><strong>NACE Rev 2</strong></td><td class="dim">Activités économiques européennes</td><td class="dim">Eurostat</td><td class="mono">FR/DE/IT/EN</td></tr>
            <tr><td><strong>NACE Rev 2.1</strong></td><td class="dim">Activités économiques européennes (révision)</td><td class="dim">Eurostat</td><td class="mono">FR/DE/IT/EN</td></tr>
            <tr><td><strong>ISIC Rev 4</strong></td><td class="dim">Activités économiques mondiales (UN)</td><td class="dim">UN Statistics</td><td class="mono">FR/EN/ES</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <ClassificationsQuality lang="fr" />
    <section class="ds-section reveal-v4">
      <div class="v4-section-eyebrow"><strong>Sources et précision explicites</strong></div>
      <h2 class="v4-section-h2">Des correspondances <span class="serif">qualifiées.</span></h2>
      <p class="v4-section-intro">Les fichiers décrivent des liens documentés entre deux nomenclatures. Une relation approchée exige une vérification de l’activité ; elle ne constitue pas une équivalence exacte.</p>
    </section>

    <section class="ds-section reveal-v4">
      <div class="v4-section-eyebrow">
        <strong>Démo live</strong>
        <span class="sep">/</span>
        <span>Sans inscription</span>
      </div>
      <h2 class="v4-section-h2">Essayez <span class="serif">en vrai</span>.</h2>
      <p class="v4-section-intro">Saisissez un code pour examiner une correspondance sourcée.</p>
      <ClassificationsLookup />
    </section>

    <div class="ds-sample reveal-v4">
      <h3>Échantillon gratuit — 50 lignes</h3><p>Dix lignes par nomenclature, extraites de la version distribuée. Les zéros initiaux des codes doivent être conservés.</p>
      <a href="/api/catalog/classifications?format=csv" download class="ds-sample-dl">
        <svg viewBox="0 0 14 14" fill="none"><path d="M7 1v9M3 7l4 4 4-4M2 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Télécharger classifications-sample.csv
      </a>
    </div>

    <section class="ds-section reveal-v4">
      <div class="v4-section-eyebrow">
        <strong>Cas d'usage</strong>
        <span class="sep">/</span>
        <span>4 profils types</span>
      </div>
      <h2 class="v4-section-h2">À <span class="serif">qui</span> ça s'adresse.</h2>
      <div class="ds-audience-grid">
        <div class="ds-audience-item">
          <strong>Équipes data des banques &amp; assureurs CH</strong>
          <span>Reporting sectoriel, risque crédit par activité, fichier ESG par secteur réglementaire.</span>
        </div>
        <div class="ds-audience-item">
          <strong>Intégrateurs ERP &amp; CRM</strong>
          <span>Mapping de codes dans Bexio, SAP, Salesforce — clients et fournisseurs catégorisés correctement.</span>
        </div>
        <div class="ds-audience-item">
          <strong>Filiales suisses de groupes UE</strong>
          <span>Consolidation avec le reporting NACE de la maison-mère sans retraitement manuel.</span>
        </div>
        <div class="ds-audience-item">
          <strong>Consultants &amp; chercheurs économiques</strong>
          <span>Continuité time-series à travers les révisions NOGA. Études sectorielles comparatives.</span>
        </div>
      </div>
    </section>

    <section class="ds-section"><h2 class="v4-section-h2">Classifications Pro</h2><p class="v4-section-intro">Classifications Pro est temporairement indisponible pendant la vérification de ses compléments. L’archive Standard ne comprend pas les vecteurs multilingues ni les correspondances NAICS.</p></section>

    <ProductFaq productName="Classifications" />

    <ApiSwitch lang="fr" />
    <div class="ds-cta" id="acheter">
      <form method="POST" action="/api/checkout/start" class="ds-cta-form">
        <input type="hidden" name="locale" value="fr" />
        <input type="hidden" name="dataset_ids" value="classifications" />
        <button type="submit" class="v4-btn v4-btn-primary v4-btn-cta">
          Acheter Classifications Standard — 399 CHF
          <span class="arrow">→</span>
        </button>
      </form>
      <CheckoutNotice />
      <p class="ds-cta-sub">Paiement sécurisé Stripe · Téléchargement immédiat par email · Remboursement 14 jours sans condition</p>
      <p class="ds-cta-alt">Ou prenez le <a href="/bundle">bundle complet (TARES + Classifications + FINMA) à 797 CHF</a> — économie 200 CHF (20 %).</p>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  .cls-pro-card {
    padding: 36px;
    background: var(--bg-card);
    border: 2px solid var(--ink);
    border-radius: 14px;
    position: relative;
  }
  .cls-pro-tag {
    position: absolute;
    top: -12px;
    left: 24px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
  }
  .cls-pro-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (max-width: 880px) {
    .cls-pro-grid { grid-template-columns: 1fr; }
  }
  .cls-pro-item {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
  }
  .cls-pro-num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .cls-pro-item strong {
    display: block;
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .cls-pro-item p {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0;
  }
</style>
