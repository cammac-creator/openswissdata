---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLangFromPath, localizePath } from "../i18n/utils";
import { privacy, providerLinks } from "../content/legal";
import { serviceDocuments } from "../content/legal-service";
import { contractDocument, termsPath, CURRENT_TERMS_VERSION } from "../../../src/legal/catalog";
interface Props { document?: string; immutable?: boolean; version?: string; }
const { document: key = "index", immutable = false, version = CURRENT_TERMS_VERSION } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const L = (p: string) => localizePath(p, lang);
const displayedDate = new Intl.DateTimeFormat(lang === "fr" ? "fr-CH" : lang === "de" ? "de-CH" : "en-GB", {day:"numeric",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(version+"T00:00:00Z"));
const ui = {
 fr: { hub:"Vos droits, clairement", intro:"Les règles de nos ventes, l’usage des données et les contacts utiles, réunis au même endroit.", tag:"Informations juridiques", date:`Version du ${displayedDate}`, toc:"Dans ce document", save:"Conserver les CGV (.txt)", print:"Imprimer / PDF", archived:`Version contractuelle conservée : ${version}`, old:"Anciennes CGV 1.1 (avant le 26.09.2026)", contact:"Une question ?", back:"Tous les documents", providers:"Notices et documents des prestataires", proof:"Outil de vérification", key:"Clé publique" },
 de: { hub:"Ihre Rechte, verständlich", intro:"Verkaufsbedingungen, Datennutzung und wichtige Kontakte an einem Ort.", tag:"Rechtliche Informationen", date:`Stand: ${displayedDate}`, toc:"In diesem Dokument", save:"AGB speichern (.txt)", print:"Drucken / PDF", archived:`Aufbewahrte Vertragsversion: ${version}`, old:"Frühere AGB 1.1 (vor dem 26.09.2026)", contact:"Eine Frage?", back:"Alle Dokumente", providers:"Anbieterinformationen und Dokumente", proof:"Prüfwerkzeug", key:"Öffentlicher Schlüssel" },
 en: { hub:"Your rights, clearly", intro:"Sales terms, data use and useful contacts, together in one place.", tag:"Legal information", date:`Version: ${displayedDate}`, toc:"In this document", save:"Save the terms (.txt)", print:"Print / PDF", archived:`Retained contractual version: ${version}`, old:"Previous terms 1.1 (before 26 September 2026, French)", contact:"A question?", back:"All documents", providers:"Provider notices and documents", proof:"Verification tool", key:"Public key" },
}[lang];
const docs = { cgv: contractDocument(CURRENT_TERMS_VERSION, lang)!, privacy: privacy[lang], ...serviceDocuments[lang] };
const doc = key === "cgv" ? contractDocument(version, lang) : docs[key];
const link = (name: string) => name === "compliance" ? L("/compliance") : L(`/legal/${name}`);
const archive = lang === "de" ? "/de/legal/archives/cgv-1-1" : "/legal/archives/cgv-1-1";
---
<BaseLayout title={`${doc?.title ?? ui.hub} — OpenSwissData`} description={doc?.summary ?? ui.intro} noindex={immutable}>
  <section class="law-shell">
    <header class="law-header">
      <a class="eyebrow" href={L("/legal/")}>{ui.tag} <span>↗</span></a>
      <h1>{doc?.title ?? ui.hub}</h1>
      <p class="lead">{doc?.summary ?? ui.intro}</p>
      <div class="law-meta"><span>{ui.date}</span>{immutable && <span>{ui.archived}</span>}</div>
    </header>
    {!doc ? <div class="law-grid">{Object.entries(docs).map(([name, item], i) => <a class="law-card" href={link(name)}><span class="number">{String(i+1).padStart(2,"0")} <span>↗</span></span><h2>{item.title}</h2><p>{item.summary}</p></a>)}</div> : <div class="law-columns">
      <aside><nav aria-label={ui.toc}><strong>{ui.toc}</strong>{doc.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}</nav><a class="back" href={L("/legal/")}>← {ui.back}</a></aside>
      <article>
        {doc.highlights.length > 0 && <div class="law-highlights">{doc.highlights.map(p => <p>{p}</p>)}</div>}
        <div class="law-actions"><button type="button" data-legal-print>{ui.print}</button>{key === "cgv" && <a href={`${termsPath(lang, version)}.txt`} download>{ui.save}</a>}</div>
        {doc.sections.map(s => <section class="law-section" id={s.id}><h2>{s.title}</h2>{s.paragraphs.map(p => <p>{p}</p>)}</section>)}
        {key === "privacy" && <section class="law-section"><h2>{ui.providers}</h2><ul>{providerLinks.map(([label,url]) => <li><a href={url} rel="noopener" target="_blank">{label} ↗</a></li>)}</ul></section>}
        {key === "provenance" && <div class="law-actions"><a href="https://github.com/cammac-creator/openswissdata/blob/main/etl/shared/verify-provenance.ts" target="_blank" rel="noopener">{ui.proof} ↗</a><a href="/.well-known/openswissdata-pubkey.pem">{ui.key}</a></div>}
        {key === "cgv" && <p class="law-archive"><a href={archive}>{ui.old}</a></p>}
      </article>
    </div>}
    <div class="law-contact"><strong>{ui.contact}</strong><a href="mailto:contact@openswissdata.com">contact@openswissdata.com ↗</a></div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll('[data-legal-print]').forEach(button => button.addEventListener('click', () => window.print()));
</script>
<style>
.law-shell{max-width:1180px;margin:0 auto;padding:145px 36px 24px;color:var(--color-ink);overflow-wrap:anywhere}.law-header{max-width:850px;margin-bottom:52px}.eyebrow{display:inline-flex;gap:35px;font:12px var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent);text-decoration:none}.law-header h1{font-size:clamp(2.3rem,5vw,4.5rem);font-weight:500;letter-spacing:-.045em;line-height:1.08;margin:22px 0}.lead{font-size:20px;line-height:1.55;color:var(--color-ink-soft);max-width:44ch}.law-meta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px;font:12px var(--font-mono);color:var(--color-ink-mute)}.law-meta span{border:1px solid var(--color-line);border-radius:24px;padding:8px 12px}.law-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.law-card{border:1px solid var(--color-line);border-radius:10px;padding:28px;text-decoration:none;color:inherit;background:#fff;transition:border-color .15s}.law-card:hover{border-color:var(--accent)}.number{display:flex;justify-content:space-between;font:12px var(--font-mono);color:var(--accent)}.law-card h2{font-size:24px;line-height:1.25;margin:24px 0 12px;font-weight:500}.law-card p{font-size:15px;line-height:1.6;color:var(--color-ink-soft)}.law-columns{display:grid;grid-template-columns:255px minmax(0,1fr);gap:60px}.law-columns aside{align-self:start;position:sticky;top:105px;font-size:13px}.law-columns nav{display:grid;gap:12px;border-top:2px solid var(--color-ink);padding-top:20px}.law-columns nav a{color:var(--color-ink-soft);text-decoration:none;line-height:1.45}.law-columns nav strong{margin-bottom:6px}.law-columns a:hover{text-decoration:underline}.back{display:block;margin-top:25px}.law-highlights{padding:18px 24px;background:#edf4ef;border-left:3px solid #476952;border-radius:0 8px 8px 0;margin-bottom:25px}.law-highlights p{line-height:1.6;margin:8px 0}.law-actions{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 30px}.law-actions button,.law-actions a{font-size:13px;padding:10px 15px;border:1px solid var(--color-line);background:#fff;border-radius:5px;cursor:pointer;text-decoration:none;color:inherit}.law-section{scroll-margin-top:110px;margin:0 0 35px;padding-top:22px;border-top:1px solid var(--color-line)}.law-section h2{font-size:23px;font-weight:550;line-height:1.3;margin:0 0 16px;letter-spacing:-.02em}.law-section p,.law-section li{font-size:16px;line-height:1.85;margin:0 0 15px}.law-section a,.back,.law-archive a{color:var(--accent);text-underline-offset:3px}.law-contact{display:flex;gap:18px;justify-content:space-between;flex-wrap:wrap;border-top:1px solid var(--color-ink);margin-top:65px;padding-top:26px;font-size:16px}.law-contact a{color:inherit}.law-archive{font-size:13px}@media(max-width:800px){.law-shell{padding:115px 22px 20px}.law-header{margin-bottom:32px}.law-columns{grid-template-columns:minmax(0,1fr);gap:35px}.law-columns aside{position:static}.law-columns nav{gap:8px}.law-columns nav a{padding:3px 0}.law-grid{grid-template-columns:minmax(0,1fr)}.law-card{padding:24px}.lead{font-size:18px}}@media print{.law-shell{padding:0;max-width:none}.law-columns{display:block}.law-columns aside,.law-actions,.law-contact,.law-archive,.eyebrow{display:none}.law-header h1{font-size:28px}.law-header{margin-bottom:25px}.law-section h2{break-after:avoid}.law-section p{font-size:11pt;line-height:1.5}.law-meta{font-size:10pt}:global(.fixed-nav),:global(.site-footer){display:none!important}}
</style>
