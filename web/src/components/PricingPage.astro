<AtlasLayout title={copy.title} description={copy.description} articleJsonLd={pageJsonLd}>
<div class="tarifs">
 <div class="atlas-shell atlas-breadcrumb"><a href={L("/")}>{copy.home}</a><span aria-hidden="true">/</span><span>{copy.crumb}</span></div>
 <div class="atlas-shell"><p class="service-banner" data-closed-banner role="status" hidden>{copy.closed}</p></div>

 <section class="tarifs-hero"><div class="atlas-shell tarifs-hero-grid">
  <div data-atlas-enter>
   <p class="atlas-kicker">{copy.kicker}</p>
   <h1>{copy.hero}<br/><em>{copy.accent}</em></h1>
   <p class="atlas-lede">{copy.lede}</p>
   <div class="atlas-actions"><a class="atlas-btn" href="#fichiers">{copy.choose}<span aria-hidden="true">↓</span></a><a class="atlas-text-link" href={`${L("/mcp")}#install`}>{copy.tryMcp}<span aria-hidden="true">↗</span></a></div>
   <div class="atlas-hero-footnote">{copy.footnote.map(item => <span>{item}</span>)}</div>
  </div>
  <figure class="tarifs-ledger" data-atlas-enter>
   <figcaption><strong>{copy.ledgerTitle}</strong><span>{copy.ledgerSub}</span></figcaption>
   <table>
    <thead><tr><th scope="col">{copy.ledgerProduct}</th><th scope="col">{copy.ledgerPrice}</th></tr></thead>
    <tbody>
     {ORDER.map(id => <tr><th scope="row">{copy.names[id]}</th><td>{chf(FILE_OFFERS[id].price)}</td></tr>)}
     <tr class="tarifs-ledger-sum"><th scope="row">{copy.separate}</th><td>{chf(SEPARATE_TOTAL)}</td></tr>
     <tr class="tarifs-ledger-bundle"><th scope="row">{copy.bundleRow}</th><td>{chf(BUNDLE_OFFER.price)}</td></tr>
     <tr class="tarifs-ledger-saving"><th scope="row">{copy.saving}</th><td>{chf(BUNDLE_SAVING)} · {BUNDLE_SAVING_PERCENT} %</td></tr>
    </tbody>
   </table>
   <p class="tarifs-ledger-foot"><span>{copy.renewalLine}</span>{ORDER.map(id => <b>{copy.names[id].split(" ")[0]} {chf(FILE_OFFERS[id].renewal)}</b>)}</p>
  </figure>
 </div></section>

 <section class="atlas-section tarifs-files" id="fichiers" aria-labelledby="fichiers-titre"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.filesKicker}</p><h2 id="fichiers-titre">{copy.filesTitle}</h2></div><p class="atlas-section-intro">{copy.filesIntro}</p></div>
  <div class="tarifs-grid">
   {ORDER.map(id => { const product = products[id]; return <article class={`tarifs-card tarifs-card-${id}`} data-atlas-enter>
    <div class="tarifs-card-head"><p class="atlas-kicker">{product.label}</p><span>{product.source}</span></div>
    <h3>{product.title}</h3>
    <ul>{product.items.map(item => <li>{item}</li>)}</ul>
    <p class="tarifs-card-meta"><span>{product.formats}</span><span>{product.cadence}</span></p>
    <div class="tarifs-card-price"><strong>{chf(FILE_OFFERS[id].price)}</strong><span>{copy.once}</span></div>
    <p class="tarifs-card-renewal">{copy.renewal} · {chf(FILE_OFFERS[id].renewal)} {copy.perYear}</p>
    <form method="POST" action="/api/checkout/start"><input type="hidden" name="locale" value={lang} /><input type="hidden" name="dataset_ids" value={id} /><button class="atlas-btn" type="submit">{copy.buy} · {chf(FILE_OFFERS[id].price)}<span aria-hidden="true">↗</span></button></form>
    <CheckoutNotice />
    <a class="atlas-text-link tarifs-card-link" href={L(`/datasets/${id}`)}>{copy.readSheet}<span aria-hidden="true">↗</span></a>
   </article>; })}
  </div>
  <article class="tarifs-bundle" data-atlas-enter>
   <div class="tarifs-bundle-copy">
    <p class="atlas-kicker">{copy.bundleKicker}</p>
    <h3>{copy.bundleTitle}</h3>
    <p>{copy.bundleText}</p>
    <a class="atlas-text-link" href={L("/bundle")}>{copy.bundleLink}<span aria-hidden="true">↗</span></a>
   </div>
   <div class="tarifs-bundle-sheets" aria-hidden="true">{ORDER.map(id => <span class={`tarifs-sheet tarifs-sheet-${id}`}><b>{{ tares: "TARES", classifications: "NOGA", finma: "FINMA" }[id]}</b><i></i><i></i><i></i></span>)}</div>
   <div class="tarifs-bundle-box">
    <p class="tarifs-was"><s>{chf(SEPARATE_TOTAL)}</s> <span>{copy.bundleSaved}</span></p>
    <div class="atlas-purchase-price"><strong>{BUNDLE_OFFER.price}</strong><span>CHF</span></div>
    <form method="POST" action="/api/checkout/start"><input type="hidden" name="locale" value={lang} /><input type="hidden" name="dataset_ids" value="bundle" /><button class="atlas-btn" type="submit">{copy.buyBundle}<span aria-hidden="true">↗</span></button></form>
    <CheckoutNotice />
   </div>
  </article>
 </div></section>

 <section class="atlas-section atlas-method tarifs-included" id="compris" aria-labelledby="compris-titre"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.includedKicker}</p><h2 id="compris-titre">{copy.includedTitle}</h2></div><div><p class="atlas-section-intro">{copy.includedIntro}</p><a class="atlas-text-link" href={L("/legal/cgv")}>{copy.terms} ↗</a></div></div>
  <div class="atlas-benefits tarifs-benefits">{copy.included.map(([title, text], index) => <article class="atlas-benefit" data-atlas-enter><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
 </div></section>

 <section class="atlas-section tarifs-mcp" id="mcp" aria-labelledby="mcp-titre"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.mcpKicker}</p><h2 id="mcp-titre">{copy.mcpTitle}</h2></div><p class="atlas-section-intro">{copy.mcpIntro}</p></div>
  <div class="tarifs-plans" data-atlas-enter>
   <article class="tarifs-plan tarifs-plan-open">
    <p class="tarifs-plan-tier">{copy.free[0]}</p>
    <p class="tarifs-plan-price">{chf(0)}</p>
    <p class="tarifs-plan-sub">{copy.free[1]}</p>
    <ul>{(copy.free[2] as string[]).map(item => <li>{item}</li>)}</ul>
    <a class="atlas-btn" href={`${L("/mcp")}#install`}>{copy.free[3]}<span aria-hidden="true">↗</span></a>
   </article>
   {(["pro", "business"] as const).map(plan => <article class="tarifs-plan tarifs-plan-closed">
    <span class="tarifs-plan-badge">{copy.closedBadge}</span>
    <p class="tarifs-plan-tier">{plan === "pro" ? "Pro" : "Business"}</p>
    <p class="tarifs-plan-price">{chf(MCP_CLOSED[plan].monthly)}<small>{copy.month}</small></p>
    <ul><li>{count(MCP_CLOSED[plan].requests)} {copy.requests}</li></ul>
    <p class="tarifs-plan-status">{copy.closedStatus}</p>
   </article>)}
   <article class="tarifs-plan">
    <p class="tarifs-plan-tier">{copy.enterprise[0]}</p>
    <p class="tarifs-plan-price tarifs-plan-quote">{copy.enterprise[1]}</p>
    <p class="tarifs-plan-sub">{copy.enterprise[2]}</p>
    <a class="atlas-btn atlas-btn-secondary" href={quoteHref}>{copy.enterprise[3]}<span aria-hidden="true">↗</span></a>
   </article>
  </div>
 </div></section>

 <section class="atlas-section atlas-faq" id="questions"><div class="atlas-shell atlas-faq-grid"><div data-atlas-enter><p class="atlas-kicker">{copy.faqKicker}</p><h2 class="atlas-section-title">{copy.faqTitle}</h2><a href={L("/legal/cgv")} class="atlas-text-link">{copy.terms} ↗</a></div><div>{copy.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

 <section class="atlas-shell" aria-labelledby="tarifs-fin"><div class="atlas-purchase" data-atlas-enter>
  <div><p class="atlas-kicker">{copy.closingKicker}</p><h2 id="tarifs-fin">{copy.closingTitle}</h2><p>{copy.closingText}</p><div class="atlas-actions"><a class="atlas-text-link" href={L("/support")}>{copy.support} ↗</a><a class="atlas-text-link" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL} ↗</a></div></div>
  <div class="atlas-purchase-box tarifs-samples"><p>{copy.samples}</p><ul>{ORDER.map(id => <li><a href={L(`/datasets/${id}`)}><span>{copy.names[id]}</span><span>{copy.sample} ↗</span></a></li>)}</ul></div>
 </div></section>
</div>
<script>
 import '../scripts/pricing';
</script>
</AtlasLayout>
