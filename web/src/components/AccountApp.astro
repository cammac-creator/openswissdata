  },
  en: {
    title: "Your account | openswissdata", description: "OpenSwissData account: sign in with an emailed link, download the files you bought, Stripe receipts and accepted sales terms.",
    home: "Home", crumb: "Your account", loading: "Loading your account…",
    kicker: "Your account · Email sign-in", hero: "Your files,", accent: "in one place.",
