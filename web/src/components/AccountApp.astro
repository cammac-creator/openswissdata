} satisfies Record<Lang, Record<string, string>>;

const PRODUCTS = {
  fr: { tares: ["Tarif douanier", "CSV · JSON · Parquet · SQL"], classifications: ["NOGA · NACE · ISIC", "CSV · JSON · Parquet · SQL"], finma: ["Registre FINMA", "Excel · CSV · JSON · Parquet · SQL"] },
  de: { tares: ["Zolltarif", "CSV · JSON · Parquet · SQL"], classifications: ["NOGA · NACE · ISIC", "CSV · JSON · Parquet · SQL"], finma: ["FINMA-Register", "Excel · CSV · JSON · Parquet · SQL"] },
  en: { tares: ["Customs tariff", "CSV · JSON · Parquet · SQL"], classifications: ["NOGA · NACE · ISIC", "CSV · JSON · Parquet · SQL"], finma: ["FINMA registry", "Excel · CSV · JSON · Parquet · SQL"] },
} satisfies Record<Lang, Record<string, [string, string]>>;

const c = COPY[lang];
const accountPath = L("/account");
const dateLocale = lang === "de" ? "de-CH" : lang === "en" ? "en-GB" : "fr-CH";
const products = Object.fromEntries(Object.entries(PRODUCTS[lang]).map(([id, [label, formats]]) => [id, { label, formats, href: L(`/datasets/${id}`) }]));
const scriptCopy = { s: SCRIPT[lang], accountPath, dateLocale, products };
const helpTopics = HELP_TOPICS[lang].filter(topic => ["email-absent", "lien-expire", "connexion", "recu-facture"].includes(topic.id));
const supportPath = L("/support");
---
<AtlasLayout title={c.title} description={c.description} noindex={true}>
<div class="compte" data-account={JSON.stringify(scriptCopy)}>
 <div class="atlas-shell atlas-breadcrumb"><a href={L("/")}>{c.home}</a><span aria-hidden="true">/</span><span>{c.crumb}</span></div>
 <div class="atlas-shell"><p id="banner" class="service-banner" role="status" aria-live="polite" hidden></p></div>

 <noscript>
  <section class="compte-hero compte-noscript"><div class="atlas-shell">
   <p class="atlas-kicker">{c.kicker}</p>
   <h1>{c.noscriptTitle}</h1>
   <p class="atlas-lede">{c.noscriptText}</p>
   <p class="compte-noscript-help">{c.noscriptHelp} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> · <a href={supportPath}>{c.helpAll}</a></p>
  </div></section>
 </noscript>

 <section id="loading-view" class="compte-loading" hidden><div class="atlas-shell">
  <div class="compte-loading-card" role="status"><span class="compte-loading-dot" aria-hidden="true"></span><span data-loading-text>{c.loading}</span></div>
 </div></section>

 <section id="login-view" class="compte-hero" hidden aria-labelledby="login-title"><div class="atlas-shell compte-hero-grid">
  <div class="compte-intro" data-atlas-enter>
   <p class="atlas-kicker">{c.kicker}</p>
   <h1 id="login-title">{c.hero}<br/><em>{c.accent}</em></h1>
   <p class="atlas-lede">{c.lede}</p>
   <ul class="compte-facts">{c.facts.map(fact => <li>{fact}</li>)}</ul>
  </div>
  <div class="compte-login-card" data-atlas-enter>
   <p class="compte-card-kicker">{c.cardKicker}</p>
   <h2>{c.cardTitle}</h2>
   <form id="login-form" class="compte-form">
    <label for="login-email">{c.fieldLabel}</label>
    <input id="login-email" type="email" name="email" required autocomplete="email" inputmode="email" spellcheck="false" placeholder={c.placeholder} />
    <button type="submit" class="atlas-btn">{c.submit}<span aria-hidden="true">→</span></button>
    <p id="login-msg" class="compte-msg" role="status" aria-atomic="true"></p>
   </form>
   <ol class="compte-login-steps">{c.steps.map((step, index) => <li><span aria-hidden="true">{index + 1}</span><p>{step}</p></li>)}</ol>
   <p class="compte-card-foot">{c.notCustomer} <a href={`${L("/")}#datasets`}>{c.browse}</a></p>
  </div>
 </div></section>

 <section id="dashboard-view" class="compte-dash" hidden aria-labelledby="dashboard-title"><div class="atlas-shell">
  <div class="compte-dash-head">
   <div>
    <p class="atlas-kicker">{c.dashKicker}</p>
    <p id="dashboard-email" class="compte-email"></p>
    <h1 id="dashboard-title">{c.dashTitle}</h1>
    <p class="compte-dash-intro">{c.dashIntro}</p>
   </div>
   <button id="logout-btn" type="button" class="atlas-btn atlas-btn-secondary compte-logout">{c.logout}</button>
  </div>

  <ul id="datasets-list" class="compte-files" aria-label={c.filesLabel}></ul>
  <p id="files-error" class="service-banner is-error" role="status" hidden></p>

  <div id="empty-state" class="compte-empty" hidden>
   <span class="compte-empty-art" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><path d="M8 18h18l5 6h25v28H8z"/><path d="M8 24h48"/><path class="compte-empty-plus" d="M32 32v12M26 38h12"/></svg></span>
   <div>
    <p class="atlas-kicker">{c.emptyKicker}</p>
    <h2>{c.emptyTitle}</h2>
    <p>{c.emptyText}</p>
    <div class="atlas-actions"><a class="atlas-btn" href={L("/bundle")}>{c.emptyBundle}<span aria-hidden="true">↗</span></a><a class="atlas-text-link" href={`${supportPath}#email-absent`}>{c.emptyHelp}<span aria-hidden="true">↗</span></a></div>
   </div>
  </div>

  <section id="receipts-section" class="compte-receipts" hidden aria-labelledby="receipts-title">
   <div class="compte-section-head">
    <div><p class="atlas-kicker">{c.receiptsKicker}</p><h2 id="receipts-title">{c.receiptsTitle}</h2></div>
    <p>{c.receiptsIntro} <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(c.invoice)}`}>{c.invoice}</a></p>
   </div>
   <ul id="receipts-list" class="compte-receipt-list"></ul>
  </section>

  <section id="mcp-section" class="compte-mcp" hidden aria-labelledby="mcp-title">
   <div>
    <p class="atlas-kicker">{c.mcpKicker}</p>
    <h2 id="mcp-title">{c.mcpName} <span class="compte-mcp-status"><span aria-hidden="true"></span>{c.mcpStatus}</span></h2>
    <p id="mcp-meta" class="compte-mcp-meta"></p>
    <p id="mcp-msg" class="compte-mcp-msg" role="status"></p>
   </div>
   <button id="mcp-portal-btn" type="button" class="atlas-btn">{c.mcpPortal}<span aria-hidden="true">↗</span></button>
  </section>
 </div></section>

 <PurchaseJourney id="trajet" returnLink={false} />

 <section class="atlas-section compte-help" aria-labelledby="help-title"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter>
   <div><p class="atlas-kicker">{c.helpKicker}</p><h2 id="help-title">{c.helpTitle}</h2></div>
   <div class="atlas-actions compte-help-actions"><a class="atlas-btn" href={supportPath}>{c.helpAll}<span aria-hidden="true">↗</span></a><a class="atlas-text-link" href={supportMailto(lang)}>{c.helpWrite}<span aria-hidden="true">↗</span></a></div>
  </div>
  <ul class="compte-help-list" data-atlas-enter>
   {helpTopics.map((topic, index) => <li><a href={`${supportPath}#${topic.id}`}><span aria-hidden="true">0{index + 1}</span><strong>{topic.question}</strong><em>{topic.answer[0]}</em><span class="compte-help-arrow" aria-hidden="true">↗</span></a></li>)}
  </ul>
 </div></section>
</div>
<script>
 import '../scripts/account';
</script>
</AtlasLayout>
