    loginUnavailable: "Le service de connexion est momentanément indisponible. Réessayez dans un instant.", loginError: "Une erreur est survenue. Veuillez réessayer.", loginNetworkError: "Erreur réseau. Veuillez réessayer.",
    loadError: "Impossible de charger votre espace client. Actualisez la page dans un instant.",
    logoutPending: "Déconnexion…", logoutError: "La déconnexion n’a pas pu être confirmée. Réessayez avant de quitter cet appareil.",
  },
  de: {
    bannerCheckoutSuccess: "Vielen Dank. Sobald Stripe die Zahlung bestätigt, gibt Ihnen eine E-Mail Zugriff auf Ihre Dateien, normalerweise innert weniger Minuten. Nichts erhalten? Prüfen Sie den Spamordner und melden Sie sich mit der Kauf-E-Mail an.",
    bannerCheckoutCancelled: "Zahlung abgebrochen. Wenn Sie die Zahlungsseite vor der Bestätigung verlassen haben, wurde kein Kauf erfasst.",
    bannerAuthOk: "Anmeldung bestätigt. Willkommen in Ihrem Kundenkonto.",
    bannerAuthInvalid: "Dieser Anmeldelink ist ungültig. Fordern Sie mit Ihrer E-Mail-Adresse einen neuen an.",
    bannerAuthExpired: "Dieser Anmeldelink ist abgelaufen oder wurde bereits verwendet. Fordern Sie einen neuen an: Er ist 15 Minuten gültig.",
    noVersion: "Derzeit keine Version verfügbar", versionLabel: "Version", untilLabel: "Aktualisierungen bis", endedLabel: "Aktualisierungen beendet am",
    endedNote: "Die angezeigte Version ist die letzte, die Ihr Kauf umfasst.",
    dlDownload: "Herunterladen", dlPreparing: "Wird vorbereitet…", dlRetry: "Erneut versuchen", dlStarted: "Download gestartet. Beginnt er nicht, versuchen Sie es erneut: Der vorbereitete Link läuft nach fünf Minuten ab.",
    dlSession: "Ihre Sitzung ist abgelaufen. Laden Sie die Seite neu und fordern Sie einen neuen Anmeldelink an.",
