const c = COPY[lang];
const s = JS[lang];

const accountPath = localizePath("/account", lang);
const dateLocale = lang === "de" ? "de-CH" : lang === "en" ? "en-GB" : "fr-CH";

// Liens d'onboarding — hrefs localisés calculés une fois (pas de préfixe
// /de/ saisi à la main), texte par langue assemblé par template literal.
const bundleHref = localizePath("/bundle", lang);
const taresHref = localizePath("/datasets/tares", lang);
const classHref = localizePath("/datasets/classifications", lang);
const finmaHref = localizePath("/datasets/finma", lang);

const steps: Record<Lang, string[]> = {
  fr: [
    `<strong>Pas encore client&nbsp;?</strong> Choisissez vos datasets sur <a href="${bundleHref}">la page bundle</a> ou les pages <a href="${taresHref}">TARES</a>, <a href="${classHref}">Classifications</a>, <a href="${finmaHref}">FINMA</a>.`,
    `<strong>Achat sécurisé</strong> via Stripe (cartes, Apple Pay, Google Pay).`,
    `<strong>Réception immédiate</strong> d'un email avec un lien de téléchargement direct (ZIP signé Ed25519).`,
