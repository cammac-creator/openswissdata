    notCustomer: "Not a customer yet?", browse: "See the files",
    noscriptTitle: "Your account", noscriptText: "Your account needs JavaScript to request a sign-in link and show your files. The download links you receive by email work without JavaScript.", noscriptHelp: "Need help? Write to",
    dashKicker: "Your account", dashTitle: "Your files", dashIntro: "Download the versions covered by your rights. Keep a copy of the files you receive.", logout: "Sign out", filesLabel: "Purchased files",
    emptyKicker: "No files in this account", emptyTitle: "Your account is ready, but empty.", emptyText: "A recent purchase appears here once the payment is confirmed. If you have already bought a file, check that you are signed in with the address entered at Stripe.",
    emptyBundle: `All three files together · ${chf(BUNDLE_OFFER.price)}`, emptyHelp: "Is a purchase missing?",
    receiptsKicker: "Receipts and terms", receiptsTitle: "Your purchases", receiptsIntro: "The Stripe receipt and accepted terms for each purchase. For an invoice addressed to your company, send us its legal name and billing address.", invoice: "Request an invoice",
    mcpKicker: "MCP subscription", mcpName: "openswissdata MCP server", mcpStatus: "Subscription", mcpPortal: "Manage my subscription",
    helpKicker: "Need help?", helpTitle: "Answers to common situations.", helpAll: "All support", helpWrite: "Contact support",
  },
} satisfies Record<Lang, Record<string, string | string[]>>;

/** Textes lus par le script ; toujours insérés avec textContent, jamais comme HTML. */
const SCRIPT = {
  fr: {
    bannerCheckoutSuccess: "Merci. Dès que Stripe confirme le paiement, un email vous donne accès à vos fichiers, normalement en quelques minutes. Rien reçu ? Regardez les indésirables, puis connectez-vous avec l’adresse utilisée pour l’achat.",
    bannerCheckoutCancelled: "Paiement interrompu. Si vous avez quitté la page de paiement avant de confirmer, aucun achat n’a été enregistré.",
