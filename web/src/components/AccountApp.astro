---
import type { Lang } from "../i18n/utils";
import { localizePath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/* ============================================================================
   Espace client — composant partagé FR/DE/EN (login + dashboard).

   i18n : l'espace client appartient à la couche « app / transactionnel »
   (comme les emails dans src/lib/email.ts), distincte du catalogue marketing
   t()/JSON. On garde donc la copie dans un dict TYPÉ colocalisé : un
   Record<Lang, …> fait ÉCHOUER le build sur une clé manquante, là où t()
   retomberait silencieusement sur le FR (i18n/utils.ts) — on gagne la
   complétude à la compilation.

   Le markup, le <style> et le <script> sont mutualisés ici : les 3 routes
   (/account, /de/account, /en/account) ne sont que de minces wrappers. Les
   identifiants DOM (#login-view, #banner, …) restent identiques dans les 3
   langues ; seules les chaînes changent. Les chaînes côté JS sont injectées
   via define:vars sous un SEUL objet namespacé `osdAcct` — les scripts
   is:inline partagent le scope top-level de la page, le préfixe évite toute
   collision avec les const de BaseLayout (navEl/reveals/io…).
   ============================================================================ */

interface AccountCopy {
  bcHome: string;
  bcCurrent: string;
  loginEyebrow1: string;
  loginEyebrow2: string;
  loginH1: string;
  loginLedeHtml: string;
  fieldLabel: string;
  emailPlaceholder: string;
  submitBtn: string;
  reassure: string;
  onboardingTitle: string;
  dashH1: string;
  logoutBtn: string;
  emptyEyebrow: string;
  emptyTitle: string;
  emptySub: string;
  emptyCta: string;
  mcpTitle: string;
  mcpName: string;
  mcpStatus: string;
  mcpPortalBtn: string;
  loading: string;
}

interface AccountJsCopy {
  bannerCheckoutSuccess: string;
  bannerCheckoutCancelled: string;
  bannerAuthOk: string;
  bannerAuthInvalid: string;
  bannerAuthExpired: string;
  noVersion: string;
  updatesUntil: string;
  dlDownload: string;
  dlPreparing: string;
  dlRetry: string;
  dlError: string;
  tierStandalone: string;
  tierBusiness: string;
  tierPro: string;
  tierStandard: string;
  tierFree: string;
