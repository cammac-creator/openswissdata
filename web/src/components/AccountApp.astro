---
/* ============================================================================
   Espace client — composant partagé FR/DE/EN (connexion + tableau de bord), style Atlas.

   Les trois routes (/account, /de/account, /en/account) ne sont que des enveloppes de
   langue. Les textes vivent dans deux dictionnaires TYPÉS : un Record<Lang, …> fait
   échouer le build sur une clé manquante, là où t() retomberait sur le français.

   Le comportement est dans web/src/scripts/account.ts : mêmes appels réseau qu'avant
   (adresses, méthodes, en-têtes, corps et cookies inchangés). Ce composant ne décide
   d'aucune logique de session, de cookie, d'origine ni de téléchargement.

   Sans JavaScript : les vues dynamiques restent masquées (attribut hidden) ; un bloc
   <noscript> explique la situation et le trajet d'achat et l'aide restent lisibles.
   ============================================================================ */
import type { Lang } from "../i18n/utils";
import { localizePath } from "../i18n/utils";
import AtlasLayout from "../layouts/AtlasLayout.astro";
import PurchaseJourney from "./PurchaseJourney.astro";
import "../styles/atlas-service.css";
import "../styles/atlas-compte.css";
import { BUNDLE_OFFER } from "../lib/offers";
import { HELP_TOPICS, SUPPORT_EMAIL, supportMailto } from "../lib/customer-care";

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (path: string) => localizePath(path, lang);
const chf = (value: number) => (lang === "fr" ? `${value} CHF` : `CHF ${value}`);

