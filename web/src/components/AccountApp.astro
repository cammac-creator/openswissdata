    dlNoVersion: "Für den von Ihrem Kauf erfassten Zeitraum ist keine Version verfügbar. Schreiben Sie uns mit Angabe des Produkts.",
    dlUnavailable: "Der Download konnte nicht vorbereitet werden. Bitte versuchen Sie es gleich noch einmal.",
    network: "Der Dienst antwortet nicht. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut.",
    productPage: "Produktseite", filesError: "Die Liste Ihrer Dateien konnte nicht geladen werden. Laden Sie die Seite gleich neu.",
    orderLabel: "Kauf vom", receipt: "Stripe-Beleg", receiptOpening: "Wird geöffnet…", receiptError: "Beleg derzeit nicht verfügbar. Für Ihren Beleg oder Ihre Firmenrechnung wenden Sie sich bitte an contact@openswissdata.com.",
    legalAccepted: "Akzeptierte AGB", legalNone: "Für diesen Kauf liegt kein versionierter Zustimmungsnachweis vor.", refunded: "Erstattet", partialRefund: "Erfasste Erstattung: ",
    tierStandalone: "Pro — 5'000 Anf./Monat", tierBusiness: "Business — 50'000 Anf./Monat", tierPro: "Pro", tierStandard: "Standard", tierFree: "Free", mcpKey: " · Schlüssel ",
    mcpOpening: "Wird geöffnet…", mcpRetry: "Erneut versuchen", mcpPortalError: "Das Abrechnungsportal kann nicht geöffnet werden. Bitte versuchen Sie es später erneut.",
    loginSending: "Wird gesendet…", loginSuccess: "Gehört diese Adresse zu einem Kauf, ist soeben ein Anmeldelink unterwegs. Öffnen Sie ihn innert 15 Minuten im Browser, in dem Sie Ihre Dateien ansehen möchten.",
    loginLimited: "Zu viele Anfragen kurz hintereinander. Warten Sie vor einem neuen Versuch oder öffnen Sie einen bereits erhaltenen Link.", loginInvalid: "Diese E-Mail-Adresse scheint ungültig. Bitte prüfen Sie sie und versuchen Sie es erneut.",
    loginUnavailable: "Die Anmeldung ist vorübergehend nicht verfügbar. Bitte versuchen Sie es gleich noch einmal.", loginError: "Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.", loginNetworkError: "Netzwerkfehler. Bitte versuchen Sie es erneut.",
    loadError: "Ihr Kundenkonto kann nicht geladen werden. Laden Sie die Seite gleich neu.",
    logoutPending: "Abmeldung…", logoutError: "Die Abmeldung konnte nicht bestätigt werden. Versuchen Sie es erneut, bevor Sie dieses Gerät verlassen.",
  },
  en: {
    bannerCheckoutSuccess: "Thank you. As soon as Stripe confirms the payment, an email gives you access to your files, normally within a few minutes. Nothing received? Check your spam folder, then sign in with the address used for the purchase.",
    bannerCheckoutCancelled: "Payment interrupted. If you left the payment page before confirming, no purchase was recorded.",
    bannerAuthOk: "Sign-in confirmed. Welcome to your account.",
    bannerAuthInvalid: "This sign-in link is not valid. Request a new one with your email address.",
    bannerAuthExpired: "This sign-in link has expired or was already used. Request a new one: it will be valid for 15 minutes.",
    noVersion: "No version available yet", versionLabel: "Version", untilLabel: "Updates until", endedLabel: "Updates ended on",
    endedNote: "The version shown is the last one covered by your purchase.",
    dlDownload: "Download", dlPreparing: "Preparing…", dlRetry: "Try again", dlStarted: "Download started. If it does not begin, try again: the prepared link expires after five minutes.",
    dlSession: "Your session has expired. Refresh the page, then request a new sign-in link.",
    dlForbidden: "This file is no longer available from this account. If this is a mistake, write to us.",
    dlNoVersion: "No version is available for the period covered by your purchase. Write to us and name the product.",
    dlUnavailable: "The download could not be prepared. Please try again in a moment.",
    network: "The service is not responding. Check your connection, then try again.",
    productPage: "Product page", filesError: "Your file list could not be loaded. Refresh the page in a moment.",
    orderLabel: "Purchase of", receipt: "Stripe receipt", receiptOpening: "Opening…", receiptError: "Receipt unavailable for now. For your receipt or a business invoice, email contact@openswissdata.com.",
    legalAccepted: "Accepted terms", legalNone: "No versioned acceptance record is available for this purchase.", refunded: "Refunded", partialRefund: "Refund recorded: ",
    tierStandalone: "Pro — 5,000 req/month", tierBusiness: "Business — 50,000 req/month", tierPro: "Pro", tierStandard: "Standard", tierFree: "Free", mcpKey: " · key ",
    mcpOpening: "Opening…", mcpRetry: "Try again", mcpPortalError: "Unable to open the billing portal. Please try again later.",
    loginSending: "Sending…", loginSuccess: "If this address matches a purchase, a sign-in link is on its way. Open it within 15 minutes, in the browser where you want to see your files.",
    loginLimited: "Too many requests in a short time. Wait before trying again, or open a link you have already received.", loginInvalid: "This email address does not look valid. Please check it and try again.",
    loginUnavailable: "Sign-in is temporarily unavailable. Please try again in a moment.", loginError: "An error occurred. Please try again.", loginNetworkError: "Network error. Please try again.",
    loadError: "Unable to load your account. Please refresh the page in a moment.",
    logoutPending: "Signing out…", logoutError: "Sign-out could not be confirmed. Please try again before leaving this device.",
