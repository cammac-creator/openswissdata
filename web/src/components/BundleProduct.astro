---
import AtlasLayout from "../layouts/AtlasLayout.astro";
import AtlasArtwork from "./AtlasArtwork.astro";
import "../styles/atlas-fiches.css";
import "../styles/atlas-fiche-bundle.css";
import { getLangFromPath, localizePath } from "../i18n/utils";
import { FILE_OFFERS } from "../lib/offers";
// Le lot est retiré de la vente (décision du 05.11.2026). La page reste en ligne : elle le dit,
// renvoie vers TARES et FINMA, et reçoit toujours les retours Stripe des achats de fichiers.
const lang = getLangFromPath(Astro.url.pathname);
const L = (path: string) => localizePath(path, lang);
const chf = (value: number) => (lang === "fr" ? `${value} CHF` : `CHF ${value}`);
const copy = {
 fr: {
  title: "Bundle TARES, Classifications et FINMA", description: "Le lot des trois fichiers OpenSwissData n’est pas en vente pour l’instant. TARES et le registre FINMA restent en vente séparément.",
  eyebrow: "Bundle · Pas en vente pour l’instant", hero: "Ce lot n’est pas", accent: "en vente pour l’instant.", intro: "TARES et le registre FINMA restent en vente séparément, chacun avec sa fiche, son échantillon et ses conditions.",
  seeTares: "Voir TARES", seeFinma: "Voir le registre FINMA", catalogue: "Les données", crumb: "Bundle",
  cancelled: "Paiement interrompu. Si vous avez quitté la page de paiement avant de confirmer, aucun achat n’a été enregistré. Vous pouvez reprendre depuis la fiche du fichier choisi.", error: "Le paiement n’a pas pu démarrer. Réessayez dans un instant ; si le problème persiste, écrivez à contact@openswissdata.com.",
  filesKicker: "01 / En vente", filesTitle: "Deux fichiers, à acheter séparément.", filesIntro: "Chaque fiche décrit le contenu réellement distribué et ses limites.",
  products: [
   ["tares", "TARES", "OFDF · BAZG", "Tarif douanier", ["Numéros de tarif à huit chiffres, désignations en quatre langues", "Toutes les lignes de taux en vigueur, avec unités, dates et conditions", "Résumé du droit de base, jamais le taux le plus bas choisi"], "CSV · JSON · Parquet · SQL"],
   ["finma", "FINMA REGISTRY", "FINMA · GLEIF", "Registre FINMA", ["Registre UID public de la FINMA, une ligne par autorisation", "Liste d’alerte séparée du registre", "LEI et adresses GLEIF par correspondance exacte de l’UID"], "Excel · CSV · JSON · Parquet · SQL"]],
  once: "paiement unique", readSheet: "Lire la fiche", loading: "Vérification…", unavailable: "Version non vérifiable pour le moment", codes: "numéros", rows: "lignes du registre",
  boughtKicker: "Déjà acheté ?", boughtTitle: "Votre achat ne change pas.", boughtText: "Si vous avez acheté ce lot, vos fichiers et vos droits restent accessibles dans votre espace client, selon les conditions acceptées lors de l’achat.",
  contact: "Écrire au support", account: "Espace client", boxTitle: "Classifications · NOGA, NACE, ISIC", boxText: "Les correspondances restent gratuites par le serveur MCP.", boxLink: "Essayer les correspondances gratuites", independent: "Service privé indépendant, sans affiliation aux institutions sources.",
 },
 de: {
  title: "Bundle TARES, Klassifikationen und FINMA", description: "Das Bundle der drei OpenSwissData-Dateien ist derzeit nicht im Verkauf. TARES und das FINMA-Register bleiben einzeln erhältlich.",
  eyebrow: "Bundle · Derzeit nicht im Verkauf", hero: "Dieses Bundle ist", accent: "derzeit nicht im Verkauf.", intro: "TARES und das FINMA-Register bleiben einzeln erhältlich, jeweils mit Produktseite, Muster und Bedingungen.",
  seeTares: "TARES ansehen", seeFinma: "FINMA-Register ansehen", catalogue: "Datensätze", crumb: "Bundle",
  cancelled: "Zahlung abgebrochen. Wenn Sie die Zahlungsseite vor der Bestätigung verlassen haben, wurde kein Kauf erfasst. Sie können auf der Seite der gewählten Datei fortfahren.", error: "Die Zahlung konnte nicht gestartet werden. Bitte versuchen Sie es gleich noch einmal; besteht das Problem weiter, schreiben Sie an contact@openswissdata.com.",
  filesKicker: "01 / Im Verkauf", filesTitle: "Zwei Dateien, einzeln erhältlich.", filesIntro: "Jede Produktseite beschreibt den tatsächlich gelieferten Inhalt und seine Grenzen.",
  products: [
   ["tares", "TARES", "BAZG", "Zolltarif", ["Achtstellige Tarifnummern, Bezeichnungen in vier Sprachen", "Alle geltenden Tarifzeilen mit Einheiten, Daten und Bedingungen", "Zusammenfassung des Normalansatzes, nie der tiefste Ansatz ausgewählt"], "CSV · JSON · Parquet · SQL"],
   ["finma", "FINMA REGISTRY", "FINMA · GLEIF", "FINMA-Register", ["Öffentliches UID-Register der FINMA, eine Zeile pro Bewilligung", "Vom Register getrennte Warnliste", "LEI und GLEIF-Adressen über exakte UID-Zuordnung"], "Excel · CSV · JSON · Parquet · SQL"]],
  once: "Einmalzahlung", readSheet: "Produktseite lesen", loading: "Wird geprüft…", unavailable: "Version derzeit nicht überprüfbar", codes: "Nummern", rows: "Registerzeilen",
  boughtKicker: "Bereits gekauft?", boughtTitle: "Ihr Kauf bleibt unverändert.", boughtText: "Wenn Sie dieses Bundle gekauft haben, bleiben Ihre Dateien und Rechte in Ihrem Kundenkonto zugänglich, gemäss den beim Kauf akzeptierten Bedingungen.",
  contact: "Support kontaktieren", account: "Kundenkonto", boxTitle: "Klassifikationen · NOGA, NACE, ISIC", boxText: "Die Zuordnungen bleiben über den MCP-Server kostenlos.", boxLink: "Kostenlose Zuordnungen testen", independent: "Unabhängiger privater Dienst ohne Verbindung zu den Quellinstitutionen.",
 },
 en: {
  title: "TARES, Classifications and FINMA bundle", description: "The bundle of the three OpenSwissData files is not on sale for now. TARES and the FINMA registry remain on sale separately.",
  eyebrow: "Bundle · Not on sale for now", hero: "This bundle is", accent: "not on sale for now.", intro: "TARES and the FINMA registry remain on sale separately, each with its own page, sample and terms.",
  seeTares: "See TARES", seeFinma: "See the FINMA registry", catalogue: "The data", crumb: "Bundle",
  cancelled: "Payment interrupted. If you left the payment page before confirming, no purchase was recorded. You can resume from the page of the file you chose.", error: "The payment could not start. Please try again in a moment; if the problem persists, email contact@openswissdata.com.",
  filesKicker: "01 / On sale", filesTitle: "Two files, sold separately.", filesIntro: "Each product page describes the content actually distributed and its limitations.",
  products: [
   ["tares", "TARES", "FOCBS · BAZG", "Customs tariff", ["Eight-digit tariff numbers, descriptions in four languages", "Every rate row in force, with units, dates and conditions", "Base-duty summary, never the lowest rate picked"], "CSV · JSON · Parquet · SQL"],
   ["finma", "FINMA REGISTRY", "FINMA · GLEIF", "FINMA registry", ["FINMA public UID registry, one row per authorisation", "Warning list kept separate from the registry", "GLEIF LEIs and addresses through exact UID matches"], "Excel · CSV · JSON · Parquet · SQL"]],
  once: "one-time payment", readSheet: "Read the product page", loading: "Checking…", unavailable: "Version cannot currently be verified", codes: "numbers", rows: "registry rows",
  boughtKicker: "Already bought it?", boughtTitle: "Your purchase does not change.", boughtText: "If you bought this bundle, your files and rights remain available in your account, under the terms accepted at purchase.",
  contact: "Contact support", account: "Your account", boxTitle: "Classifications · NOGA, NACE, ISIC", boxText: "The mappings remain free through the MCP server.", boxLink: "Try the free mappings", independent: "Independent private service, not affiliated with the source institutions.",
 },
}[lang];
const live = { lang, loading: copy.loading, unavailable: copy.unavailable, codes: copy.codes, rows: copy.rows, cancelled: copy.cancelled, error: copy.error };
---
<AtlasLayout title={`${copy.title} | openswissdata`} description={copy.description}>
<div class="atlas-product-site fiche" data-bundle-product data-copy={JSON.stringify(live)}>
 <div class="atlas-shell atlas-breadcrumb"><a href={`${L("/")}#datasets`}>{copy.catalogue}</a><span aria-hidden="true">/</span><span>{copy.crumb}</span></div>
 <div class="atlas-shell"><p class="fiche-banner" data-checkout-banner role="status" hidden></p></div>
 <section class="atlas-hero atlas-product-hero"><div class="atlas-shell atlas-hero-grid"><div class="atlas-hero-copy" data-atlas-enter><p class="atlas-kicker">{copy.eyebrow}</p><h1>{copy.hero}<br/><em>{copy.accent}</em></h1><p class="atlas-lede">{copy.intro}</p><div class="atlas-actions"><a href={L("/datasets/tares")} class="atlas-btn">{copy.seeTares}<span aria-hidden="true">↗</span></a><a href={L("/datasets/finma")} class="atlas-text-link">{copy.seeFinma} ↗</a></div></div><AtlasArtwork /></div></section>

 <section class="atlas-section" id="en-vente"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.filesKicker}</p><h2>{copy.filesTitle}</h2></div><p class="atlas-section-intro">{copy.filesIntro}</p></div>
  <div class="fiche-stack" data-atlas-enter>
   <div class="fiche-sheets">{copy.products.map(([id, label, source, title, items, formats]) => <article class={`fiche-sheet fiche-sheet-${id}`}>
    <div class="fiche-sheet-head"><p class="atlas-kicker">{label}</p><span>{source as string}</span></div>
    <h3>{title as string}</h3>
    <ul>{(items as string[]).map(item => <li>{item}</li>)}</ul>
    <p class="fiche-sheet-formats">{formats as string}</p>
    <p class="fiche-sheet-live"><span data-live-version={id as string}>{copy.loading}</span><span data-live-count={id as string}></span></p>
    <div class="fiche-sheet-foot"><strong>{chf(FILE_OFFERS[id as "tares" | "finma"].price)} <small>{copy.once}</small></strong><a href={L(`/datasets/${id}`)}>{copy.readSheet}<span aria-hidden="true">↗</span></a></div>
   </article>)}</div>
  </div>
 </div></section>

 <section class="atlas-shell" id="deja-achete"><div class="atlas-purchase" data-atlas-enter><div><p class="atlas-kicker">{copy.boughtKicker}</p><h2>{copy.boughtTitle}</h2><p>{copy.boughtText}</p><div class="atlas-actions"><a href={L("/account")} class="atlas-text-link">{copy.account} ↗</a><a href="mailto:contact@openswissdata.com" class="atlas-text-link">{copy.contact} ↗</a></div></div><div class="atlas-purchase-box"><p>{copy.boxTitle}</p><p>{copy.boxText}</p><a class="atlas-btn" href={`${L("/mcp")}#install`}>{copy.boxLink}<span aria-hidden="true">↗</span></a></div></div><p class="atlas-live-note">{copy.independent}</p></section>
</div>
<script>
 import '../scripts/bundle-product';
</script>
</AtlasLayout>
