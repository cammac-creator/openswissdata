---
import CheckoutNotice from "./CheckoutNotice.astro";
import AtlasLayout from "../layouts/AtlasLayout.astro";
import AtlasArtwork from "./AtlasArtwork.astro";
import { getLangFromPath } from "../i18n/utils";
import { FILE_OFFERS } from "../lib/offers";
import { datasetJsonLd as buildDatasetJsonLd } from "../lib/structured-data";
import { GUIDE_IDS, guidePath, SOURCES } from "../lib/guides";
import { GUIDES } from "../content/guides-finma";
import "../styles/atlas-guide-links.css";
const lang = getLangFromPath(Astro.url.pathname);
const prefix = lang === "fr" ? "" : `/${lang}`;
const copy = {
 fr: {
  title: "Registre FINMA : des données prêtes à travailler",
  description: "Registre public FINMA normalisé, liste d'alerte séparée et enrichissement LEI par UID exact. Excel, CSV, JSON, Parquet et SQL.",
  eyebrow: "FINMA · Données de référence suisses", hero: "Les données FINMA,", accent: "prêtes à travailler.",
  intro: "Retrouvez le registre public UID de la FINMA dans des fichiers structurés, avec les autorisations en quatre langues. Les LEI et adresses disponibles sont ajoutés depuis GLEIF par correspondance exacte de l'UID.",
  buy: "Acheter FINMA Registry", sample: "Télécharger l’échantillon CSV", price: "Paiement unique", updates: `360 jours de mises à jour inclus. Prolongation facultative : ${FILE_OFFERS.finma.renewal} CHF/an.`,
  status: "Dernière collecte publiée", waiting: "Vérification de la version disponible…", unavailable: "La version ne peut pas être vérifiée pour le moment. Contactez-nous avant votre achat.",
  rows: "Lignes du registre", uids: "UID distincts", leis: "Lignes avec un LEI", warnings: "Avertissements séparés",
  why: "Ce que vous recevez", cards: [
   ["Un fichier pour chaque usage", "Excel avec plusieurs onglets, CSV unifié et par catégorie, JSON, Parquet et SQL. Schémas, guide de lecture et contrôles SHA-256 sont inclus."],
   ["Une provenance vérifiable", "Sources datées, manifeste signé Ed25519 et fichier d’horodatage RFC-3161. Les champs enrichis indiquent leur source GLEIF."],
   ["Un historique explicite", "Changements observés entre les versions disponibles sur les 90 derniers jours. Les périodes sans collecte sont signalées ; les dates d’observation ne sont pas des dates de décision FINMA."]],
  limitsTitle: "Comprendre la couverture", limits: [
   "Une même entreprise peut apparaître plusieurs fois si elle possède plusieurs autorisations. Le nombre de lignes n’est donc pas un nombre d’entreprises.",
   "Le LEI, l’adresse et le canton ne sont renseignés que lorsqu’un rapprochement non ambigu est disponible. Les dates de licence et le statut ne sont pas fournis par le CSV source et restent vides.",
   "La liste d’alerte reste séparée du registre. Un nom ressemblant n’établit pas une identité : aucun signalement automatique n’est attribué à une institution sur cette seule base.",
   "Un LEI non renouvelé (LAPSED) n’est pas une sanction ni un retrait d’autorisation FINMA. L’absence d’une institution dans un instantané ne permet pas non plus de conclure à une sanction.",
   "Pour les gestionnaires de fortune et trustees, le fichier indique l’organisme de surveillance (loi sur les établissements financiers, LEFin) repris de la liste officielle de la FINMA lorsque la correspondance est exacte, et il joint les listes FINMA des OAR reconnus et des organismes de surveillance autorisés, sans leurs membres ; un organisme de surveillance n’est pas une affiliation à un OAR.",
   "Le périmètre suit le registre UID public de la FINMA. Il ne contient pas les affiliations aux organismes d’autorégulation (OAR, loi sur le blanchiment d’argent, LBA) ni le registre des intermédiaires d’assurance. Consultez la source officielle pour une décision de conformité."],
  oarNote: "Pour vérifier une affiliation à un OAR :", scopeNote: "Ne contient pas les affiliations aux organismes d’autorégulation (OAR) ni le registre des intermédiaires d’assurance.",
  preview: "Un aperçu des fichiers réels", previewNote: "Jusqu’à 20 lignes par catégorie présente, issues de la version publiée. Une absence dans cet échantillon ne signifie pas une absence du registre.", search: "Filtrer par nom, UID, LEI ou catégorie", empty: "Aucun résultat dans cet échantillon.",
  columns: ["Institution", "Catégorie", "UID", "LEI"], history: "Continuité de l’historique", gap: "Intervalle sans collecte", days: "jours", noGap: "Aucun intervalle de plus de deux jours entre les versions disponibles.",
  service: "Livraison et accompagnement", serviceText: "Après paiement, votre archive est accessible par email et depuis votre espace client. Le reçu Stripe y est également disponible. Pour une facture au nom de votre entreprise, envoyez-nous sa raison sociale et son adresse de facturation.",
  contact: "Écrire au support", account: "Espace client", source: "Consulter la source FINMA", independent: "Service privé indépendant, sans affiliation à la FINMA ou à GLEIF.",
 },
 en: {
  title: "FINMA Registry: data ready to use", description: "Structured FINMA public registry, separate warning list and LEI enrichment using exact UID matches. Excel, CSV, JSON, Parquet and SQL.",
  eyebrow: "FINMA · Swiss reference data", hero: "FINMA data,", accent: "ready to use.",
  intro: "Get the FINMA public UID registry in structured files, including authorisation labels in four languages. Available LEIs and legal addresses are added from GLEIF using exact UID matches.",
  buy: "Buy FINMA Registry", sample: "Download CSV sample", price: "One-time payment", updates: `360 days of updates included. Optional extension: CHF ${FILE_OFFERS.finma.renewal}/year.`,
  status: "Latest published collection", waiting: "Checking the available version…", unavailable: "The current version cannot be verified. Please contact us before purchasing.", rows: "Registry rows", uids: "Distinct UIDs", leis: "Rows with an LEI", warnings: "Separate warnings",
  why: "What is included", cards: [
   ["Files for your workflow", "Multi-sheet Excel, unified and per-category CSV, JSON, Parquet and SQL. Includes schemas, reading guide and SHA-256 checksums."],
   ["Verifiable provenance", "Dated sources, Ed25519-signed manifest and RFC-3161 timestamp file. Enriched fields identify their GLEIF source."],
   ["Transparent history", "Observed changes between available versions over the last 90 days. Collection gaps are disclosed; observation dates are not FINMA decision dates."]],
  limitsTitle: "Understanding coverage", limits: [
   "A company may appear more than once if it holds multiple authorisations. Row counts are therefore not company counts.",
   "LEI, address and canton are populated only when an unambiguous match is available. Licence dates and status are not provided by the source CSV and remain empty.",
   "The warning list is kept separate. A similar name does not establish identity: institutions are not automatically flagged based on name similarity.",
   "A non-renewed LEI (LAPSED) is not a sanction or a withdrawal of FINMA authorisation. An institution’s absence from a snapshot does not establish a sanction either.",
   "For portfolio managers and trustees, the file gives the supervisory organisation under the Financial Institutions Act (FinIA) from FINMA’s official list where the match is exact, and it includes FINMA’s lists of recognised SROs and authorised supervisory organisations, without their members; a supervisory organisation is not an SRO affiliation.",
   "Coverage follows FINMA’s public UID registry. It does not include self-regulatory organisation (SRO) affiliations under the Anti-Money Laundering Act (AMLA), nor the register for insurance intermediaries. Consult the official source before making compliance decisions."],
  oarNote: "To verify an SRO affiliation:", scopeNote: "Does not include self-regulatory organisation (SRO) affiliations or the register for insurance intermediaries.",
  preview: "Preview the actual files", previewNote: "Up to 20 rows per available category, taken from the published version. Absence from this sample does not imply absence from the registry.", search: "Filter by name, UID, LEI or category", empty: "No match in this sample.", columns: ["Institution", "Category", "UID", "LEI"], history: "History coverage", gap: "Collection gap", days: "days", noGap: "No gap longer than two days between available versions.",
  service: "Delivery and support", serviceText: "After payment, download your archive from the delivery email or your account. Your Stripe receipt is also available there. For an invoice addressed to your company, send us its legal name and billing address.", contact: "Contact support", account: "Your account", source: "View FINMA source", independent: "Independent private service, not affiliated with FINMA or GLEIF.",
 },
 de: {
  title: "FINMA-Register: Daten zur direkten Verwendung", description: "Strukturiertes öffentliches FINMA-Register, separate Warnliste und LEI-Anreicherung über exakte UID-Zuordnung. Excel, CSV, JSON, Parquet und SQL.",
  eyebrow: "FINMA · Schweizer Referenzdaten", hero: "FINMA-Daten,", accent: "direkt verwendbar.",
  intro: "Das öffentliche UID-Register der FINMA als strukturierte Dateien, mit Bewilligungsarten in vier Sprachen. Verfügbare LEIs und Geschäftsadressen ergänzen wir aus GLEIF durch exakte UID-Zuordnung.",
  buy: "FINMA Registry kaufen", sample: "CSV-Muster herunterladen", price: "Einmalige Zahlung", updates: `360 Tage Aktualisierungen inklusive. Freiwillige Verlängerung: CHF ${FILE_OFFERS.finma.renewal}/Jahr.`,
  status: "Zuletzt veröffentlichte Erhebung", waiting: "Verfügbare Version wird geprüft…", unavailable: "Die aktuelle Version kann derzeit nicht geprüft werden. Bitte kontaktieren Sie uns vor dem Kauf.", rows: "Registerzeilen", uids: "Eindeutige UIDs", leis: "Zeilen mit LEI", warnings: "Separate Warnungen",
  why: "Das erhalten Sie", cards: [
   ["Passende Dateiformate", "Excel mit mehreren Tabellenblättern, CSV gesamt und je Kategorie, JSON, Parquet und SQL. Mit Schemata, Leseanleitung und SHA-256-Prüfsummen."],
   ["Nachprüfbare Herkunft", "Datierte Quellen, Ed25519-signiertes Manifest und RFC-3161-Zeitstempeldatei. Ergänzte Felder verweisen auf ihre GLEIF-Quelle."],
   ["Transparenter Verlauf", "Beobachtete Änderungen zwischen verfügbaren Versionen der letzten 90 Tage. Erhebungslücken werden ausgewiesen; Beobachtungsdaten sind keine FINMA-Entscheiddaten."]],
  limitsTitle: "Abdeckung verstehen", limits: [
   "Ein Unternehmen kann bei mehreren Bewilligungen mehrfach erscheinen. Die Zeilenzahl entspricht deshalb nicht der Anzahl Unternehmen.",
   "LEI, Adresse und Kanton werden nur bei eindeutiger Zuordnung ergänzt. Bewilligungsdatum und Status fehlen in der CSV-Quelle und bleiben leer.",
   "Die Warnliste bleibt separat. Ein ähnlicher Name belegt keine Identität: Institute werden nicht allein aufgrund einer Namensähnlichkeit markiert.",
   "Ein nicht erneuerter LEI (LAPSED) bedeutet weder eine Sanktion noch den Entzug einer FINMA-Bewilligung. Auch das Fehlen eines Instituts in einer Momentaufnahme belegt keine Sanktion.",
   "Für Vermögensverwalter und Trustees nennt die Datei die Aufsichtsorganisation nach Finanzinstitutsgesetz (FINIG) aus der offiziellen Liste der FINMA, sofern die Zuordnung exakt ist, und sie enthält die FINMA-Listen der anerkannten Selbstregulierungsorganisationen (SRO) und der bewilligten Aufsichtsorganisationen, ohne deren Mitglieder; eine Aufsichtsorganisation ist keine SRO-Zugehörigkeit.",
   "Die Abdeckung folgt dem öffentlichen UID-Register der FINMA. Sie enthält keine Zugehörigkeiten zu Selbstregulierungsorganisationen (SRO, Geldwäschereigesetz, GwG) und kein Register der Versicherungsvermittlerinnen und Versicherungsvermittler. Für Compliance-Entscheide ist die offizielle Quelle zu prüfen."],
  oarNote: "So prüfen Sie eine SRO-Zugehörigkeit:", scopeNote: "Enthält keine Zugehörigkeiten zu Selbstregulierungsorganisationen (SRO) und kein Register der Versicherungsvermittlerinnen und Versicherungsvermittler.",
  preview: "Vorschau der tatsächlichen Dateien", previewNote: "Bis zu 20 Zeilen je vorhandener Kategorie aus der veröffentlichten Version. Ein fehlender Treffer in dieser Auswahl bedeutet nicht, dass ein Institut im Register fehlt.", search: "Nach Name, UID, LEI oder Kategorie filtern", empty: "Kein Treffer in diesem Muster.", columns: ["Institut", "Kategorie", "UID", "LEI"], history: "Verfügbarkeit des Verlaufs", gap: "Erhebungslücke", days: "Tage", noGap: "Keine Lücke von mehr als zwei Tagen zwischen verfügbaren Versionen.",
  service: "Lieferung und Unterstützung", serviceText: "Nach der Zahlung erhalten Sie das Archiv per E-Mail und in Ihrem Kundenkonto. Dort finden Sie auch den Stripe-Zahlungsbeleg. Für eine Rechnung an Ihr Unternehmen senden Sie uns bitte den Firmennamen und die Rechnungsadresse.", contact: "Support kontaktieren", account: "Kundenkonto", source: "FINMA-Quelle ansehen", independent: "Unabhängiger privater Dienst ohne Verbindung zur FINMA oder GLEIF.",
 },
}[lang];
const coverageCopy = {
 fr: {title:"Champs renseignés dans cette version", note:"Calcul par ligne d’autorisation, pas par entreprise. Les champs vides restent vides dans les fichiers.", field:"Champ", count:"Lignes renseignées", share:"Part des lignes", labels:{uid:"UID",lei:"LEI",licence_date:"Date d’autorisation",status:"Statut détaillé",canton:"Canton",city:"Localité",address:"Adresse"}},
 de: {title:"Ausgefüllte Felder dieser Version", note:"Berechnung je Bewilligungszeile, nicht je Unternehmen. Fehlende Werte bleiben in den Dateien leer.",field:"Feld",count:"Ausgefüllte Zeilen",share:"Anteil der Zeilen",labels:{uid:"UID",lei:"LEI",licence_date:"Bewilligungsdatum",status:"Detaillierter Status",canton:"Kanton",city:"Ort",address:"Adresse"}},
 en: {title:"Populated fields in this version",note:"Calculated per authorisation row, not per company. Missing values remain empty in the files.",field:"Field",count:"Populated rows",share:"Share of rows",labels:{uid:"UID",lei:"LEI",licence_date:"Authorisation date",status:"Detailed status",canton:"Canton",city:"City",address:"Address"}},
}[lang];
const datasetJsonLd = buildDatasetJsonLd("finma", lang, copy.description);
// Guides approfondis : sources officielles, lecture d’une absence, automatisation du contrôle.
const guidesTitle = { fr: "Guides FINMA", de: "FINMA-Leitfäden", en: "FINMA guides" }[lang];
const guides = [...GUIDE_IDS].sort((a, b) => GUIDES[a].order - GUIDES[b].order).map(id => ({ href: guidePath(id, lang), order: GUIDES[id].order, title: GUIDES[id][lang].title }));
const atlas = {
 fr: { display:'Affichage de l’échantillon', table:'Tableau', excerpt:'Extrait des quatre champs affichés · 20 lignes maximum', catalogue:'Les données', preview:'Aperçu', included:'Contenu', coverage:'Couverture', purchase:'Acheter', hero:'Le registre FINMA.', accent:'À portée de main.', previewKicker:'01 / Explorez avant d’acheter', contentKicker:'02 / Dans votre archive', coverageKicker:'03 / La transparence, champ par champ', purchaseKicker:'Votre prochaine base de travail', delivery:'Vos fichiers. Votre rythme.', nojs:'Activez JavaScript pour consulter la version, la couverture et l’aperçu interactif, ou téléchargez l’échantillon CSV pour examiner les données.', scroll:'Faites défiler le tableau pour voir toutes les colonnes.' },
 de: { display:'Musteransicht', table:'Tabelle', excerpt:'Auszug der vier angezeigten Felder · maximal 20 Zeilen', catalogue:'Datensätze', preview:'Vorschau', included:'Inhalt', coverage:'Abdeckung', purchase:'Kaufen', hero:'Das FINMA-Register.', accent:'Griffbereit.', previewKicker:'01 / Vor dem Kauf entdecken', contentKicker:'02 / In Ihrem Archiv', coverageKicker:'03 / Transparenz, Feld für Feld', purchaseKicker:'Ihre nächste Datengrundlage', delivery:'Ihre Dateien. Ihr Tempo.', nojs:'Aktivieren Sie JavaScript für Version, Abdeckung und interaktive Vorschau oder laden Sie das CSV-Muster herunter, um die Daten zu prüfen.', scroll:'Scrollen Sie die Tabelle, um alle Spalten zu sehen.' },
 en: { display:'Sample display', table:'Table', excerpt:'Extract of the four displayed fields · up to 20 rows', catalogue:'The data', preview:'Preview', included:'Included', coverage:'Coverage', purchase:'Buy', hero:'The FINMA registry.', accent:'At your fingertips.', previewKicker:'01 / Explore before you buy', contentKicker:'02 / Inside your archive', coverageKicker:'03 / Transparency, field by field', purchaseKicker:'Your next data foundation', delivery:'Your files. Your workflow.', nojs:'Enable JavaScript to view the version, coverage and interactive preview, or download the CSV sample to examine the data.', scroll:'Scroll the table to see all columns.' },
}[lang];

---

<AtlasLayout title={`${copy.title} | openswissdata`} description={copy.description} image="/og-finma.png" datasetJsonLd={datasetJsonLd}>
<div class="atlas-product-site" data-finma-product data-lang={lang} data-copy={JSON.stringify(copy)}>
 <div class="atlas-shell atlas-breadcrumb"><a href={`${prefix}/#datasets`}>{atlas.catalogue}</a><span aria-hidden="true">/</span><span>FINMA Registry</span></div>
 <section class="atlas-hero atlas-product-hero"><div class="atlas-shell atlas-hero-grid"><div class="atlas-hero-copy" data-atlas-enter><p class="atlas-kicker">{copy.eyebrow}</p><h1>{atlas.hero}<br/><em>{atlas.accent}</em></h1><p class="atlas-lede">{copy.intro}</p><div class="atlas-actions"><a href="#apercu" class="atlas-btn">{atlas.preview}<span aria-hidden="true">↓</span></a><a href="#acheter" class="atlas-text-link">{atlas.purchase} · {FILE_OFFERS.finma.price} CHF ↗</a></div><div class="atlas-hero-footnote"><span>Excel · CSV · JSON · Parquet · SQL</span><span>Ed25519 · SHA-256</span></div></div><AtlasArtwork /></div></section>
 <div class="atlas-product-nav"><nav class="atlas-shell atlas-product-nav-inner" aria-label={copy.title}><div class="atlas-product-nav-links"><a href="#apercu">{atlas.preview}</a><a href="#contenu">{atlas.included}</a><a href="#couverture">{atlas.coverage}</a></div><a class="atlas-nav-buy" href="#acheter">{atlas.purchase}<span>{FILE_OFFERS.finma.price} CHF ↗</span></a></nav></div>
 <div class="atlas-shell"><div class="atlas-quality"><div class="atlas-quality-heading"><p class="atlas-kicker">{copy.status}</p><p id="finma-version" role="status">{copy.waiting}</p></div><div class="atlas-quality-grid">{[["registry_rows",copy.rows],["unique_uids",copy.uids],["lei",copy.leis],["warning_rows",copy.warnings]].map(([key,label])=><div><strong data-count={key}>—</strong><span>{label}</span></div>)}</div><noscript class="atlas-noscript">{atlas.nojs}</noscript></div></div>
 <section class="atlas-section" id="apercu"><div class="atlas-shell"><div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{atlas.previewKicker}</p><h2>{copy.preview}</h2></div><p class="atlas-section-intro">{copy.previewNote}</p></div><div class="atlas-preview"><div class="atlas-preview-tools"><div class="atlas-search-wrap"><label for="finma-search">{copy.search}</label><input type="search" id="finma-search" placeholder="UID · LEI · FINMA" autocomplete="off" disabled/></div><a href="/api/catalog/finma?format=csv" class="atlas-text-link">{copy.sample} ↓</a></div><div class="atlas-preview-formats" data-finma-formats hidden><div role="group" aria-label={atlas.display}>{[['table',atlas.table],['csv','CSV'],['json','JSON']].map(([value,label])=><button type="button" data-format={value} aria-pressed={value==='table' ? 'true' : 'false'} aria-controls="finma-preview-display">{label}</button>)}</div><span>{atlas.excerpt}</span></div><div id="finma-preview-display"><div class="atlas-table-scroll" id="finma-format-table" tabindex="0" role="region" aria-label={`${copy.preview}. ${atlas.scroll}`}><table class="atlas-table"><thead><tr>{copy.columns.map(c=><th scope="col">{c}</th>)}</tr></thead><tbody id="finma-preview"></tbody></table></div><pre class="atlas-preview-code" id="finma-format-code" tabindex="0" role="region" aria-label={atlas.excerpt} hidden><code></code></pre></div><p id="finma-preview-status" class="atlas-preview-status" role="status">{copy.waiting}</p></div><p class="atlas-live-note">{atlas.scroll}</p></div></section>
 <section class="atlas-section atlas-method" id="contenu"><div class="atlas-shell"><div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{atlas.contentKicker}</p><h2>{copy.why}</h2></div><p class="atlas-section-intro">{copy.independent}</p></div><div class="atlas-benefits">{copy.cards.map(([title,text],i)=><article class="atlas-benefit" data-atlas-enter><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
 <section class="atlas-section" id="couverture"><div class="atlas-shell"><div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{atlas.coverageKicker}</p><h2>{copy.limitsTitle}</h2></div><a href="https://www.finma.ch/en/finma-public/authorised-institutions-individuals-and-products/" class="atlas-text-link">{copy.source} ↗</a></div><div class="atlas-panel-grid"><div><ul class="atlas-limits">{copy.limits.map(item=><li>{item}</li>)}</ul><p class="atlas-oar-link">{copy.oarNote} <a href={SOURCES['finma-oar'].url[lang]} class="atlas-text-link">{SOURCES['finma-oar'].title[lang]} ↗</a></p></div><div><div class="atlas-coverage"><h3>{coverageCopy.title}</h3><p>{coverageCopy.note}</p><table><thead><tr><th scope="col">{coverageCopy.field}</th><th scope="col">{coverageCopy.count}</th><th scope="col">{coverageCopy.share}</th></tr></thead><tbody>{Object.entries(coverageCopy.labels).map(([key,label])=><tr><th scope="row">{label}</th><td data-field-count={key}>—</td><td><span data-field-share={key}>—</span><span class="atlas-meter" aria-hidden="true"><span data-field-meter={key}></span></span></td></tr>)}</tbody></table></div><div class="atlas-history"><h3>{copy.history}</h3><p id="finma-history">{copy.waiting}</p></div></div></div><nav class="guide-links" aria-labelledby="finma-guides-titre"><p class="atlas-kicker" id="finma-guides-titre">{guidesTitle}</p><ul>{guides.map(guide => <li><a href={guide.href}><span>0{guide.order}</span><span>{guide.title}</span><span aria-hidden="true">→</span></a></li>)}</ul></nav></div></section>
 <section class="atlas-shell" id="acheter"><div class="atlas-purchase" data-atlas-enter><div><p class="atlas-kicker">{atlas.purchaseKicker}</p><h2>{atlas.delivery}</h2><p>{copy.serviceText}</p><div class="atlas-actions"><a href="mailto:contact@openswissdata.com" class="atlas-text-link">{copy.contact} ↗</a><a href={`${prefix}/account`} class="atlas-text-link">{copy.account} ↗</a></div></div><div class="atlas-purchase-box"><p>FINMA REGISTRY · {copy.price}</p><div class="atlas-purchase-price"><strong>{FILE_OFFERS.finma.price}</strong><span>CHF</span></div><p>{copy.updates}</p><p class="atlas-purchase-scope">{copy.scopeNote}</p><form method="POST" action="/api/checkout/start"><input type="hidden" name="locale" value={lang}/><input type="hidden" name="dataset_ids" value="finma"/><button class="atlas-btn" type="submit">{copy.buy}<span aria-hidden="true">↗</span></button></form><CheckoutNotice /></div></div><p class="atlas-live-note">{copy.independent}</p></section>
</div>
<script>
 import '../scripts/finma-preview';
</script>
</AtlasLayout>
