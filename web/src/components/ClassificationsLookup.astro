---
import { getLangFromPath } from "../i18n/utils";
const lang = getLangFromPath(Astro.url.pathname);
const text = {
 fr:{title:'Vérifier une correspondance',intro:'Saisissez un code et choisissez les deux nomenclatures. La réponse distingue identité, rapprochement et perte de précision.',code:'Code',source:'Depuis',target:'Vers',button:'Vérifier',empty:'Aucun lien établi dans ce référentiel. Un examen métier ou une table dédiée peut être nécessaire.',error:'La vérification est momentanément indisponible.',loading:'Vérification…',version:'Référentiel',exact:'Identité documentée',close:'Correspondance approchée — à vérifier',broad:'Cible plus large — perte de précision',narrow:'Cible plus étroite — choix à vérifier',related:'Relation indicative — à vérifier',sources:'Sources',limit:'Deux liens approchés ne sont pas chaînés automatiquement.'},
 en:{title:'Check a correspondence',intro:'Enter a code and select two classifications. The result distinguishes identity, approximation and loss of detail.',code:'Code',source:'From',target:'To',button:'Check',empty:'No established link in this reference dataset. A dedicated table or business review may be required.',error:'The check is temporarily unavailable.',loading:'Checking…',version:'Reference',exact:'Documented identity',close:'Approximate match — review required',broad:'Broader target — less detail',narrow:'Narrower target — selection requires review',related:'Indicative relation — review required',sources:'Sources',limit:'Two approximate links are not chained automatically.'},
 de:{title:'Eine Zuordnung prüfen',intro:'Geben Sie einen Code ein und wählen Sie zwei Klassifikationen. Das Ergebnis unterscheidet Identität, Annäherung und Detailverlust.',code:'Code',source:'Von',target:'Nach',button:'Prüfen',empty:'Keine belegte Zuordnung in diesem Datenbestand. Eine eigene Tabelle oder fachliche Prüfung kann erforderlich sein.',error:'Die Prüfung ist vorübergehend nicht verfügbar.',loading:'Wird geprüft…',version:'Datenstand',exact:'Dokumentierte Identität',close:'Ungefähre Zuordnung — Prüfung erforderlich',broad:'Breiteres Ziel — Detailverlust',narrow:'Engeres Ziel — Auswahl prüfen',related:'Hinweis auf Beziehung — Prüfung erforderlich',sources:'Quellen',limit:'Zwei ungefähre Zuordnungen werden nicht automatisch verkettet.'},
}[lang];
const schemes=['NOGA_2008','NOGA_2025','NACE_2.0','NACE_2.1','ISIC_4'];
---
<div class="classification-demo" data-copy={JSON.stringify(text)}>
 <h3>{text.title}</h3><p>{text.intro}</p>
 <form>
  <label>{text.code}<input name="code" value="18.11" required maxlength="16" autocomplete="off" /></label>
  <label>{text.source}<select name="source">{schemes.map(s=><option value={s} selected={s==='NACE_2.0'}>{s.replaceAll('_',' ')}</option>)}</select></label>
  <label>{text.target}<select name="target">{schemes.map(s=><option value={s} selected={s==='ISIC_4'}>{s.replaceAll('_',' ')}</option>)}</select></label>
  <button class="v4-btn v4-btn-primary" type="submit">{text.button}</button>
 </form>
 <div data-result role="status" aria-live="polite"></div><p class="dim">{text.limit}</p>
</div>
<style>
.classification-demo{border:1px solid var(--border,#ddd);border-radius:16px;padding:clamp(20px,4vw,32px)}.classification-demo form{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin:24px 0}.classification-demo label{display:flex;flex-direction:column;gap:8px;font-size:.85rem;min-width:0}.classification-demo input,.classification-demo select{font:inherit;font-size:1rem;border:1px solid var(--border,#ccc);border-radius:8px;padding:12px;background:var(--color-bg,#fff);color:inherit;min-width:0;width:100%;box-sizing:border-box}.classification-demo button{grid-column:1/-1;justify-self:start}.classification-demo p{line-height:1.6}.classification-demo :global(li){margin-block:12px;line-height:1.6;overflow-wrap:anywhere}.classification-demo :global(a){overflow-wrap:anywhere}@media(max-width:600px){.classification-demo form{grid-template-columns:1fr}}
</style>
<script>
for(const element of document.querySelectorAll<HTMLElement>('.classification-demo')){
 const copy=JSON.parse(element.dataset.copy!);const form=element.querySelector('form')!;const output=element.querySelector<HTMLElement>('[data-result]')!;
 let controller:AbortController|undefined;
 form.addEventListener('submit',async event=>{
  event.preventDefault();controller?.abort();controller=new AbortController();const current=controller;
  output.replaceChildren();output.textContent=copy.loading;
  try{
   const params=new URLSearchParams();for(const [key,value] of new FormData(form))params.set(key,String(value));
   const response=await fetch('/api/catalog/classifications/mapping?'+params,{signal:current.signal,cache:'no-cache'});
   if(!response.ok)throw Error('indisponible');const data=await response.json();if(current!==controller)return;
   output.replaceChildren();const version=document.createElement('p');version.textContent=copy.version+' '+data.reference_version;output.append(version);
   if(!data.count){const note=document.createElement('p');note.textContent=copy.empty;output.append(note);return;}
   const list=document.createElement('ul');const names:Record<string,string>={exactMatch:copy.exact,closeMatch:copy.close,broadMatch:copy.broad,narrowMatch:copy.narrow,relatedMatch:copy.related};
   for(const mapping of data.mappings){const item=document.createElement('li');item.textContent=data.target_scheme.replaceAll('_',' ')+' '+mapping.target_code+' — '+names[mapping.relation];list.append(item);}output.append(list);
   const sources=document.createElement('details');const summary=document.createElement('summary');summary.textContent=copy.sources;sources.append(summary);
   for(const source of data.sources){const url=new URL(source.url);if(url.protocol!=='https:')continue;const p=document.createElement('p'),a=document.createElement('a');a.href=url.href;a.textContent=url.hostname+' · '+source.source_id;a.target='_blank';a.rel='noopener noreferrer';p.append(a);sources.append(p);}output.append(sources);
  }catch{if(current===controller&&!current.signal.aborted)output.textContent=copy.error;}
 });
}
</script>
