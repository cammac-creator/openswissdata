---
/**
 * Explorateur de l'échantillon TARES publié : cent lignes réelles lues dans le catalogue
 * servi (/api/catalog/tares), jamais un extrait figé au build. Les unités sont affichées
 * telles que livrées ; une ligne sans résumé renvoie au détail, jamais à une franchise.
 */
import { getLangFromPath } from "../i18n/utils";
const lang = getLangFromPath(Astro.url.pathname);
const text = {
 fr: { search: "Filtrer par numéro ou désignation", placeholder: "8501 · moteurs · 2201", sample: "Télécharger l’échantillon CSV (100 lignes)", columns: ["Numéro", "Désignation", "Droit de base (résumé)", "Lignes de taux", "Valable depuis"], region: "Échantillon TARES. Faites défiler le tableau pour voir toutes les colonnes.", waiting: "Lecture de l’échantillon publié…", unavailable: "L’échantillon ne peut pas être lu pour le moment. Le téléchargement CSV reste disponible.", empty: "Aucun numéro de cet échantillon ne correspond.", shown: "lignes affichées sur", total: "dans l’échantillon", noMfn: "— voir le détail", unitNote: "Faites défiler le tableau pour voir toutes les colonnes. Unités telles que livrées dans le champ duty_mfn_unit (en français) ; une ligne sans résumé n’est pas une franchise.", nojs: "L’aperçu interactif nécessite JavaScript. L’échantillon CSV contient les mêmes cent lignes." },
 de: { search: "Nach Nummer oder Bezeichnung filtern", placeholder: "8501 · Motoren · 2201", sample: "CSV-Muster herunterladen (100 Zeilen)", columns: ["Nummer", "Bezeichnung", "Normalansatz (Zusammenfassung)", "Tarifzeilen", "Gültig ab"], region: "TARES-Muster. Scrollen Sie die Tabelle, um alle Spalten zu sehen.", waiting: "Veröffentlichtes Muster wird gelesen…", unavailable: "Das Muster kann derzeit nicht gelesen werden. Der CSV-Download bleibt verfügbar.", empty: "Keine Nummer in diesem Muster passt.", shown: "Zeilen angezeigt von", total: "im Muster", noMfn: "— siehe Detail", unitNote: "Scrollen Sie die Tabelle, um alle Spalten zu sehen. Einheiten wie im Feld unit_stat geliefert (auf Englisch); eine Zeile ohne Zusammenfassung bedeutet keine Zollfreiheit.", nojs: "Die interaktive Vorschau benötigt JavaScript. Das CSV-Muster enthält dieselben hundert Zeilen." },
 en: { search: "Filter by number or description", placeholder: "8501 · motors · 2201", sample: "Download the CSV sample (100 rows)", columns: ["Number", "Description", "Base duty (summary)", "Rate rows", "Valid from"], region: "TARES sample. Scroll the table to see all columns.", waiting: "Reading the published sample…", unavailable: "The sample cannot be read at the moment. The CSV download remains available.", empty: "No number in this sample matches.", shown: "rows shown out of", total: "in the sample", noMfn: "— see the detail", unitNote: "Scroll the table to see all columns. Units as delivered in the unit_stat field; a line without a summary does not mean duty-free.", nojs: "The interactive preview requires JavaScript. The CSV sample contains the same hundred lines." },
}[lang];
---
<div class="atlas-preview fiche-explorer" data-tares-explorer data-lang={lang} data-copy={JSON.stringify(text)}>
 <div class="atlas-preview-tools">
  <div class="atlas-search-wrap"><label for="tares-search">{text.search}</label><input type="search" id="tares-search" placeholder={text.placeholder} autocomplete="off" spellcheck="false" disabled /></div>
  <a href="/api/catalog/tares?format=csv" class="atlas-text-link">{text.sample} ↓</a>
 </div>
 <div class="atlas-table-scroll" tabindex="0" role="region" aria-label={text.region}>
  <table class="atlas-table fiche-tares-table"><thead><tr>{text.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody data-tares-rows></tbody></table>
 </div>
 <p class="atlas-preview-status" data-tares-status role="status">{text.waiting}</p>
 <noscript class="atlas-noscript">{text.nojs}</noscript>
</div>
<p class="atlas-live-note">{text.unitNote}</p>
<script>
 import '../scripts/tares-explorer';
</script>
