---
import { Image } from 'astro:assets';
import atlas from '../assets/art/swiss-atlas-pixels-v1.png';
import { getLangFromPath } from '../i18n/utils';
const lang = getLangFromPath(Astro.url.pathname);
const copy = {
 fr: { source: 'Illustration artistique', note: 'Illustration créée avec ChatGPT. Le relief et les pixels verts évoquent la Suisse et ses données : ils ne représentent ni des altitudes exactes, ni la géologie, ni une couverture réseau mesurée.', pause: 'Réduire les animations', title: 'La Suisse en relief' },
 de: { source: 'Künstlerische Illustration', note: 'Mit ChatGPT erstellte Illustration. Relief und grüne Pixel stehen sinnbildlich für die Schweiz und ihre Daten. Sie zeigen weder exakte Höhen noch die Geologie oder eine gemessene Netzabdeckung.', pause: 'Animationen reduzieren', title: 'Die Schweiz als Relief' },
 en: { source: 'Artistic illustration', note: 'Illustration created with ChatGPT. The relief and green pixels evoke Switzerland and its data. They do not represent exact elevations, geology or measured network coverage.', pause: 'Reduce animations', title: 'Switzerland in relief' },
}[lang];
---
<div class="atlas-artwork" data-atlas-art>
 <div class="atlas-art-meta" aria-hidden="true"><span>CH / DATA ATLAS</span><span>{copy.title}</span></div>
 <div class="atlas-art-plane" aria-hidden="true">
  <Image src={atlas} alt="" widths={[400,700,1000,1400]} sizes="(max-width: 600px) 100vw, (max-width: 980px) 620px, (max-width: 1376px) 62vw, 800px" format="webp" quality={90} loading="eager" fetchpriority="high" draggable="false" class="atlas-art-image" />
 </div>
 <div class="atlas-art-bottom">
  <details class="atlas-art-source"><summary>{copy.source}</summary><div><p>{copy.note}</p></div></details>
  <button type="button" class="atlas-motion" data-atlas-motion aria-pressed="false" hidden><span class="atlas-pause-icon" aria-hidden="true">Ⅱ</span><span>{copy.pause}</span></button>
 </div>
</div>
