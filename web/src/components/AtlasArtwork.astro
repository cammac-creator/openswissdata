---
import { Image } from 'astro:assets';
import atlas from '../assets/art/swiss-atlas-editorial-v3.png';
import modelUrl from '../assets/art/swiss-atlas-v2.bin?url';
import { getLangFromPath } from '../i18n/utils';
const { compact = false } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const copy = {
 fr: { illustration: 'Illustration', artSource: 'Illustration artistique', artNote: 'Illustration créée avec ChatGPT, inspirée d’une sculpture de la Suisse. Relief et couleurs sont imaginés : ils ne représentent pas la géologie réelle. Le mode 3D séparé s’appuie sur des données topographiques.', archive: 'Fichiers documentés', pause: 'Réduire les animations', title: 'La Suisse en relief', hint: 'Faites glisser pour tourner', touch: 'Manipuler', release: 'Terminer', back: 'Voir le dos', reset: 'Vue initiale', start: 'Explorer en 3D', loading: 'Préparation du relief…', ready: 'Relief prêt. Faites glisser ou utilisez les flèches du clavier.', error: 'La vue 3D est indisponible. L’illustration reste visible.', label: 'Relief suisse en 3D. Flèches pour tourner, touche Origine pour revenir à la vue initiale.', about: 'Relief ×8 · ©swisstopo', source: 'Relief issu du MNT25, contour swissBOUNDARIES3D 2026. Altitudes multipliées par 8, géométrie simplifiée. Ivoire, vert et rouge sont des choix graphiques, sans signification géologique.', link: 'Les données du relief', backState: 'Dos de la carte : Made in Switzerland.', frontState: 'Vue initiale du relief.' },
 de: { illustration: 'Illustration', artSource: 'Künstlerische Illustration', artNote: 'Mit ChatGPT erstellte Illustration, inspiriert von einer Skulptur der Schweiz. Relief und Farben sind frei gestaltet und zeigen keine tatsächliche Geologie. Die separate 3D-Ansicht basiert auf topografischen Daten.', archive: 'Dokumentierte Dateien', pause: 'Animationen reduzieren', title: 'Die Schweiz als Relief', hint: 'Zum Drehen ziehen', touch: 'Bewegen', release: 'Fertig', back: 'Rückseite', reset: 'Ausgangsansicht', start: 'In 3D erkunden', loading: 'Relief wird vorbereitet…', ready: 'Relief bereit. Ziehen oder die Pfeiltasten verwenden.', error: 'Die 3D-Ansicht ist nicht verfügbar. Die Illustration bleibt sichtbar.', label: 'Schweizer Relief in 3D. Pfeiltasten zum Drehen, Pos1 für die Ausgangsansicht.', about: 'Relief ×8 · ©swisstopo', source: 'Relief aus dem DHM25, Umriss swissBOUNDARIES3D 2026. Höhen achtfach verstärkt, Geometrie vereinfacht. Elfenbein, Grün und Rot sind gestalterische Farben ohne geologische Bedeutung.', link: 'Die Daten des Reliefs', backState: 'Rückseite der Karte: Made in Switzerland.', frontState: 'Ausgangsansicht des Reliefs.' },
 en: { illustration: 'Illustration', artSource: 'Artistic illustration', artNote: 'Illustration created with ChatGPT, inspired by a sculpture of Switzerland. Terrain and colours are imagined and do not represent real geology. The separate 3D view uses topographic data.', archive: 'Documented files', pause: 'Reduce animations', title: 'Switzerland in relief', hint: 'Drag to rotate', touch: 'Interact', release: 'Done', back: 'See the reverse', reset: 'Reset view', start: 'Explore in 3D', loading: 'Preparing the relief…', ready: 'Relief ready. Drag or use the arrow keys.', error: 'The 3D view is unavailable. The illustration remains visible.', label: 'Swiss relief in 3D. Arrow keys to rotate, Home to reset the view.', about: 'Relief ×8 · ©swisstopo', source: 'Terrain from DHM25, outline from swissBOUNDARIES3D 2026. Elevations exaggerated eightfold, geometry simplified. Ivory, green and red are artistic choices with no geological meaning.', link: 'Terrain data', backState: 'Reverse of the map: Made in Switzerland.', frontState: 'Initial relief view.' },
}[lang];
---
<div class:list={['atlas-artwork', 'atlas-relief', { 'atlas-artwork-compact': compact }]} data-atlas-art data-model-url={modelUrl} data-relief-state="poster" data-loading={copy.loading} data-ready={copy.ready} data-error={copy.error} data-back-state={copy.backState} data-front-state={copy.frontState} data-art-state={copy.artSource}>
 <div class="atlas-art-meta" aria-hidden="true"><span>CH / DATA ATLAS</span><span>{copy.title}</span></div>
 <div class="atlas-art-plane" aria-hidden="true"><Image src={atlas} alt="" widths={[400,700,1000,1400]} sizes="(max-width: 760px) 100vw, 55vw" format="webp" quality={85} loading="eager" fetchpriority="high" class="atlas-art-image" /></div>
 <div class="atlas-relief-stage" data-relief-stage role="group" aria-label={copy.label} tabindex="0" hidden></div>
 <span class="atlas-relief-hint" data-relief-hint hidden aria-hidden="true">↔ {copy.hint}</span>
 <div class="atlas-file-float"><span class="atlas-file-glyph" aria-hidden="true">↳</span><div><strong>{copy.archive}</strong><span>CSV / JSON / PARQUET / SQL</span></div><span class="atlas-file-plus" aria-hidden="true">+</span></div>
 <div class="atlas-relief-controls">
  <button type="button" class="atlas-relief-start" data-relief-start hidden>{copy.start}<span aria-hidden="true"> ↗</span></button>
  <div class="atlas-relief-actions" data-relief-actions hidden>
   <button type="button" data-relief-poster>{copy.illustration}<span aria-hidden="true"> ↖</span></button>
   <button type="button" data-relief-touch aria-pressed="false" data-label-on={copy.release} data-label-off={copy.touch}>{copy.touch}</button>
   <button type="button" data-relief-back>{copy.back}<span aria-hidden="true"> ↶</span></button>
   <button type="button" data-relief-reset>{copy.reset}</button>
  </div>
 </div>
 <div class="atlas-art-bottom">
  <details class="atlas-relief-source"><summary><span data-source-art>{copy.artSource}</span><span data-source-model>{copy.about}</span></summary><div><p data-source-art>{copy.artNote}</p><p>{copy.source}</p><a href="https://www.swisstopo.admin.ch/fr/modele-altimetrique-mnt25" target="_blank" rel="noopener noreferrer">{copy.link} ↗</a></div></details>
  <button type="button" class="atlas-motion" data-atlas-motion aria-pressed="false" hidden><span class="atlas-pause-icon" aria-hidden="true">Ⅱ</span><span>{copy.pause}</span></button>
 </div>
 <p class="sr-only" role="status" aria-live="polite" data-relief-status></p>
</div>
<script>
 import '../scripts/atlas-relief';
</script>
