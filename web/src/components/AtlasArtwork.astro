---
import { Image } from 'astro:assets';
import atlas from '../assets/art/swiss-atlas-editorial-v3.png';
import { getLangFromPath } from '../i18n/utils';
const lang = getLangFromPath(Astro.url.pathname);
const copy = {
 fr: { source: 'Illustration artistique', note: 'Illustration créée avec ChatGPT, inspirée d’une sculpture de la Suisse. Le relief et les couleurs sont imaginés : ils ne représentent ni les altitudes ni la géologie réelles.', pause: 'Réduire les animations', title: 'La Suisse en relief' },
 de: { source: 'Künstlerische Illustration', note: 'Mit ChatGPT erstellte Illustration, inspiriert von einer Skulptur der Schweiz. Relief und Farben sind frei gestaltet: Sie zeigen weder die tatsächlichen Höhen noch die Geologie.', pause: 'Animationen reduzieren', title: 'Die Schweiz als Relief' },
 en: { source: 'Artistic illustration', note: 'Illustration created with ChatGPT, inspired by a sculpture of Switzerland. Terrain and colours are imagined: they do not represent actual elevations or geology.', pause: 'Reduce animations', title: 'Switzerland in relief' },
}[lang];
---
<div class="atlas-artwork" data-atlas-art>
 <div class="atlas-art-meta" aria-hidden="true"><span>CH / DATA ATLAS</span><span>{copy.title}</span></div>
 <div class="atlas-art-plane" aria-hidden="true">
  <Image src={atlas} alt="" widths={[400,700,1000,1400]} sizes="(max-width: 600px) 100vw, (max-width: 980px) 620px, (max-width: 1376px) 62vw, 800px" format="webp" quality={90} loading="eager" fetchpriority="high" draggable="false" class="atlas-art-image" />
 </div>
 <div class="atlas-art-bottom">
  <details class="atlas-art-source"><summary>{copy.source}</summary><div><p>{copy.note}</p></div></details>
  <button type="button" class="atlas-motion" data-atlas-motion aria-pressed="false" hidden><span class="atlas-pause-icon" aria-hidden="true">Ⅱ</span><span>{copy.pause}</span></button>
 </div>
</div>
