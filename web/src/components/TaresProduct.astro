   ["Summary", "One line per tariff number", ["tares.csv", "tares.json", "tares.parquet", "tares.sql"]],
   ["Rate detail", "Every row in force and its source cells", ["tares_rates.csv", "tares_rates.json"]],
   ["Checks", "Observed changes and provenance of the seven sources", ["quality.json", "sources.json"]],
   ["Proofs and guide", "Ed25519 signature, RFC-3161 timestamp and checksums", ["provenance.json", "checksums.sha256", "README.md", "schema.json", "LICENSE.txt"]]],
  archiveNotes: ["The legacy unit_stat field remains an old alias of the duty unit, not a separate statistical unit.", "Search vectors are not included in this update.", "Checksums in provenance.json refer to the files in the archive, not to the ZIP that contains them."],
  mcpTitle: "Just a quick lookup?", mcpText: "The MCP server’s tariff_lookup tool answers without an account, within 100 calls per hour. Buying the file does not open any paid MCP access.", mcpLink: "Try the MCP server",
  faqKicker: "05 / Frequently asked", faqTitle: "Before buying TARES.", faq: [
   ["Can I calculate a customs duty amount?", "Not directly. The file reproduces published rates with their units and conditions; it replaces neither the customs declaration nor the origin check. A percentage rate is never converted into francs."],
   ["Is the data official?", "No. It is independently prepared from the files published by the FOCBS. Only the publications of the Federal Chancellery and the FOCBS are authoritative."],
   ["How are the files delivered?", "Once Stripe confirms the payment, an email opens your download page. The files remain available in your account."],
   ["What happens after 360 days?", `You keep the versions you received. An optional extension costs CHF ${offer.renewal} per year; there is no automatic renewal.`],
   ["What if the file does not suit me?", "You may request a full refund within 14 days of purchase without giving a reason, unless the files have been redistributed to a third party in breach of the licence. The sales terms prevail."]],
  terms: "Sales terms",
  purchaseKicker: "Your next data foundation", delivery: "Your files. Your workflow.", serviceText: "After payment, download your archive from the delivery email or your account. Your Stripe receipt is also available there. For an invoice addressed to your company, send us its legal name and billing address.",
  contact: "Contact support", account: "Your account", price: "One-time payment", updates: `360 days of updates included. Optional extension: CHF ${offer.renewal}/year.`,
  bundle: `All three files together: CHF ${BUNDLE_OFFER.price}, or CHF ${BUNDLE_SAVING} less than separate purchases.`, bundleLink: "View the bundle", independent: "Independent private service, not affiliated with the FOCBS.",
 },
}[lang];
const digits = example.hs8.split("");
const otherLangs = (["fr", "de", "it", "en"] as const).filter(code => code !== lang);
const live = { lang, waiting: copy.waiting, unavailable: copy.unavailable, checked: copy.checked, compared: copy.compared, noMfn: copy.noMfn, prefCount: copy.prefCount, prefNote: copy.prefNote, free: copy.free, liveLine: copy.liveLine, detailCount: copy.detailCount };
---
<AtlasLayout title={`${copy.title} | openswissdata`} description={copy.description} image="/og-tares.png" datasetJsonLd={datasetJsonLd("tares", lang, copy.description)} productJsonLd={productJsonLd("tares", lang, { name: copy.title, description: copy.description, image: "/og-tares.png" })}>
<div class="atlas-product-site fiche" data-tares-product data-copy={JSON.stringify(live)}>
 <div class="atlas-shell atlas-breadcrumb"><a href={`${L("/")}#datasets`}>{copy.catalogue}</a><span aria-hidden="true">/</span><span>TARES</span></div>
 <section class="atlas-hero atlas-product-hero"><div class="atlas-shell atlas-hero-grid"><div class="atlas-hero-copy" data-atlas-enter><p class="atlas-kicker">{copy.eyebrow}</p><h1>{copy.hero}<br/><em>{copy.accent}</em></h1><p class="atlas-lede">{copy.intro}</p><div class="atlas-actions"><a href="#lecture" class="atlas-btn">{copy.read}<span aria-hidden="true">↓</span></a><a href="#acheter" class="atlas-text-link">{copy.buy} · {offer.price} CHF ↗</a></div><div class="atlas-hero-footnote"><span>CSV · JSON · Parquet · SQL</span><span>Ed25519 · SHA-256</span></div></div><AtlasArtwork /></div></section>
 <div class="atlas-product-nav"><nav class="atlas-shell atlas-product-nav-inner" aria-label={copy.navLabel}><div class="atlas-product-nav-links"><a href="#lecture">{copy.navRead}</a><a href="#apercu">{copy.navPreview}</a><a href="#conditions">{copy.navConditions}</a></div><a class="atlas-nav-buy" href="#acheter">{copy.buy}<span>{offer.price} CHF ↗</span></a></nav></div>
 <div class="atlas-shell"><div class="atlas-quality"><div class="atlas-quality-heading"><p class="atlas-kicker">{copy.status}</p><p class="fiche-version" data-tares-version role="status">{copy.waiting}</p></div><div class="atlas-quality-grid">{[["rows", copy.statRows], ["rates", copy.statRates], ["missing", copy.statMissing], ["changes", copy.statChanges]].map(([key, label]) => <div><strong data-tares-count={key}>—</strong><span>{label}</span></div>)}</div><noscript class="atlas-noscript">{copy.nojs}</noscript></div></div>

 <section class="atlas-section" id="lecture"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.readKicker}</p><h2>{copy.readTitle}</h2></div><p class="atlas-section-intro">{copy.readIntro}</p></div>
  <div class="fiche-anatomy-grid">
   <figure class="fiche-plate" data-atlas-enter>
    <div class="fiche-plate-meta" aria-hidden="true"><span>{copy.plate}</span><span>{copy.plateDigits}</span></div>
    <div class="fiche-code" data-tares-anatomy>
     <div class="fiche-code-digits" role="img" aria-label={`${copy.levels[3][0]} ${copy.levels[3][1]}`}>{digits.map((digit, index) => <><span class:list={["fiche-tile", { "is-swiss": index > 5 }]} aria-hidden="true">{digit}</span>{index === 3 && <span class="fiche-code-dot" aria-hidden="true">.</span>}</>)}</div>
     <ol class="fiche-code-levels">{copy.levels.map(([label, code, field], index) => <li class={`fiche-level fiche-level-${index + 1}`}><span class="fiche-level-line" aria-hidden="true"></span><span class="fiche-level-text"><strong>{label}</strong> <span class="fiche-level-code">{code}</span> <code>{field}</code></span></li>)}</ol>
    </div>
    <div class="fiche-designation">
     <p class="fiche-mini">{copy.designation} · <code>designation_{lang}</code></p>
     <p class="fiche-designation-main" lang={lang}>{example.designations[lang]}</p>
     <ul class="fiche-designation-others">{otherLangs.map(code => <li lang={code}><span>{code.toUpperCase()}</span>{example.designations[code]}</li>)}</ul>
    </div>
    <figcaption class="fiche-plate-caption">{copy.source}</figcaption>
   </figure>
   <aside class="fiche-quota" data-atlas-enter>
    <h3>{copy.quotaTitle}</h3>
    <p>{copy.quotaIntro}</p>
    <ol class="fiche-tree">
     <li class="fiche-tree-1"><span class="fiche-quota-code">01</span><span class="fiche-tree-label">{copy.levels[0][0]}</span></li>
     <li class="fiche-tree-2"><span class="fiche-quota-code">01.01</span><span class="fiche-tree-label">{copy.levels[1][0]}</span></li>
     <li class="fiche-tree-3"><span class="fiche-quota-code">0101.21</span><span class="fiche-tree-label">{copy.levels[2][0]}</span></li>
     <li class="fiche-tree-4"><span class="fiche-quota-code">0101.21<b>10</b></span><span lang={lang}>{quota[0]}</span></li>
     <li class="fiche-tree-4"><span class="fiche-quota-code">0101.21<b>90</b></span><span lang={lang}>{quota[1]}</span></li>
    </ol>
    <p class="fiche-note">{copy.quotaNote}</p>
   </aside>
  </div>
  <div class="fiche-reader" data-atlas-enter>
   <div class="fiche-reader-head"><div><h3>{copy.readerTitle}</h3><p>{copy.readerIntro}</p></div><button type="button" class="atlas-btn atlas-btn-secondary fiche-reader-next" data-tares-next hidden>{copy.another}<span aria-hidden="true">↻</span></button></div>
   <div class="fiche-reader-grid">
    <div class="fiche-card fiche-summary">
     <div class="fiche-card-title"><strong>{copy.summary}</strong><span>{copy.summaryFile}</span></div>
     <dl class="fiche-fields">{copy.fields.map(([field, label]) => <div><dt><code>{field}</code><span>{label}</span></dt><dd data-tares-field={field}>—</dd></div>)}</dl>
     <p class="fiche-live-line" data-tares-live role="status"></p>
     <a class="atlas-text-link fiche-verify" data-tares-source href="https://xtares.admin.ch/" rel="noopener">{copy.verify} ↗</a>
    </div>
    <div class="fiche-card fiche-detail">
     <div class="fiche-card-title"><strong>{copy.detail}</strong><span>{copy.detailFile}</span></div>
     <div class="fiche-rate-stack" data-tares-stack aria-hidden="true">{Array.from({ length: 8 }, (_, index) => <span class:list={{ "is-percent": index === 5 }}></span>)}</div>
     <p class="fiche-rate-count"><strong data-tares-rate-count>—</strong> <span>{copy.detailCount}</span></p>
     <ul class="fiche-detail-columns">{copy.detailColumns.map(column => <li>{column}</li>)}</ul>
     <p class="fiche-percent"><span aria-hidden="true">%</span>{copy.percent}</p>
    </div>
   </div>
  </div>
 </div></section>

 <section class="atlas-section atlas-method" id="apercu"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.previewKicker}</p><h2>{copy.previewTitle}</h2></div><p class="atlas-section-intro">{copy.previewIntro}</p></div>
  <slot />
 </div></section>

 <section class="atlas-section" id="conditions"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.conditionsKicker}</p><h2>{copy.conditionsTitle}</h2></div></div>
  <div class="fiche-conditions">{copy.conditions.map(([glyph, title, text]) => <article class="fiche-condition" data-atlas-enter><span class="fiche-glyph" aria-hidden="true">{glyph}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  <div class="fiche-official" data-atlas-enter>
   <p class="fiche-official-langs"><span lang="fr">Non officiel</span><span lang="de">Nicht offiziell</span><span lang="it">Non ufficiale</span><span lang="en">Not official</span></p>
   <div><h3>{copy.officialTitle}</h3><p>{copy.official}</p><p lang="de" class="fiche-official-quote">«&nbsp;Dies ist keine offizielle Veröffentlichung.&nbsp;»</p><p class="fiche-note">{copy.permission}</p><a class="atlas-text-link" href="https://xtares.admin.ch/" rel="noopener">{copy.officialLink} ↗</a></div>
  </div>
 </div></section>

 <section class="atlas-section atlas-method" id="archive"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.archiveKicker}</p><h2>{copy.archiveTitle}</h2></div><p class="atlas-section-intro">{copy.archiveIntro}</p></div>
  <div class="fiche-archive">
   <div class="fiche-window" data-atlas-enter>
    <div class="atlas-window-title"><span>{copy.archiveWindow}</span><span aria-hidden="true">ZIP</span></div>
    <div class="fiche-window-body">{copy.groups.map(([title, text, files]) => <div class="fiche-file-group"><div><strong>{title}</strong><small>{text}</small></div><ul>{(files as string[]).map(file => <li><code>{file}</code></li>)}</ul></div>)}</div>
   </div>
   <div class="fiche-archive-side" data-atlas-enter>
    <ul class="atlas-limits">{copy.archiveNotes.map(note => <li>{note}</li>)}</ul>
    <div class="fiche-mcp"><p class="atlas-kicker">MCP · tariff_lookup</p><h3>{copy.mcpTitle}</h3><p>{copy.mcpText}</p><a class="atlas-text-link" href={`${L("/mcp")}#install`}>{copy.mcpLink} ↗</a></div>
   </div>
  </div>
 </div></section>

 <section class="atlas-section atlas-faq"><div class="atlas-shell atlas-faq-grid"><div data-atlas-enter><p class="atlas-kicker">{copy.faqKicker}</p><h2 class="atlas-section-title">{copy.faqTitle}</h2><a href={L("/legal/cgv")} class="atlas-text-link">{copy.terms} ↗</a></div><div>{copy.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

 <section class="atlas-shell" id="acheter"><div class="atlas-purchase" data-atlas-enter><div><p class="atlas-kicker">{copy.purchaseKicker}</p><h2>{copy.delivery}</h2><p>{copy.serviceText}</p><div class="atlas-actions"><a href="mailto:contact@openswissdata.com" class="atlas-text-link">{copy.contact} ↗</a><a href={L("/account")} class="atlas-text-link">{copy.account} ↗</a></div></div><div class="atlas-purchase-box"><p>TARES · {copy.price}</p><div class="atlas-purchase-price"><strong>{offer.price}</strong><span>CHF</span></div><p>{copy.updates}</p><form method="POST" action="/api/checkout/start"><input type="hidden" name="locale" value={lang}/><input type="hidden" name="dataset_ids" value="tares"/><button class="atlas-btn" type="submit">{copy.buyTares}<span aria-hidden="true">↗</span></button></form><CheckoutNotice /></div></div><p class="fiche-bundle-line">{copy.bundle} <a href={L("/bundle")}>{copy.bundleLink} ↗</a></p><p class="atlas-live-note">{copy.independent}</p></section>
</div>
<script>
 import '../scripts/tares-product';
</script>
</AtlasLayout>
