---
import { neighborsOfType, type FinmaEntity } from "../lib/finma-helpers";
import { FINMA_STR, typeLabel, licenceFor, typeExplain } from "../lib/finma-i18n";
import { localizePath, type Lang } from "../i18n/utils";

interface Props { entity: FinmaEntity; lang: Lang; }
const { entity, lang } = Astro.props as Props;

const S = FINMA_STR[lang];
const tLabel = typeLabel(entity.type, lang);
const licence = licenceFor(entity, lang);
const homeHref = localizePath("/", lang);
const registryHref = localizePath("/finma/", lang);
const entHref = (slug: string) => localizePath(`/finma/${slug}`, lang);
const mcpHref = localizePath("/mcp#install", lang);
const officialUrl = entity.src || "https://www.finma.ch/en/finma-public/authorised-institutions-individuals-and-products/";

const fields: Array<{ label: string; value: string; mono?: boolean }> = [
  { label: S.fType, value: tLabel },
  { label: S.fLicence, value: licence },
  { label: S.fCity, value: entity.city },
  { label: S.fUid, value: entity.uid, mono: true },
  { label: S.fLei, value: entity.lei, mono: true },
  { label: S.fDate, value: entity.date, mono: true },
].filter((f) => f.value && f.value.trim() !== "");

const neighbors = neighborsOfType(entity, 10);

const ORIGIN = "https://www.openswissdata.com";
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: S.bcHome, item: `${ORIGIN}${homeHref}` },
    { "@type": "ListItem", position: 2, name: S.bcRegistry, item: `${ORIGIN}${registryHref}` },
    { "@type": "ListItem", position: 3, name: entity.name, item: `${ORIGIN}${entHref(entity.slug)}` },
  ],
};
---
<div class="bg-grid"></div>
<section class="v4-hero ds-page">
  <div class="container-v4">
    <nav class="ds-breadcrumb">
      <a href={homeHref}>{S.bcHome}</a>
      <span class="sep">·</span>
      <a href={registryHref}>{S.bcRegistry}</a>
      <span class="sep">·</span>
      <span class="current">{entity.name}</span>
    </nav>
    <div class="v4-hero-grid">
      <div>
        <div class="v4-eyebrow reveal-v4">
          <span>{S.eyebrow}</span>
          <span style="opacity:.4">·</span>
          <span>{tLabel}</span>
        </div>
        <h1 class="v4-h1 reveal-v4" data-delay="1">{entity.name}</h1>
        <p class="v4-lede reveal-v4" data-delay="2" set:html={S.ledeAuthorized(entity.name)} />
      </div>
      <div class="ds-price-box reveal-v4" data-delay="2">
        <div class="ds-price-box-label">{S.fType}</div>
        <div class="ds-price-box-amount" style="font-size: 22px;">{tLabel}</div>
        {entity.city && <div class="ds-price-box-renew">{S.fCity} : {entity.city}</div>}
      </div>
    </div>
  </div>
</section>

<section class="v4-datasets ds-page">
  <div class="container-v4">
    <section class="ds-section reveal">
      <h2 class="ds-section-title">{S.detailsTitle} <span class="serif">{S.detailsEm}</span></h2>
      <div class="ds-table-wrap">
        <table class="ds-table">
          <thead><tr><th>{S.thField}</th><th>{S.thValue}</th></tr></thead>
          <tbody>
            <tr><td><strong>{S.fName}</strong></td><td>{entity.name}</td></tr>
            {fields.map((f) => (
              <tr><td>{f.label}</td><td class={f.mono ? "mono" : "dim"}>{f.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="ds-section reveal">
      <h2 class="ds-section-title">{S.meansTitle} <span class="serif">{S.meansEm}</span></h2>
      <p class="ds-section-intro">{typeExplain(entity.type, lang)}</p>
    </section>

    <section class="ds-section reveal">
      <h2 class="ds-section-title">{S.verifyTitle} <span class="serif">{S.verifyEm}</span></h2>
      <p class="ds-section-intro">{S.verifyIntro}</p>
      <p style="font-size:15px;line-height:1.6;">
        <a href={officialUrl} target="_blank" rel="noopener">{S.verifyCta} — finma.ch</a>
      </p>
    </section>

    <section class="ds-section reveal">
      <h2 class="ds-section-title">{S.mcpCtaTitle} <span class="serif">{S.mcpCtaEm}</span></h2>
      <p class="ds-section-intro">{S.mcpCtaIntro}</p>
      <a href={mcpHref} style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; background: var(--color-ink); color: var(--color-bg); border-radius: 10px; text-decoration: none; font-weight: 500; font-size: 15px;">
        {S.mcpCtaButton}
        <span style="opacity:.7;">→</span>
      </a>
    </section>

    {neighbors.length > 0 && (
      <section class="ds-section reveal">
        <h2 class="ds-section-title">{S.neighborsTitle(tLabel)} <span class="serif">{S.neighborsEm}</span></h2>
        <div class="ds-table-wrap">
          <table class="ds-table">
            <tbody>
              {neighbors.map((n) => (
                <tr>
                  <td><a href={entHref(n.slug)}>{n.name}</a></td>
                  <td class="dim">{n.city}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ds-section-note"><a href={registryHref}>{S.bcRegistry} →</a></p>
      </section>
    )}

    <footer style="margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--color-line); font-size: 12px; line-height: 1.6; color: var(--color-ink-mute);">
      {S.footer}
    </footer>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
