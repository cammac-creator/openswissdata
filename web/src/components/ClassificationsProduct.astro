  tableTitle: "The five classifications", tableColumns: ["Classification", "Languages", "Codes · classes"],
  previewKicker: "03 / Explore before you buy", previewTitle: "Check a mapping. Read real rows.", previewIntro: "The checker queries the same sourced reference as the MCP server. The sample shows ten rows from each classification, taken from the distributed version.",
  viewerTitle: "Ten rows per classification", viewerLabel: "Choose a classification", columns: ["Code", "Label", "Level", "Parent"], viewerRegion: "Classifications sample. Scroll the table to see all columns.", viewerNote: "Keep leading zeros in codes.", sample: "Download the CSV sample (50 rows)", viewerEmpty: "No row from this classification in the sample.", viewerNojs: "The interactive preview requires JavaScript. The CSV sample contains the same fifty rows.", isicLabel: "",
  levelLabels: { section: "Section", division: "Division", group: "Group", class: "Class", subclass: "Subclass" },
  archiveKicker: "04 / Inside your archive, and its limits", archiveTitle: "Tables, their links, their sources.", archiveWindow: "CLASSIFICATIONS / ARCHIVE", groups: [
   ["Classifications", "One table per classification, also in JSON and SQL, and all together in Parquet", ["noga_2008.csv", "noga_2025.csv", "nace_2_0.csv", "nace_2_1.csv", "isic_4.csv", "nomenclatures.parquet"]],
   ["Mappings", "One pair per row, with direction, relation and source", ["classification_links.csv", "classification_links.json", "classification_links.sql", "classification_links.parquet"]],
   ["Legacy format", "Kept, now one pair per row", ["crosswalks.csv", "crosswalks.json", "crosswalks.sql", "crosswalks.parquet"]],
   ["Sources and checks", "URLs, SHA-256 checksums, collection dates and volumes", ["sources.json", "classification_sources.csv", "quality.json"]],
   ["Proofs and guide", "Ed25519 signature, RFC-3161 timestamp and checksums", ["provenance.json", "checksums.sha256", "README.md", "schema.json", "LICENSE.txt"]]],
  limits: [
   "An approximation is not an equivalence: review the activity before migrating a code.",
   "Two approximations are not chained. A missing link does not prove that no equivalent exists.",
   "Migrating a six-digit Swiss subclass between NOGA 2008 and NOGA 2025 requires a dedicated table.",
   "Languages: NOGA and NACE in French, German, Italian and English; ISIC in French, English and Spanish, with no official German or Italian labels in this file.",
   "Schema 2: mappings are described by pair, with source and direction. Existing five-column joins need to be updated.",
   "Conditions of the FSO, Eurostat and UN sources remain applicable: purchasing does not grant blanket permission to redistribute those sources."],
  provenance: "Provenance and source rights",
  pro: "Classifications Pro is temporarily unavailable while its add-ons are being verified. The Standard archive includes neither multilingual vectors nor NAICS mappings.",
  mcpTitle: "Just a quick lookup?", mcpText: "The MCP server’s cross_walk tool answers without an account, within 100 calls per hour; the other classification tools require access rights. Buying the file does not open any paid MCP access.", mcpLink: "Try the MCP server",
  faqKicker: "05 / Frequently asked", faqTitle: "Before buying the classifications.", faq: [
   ["Can I convert NOGA 2008 to NOGA 2025 automatically?", "Only where the relation allows it. At levels 1 to 4 the path goes through NACE and includes a Eurostat approximation to review. Six-digit subclasses require a dedicated table."],
   ["Are the labels official?", "They come from FSO, Eurostat and UN publications and are prepared independently. OpenSwissData is not affiliated with any of these institutions; their publications prevail."],
   ["How are the files delivered?", "Once Stripe confirms the payment, an email opens your download page. The files remain available in your account."],
   ["What happens after 360 days?", `You keep the versions you received. An optional extension costs CHF ${offer.renewal} per year; there is no automatic renewal.`],
   ["What if the file does not suit me?", "You may request a full refund within 14 days of purchase without giving a reason, unless the files have been redistributed to a third party in breach of the licence. The sales terms prevail."]],
  terms: "Sales terms",
  purchaseKicker: "Your next data foundation", delivery: "Your files. Your workflow.", serviceText: "After payment, download your archive from the delivery email or your account. Your Stripe receipt is also available there. For an invoice addressed to your company, send us its legal name and billing address.",
  contact: "Contact support", account: "Your account", price: "Classifications Standard · One-time payment", updates: `360 days of updates included, published after the official sources have been checked. Optional extension: CHF ${offer.renewal}/year.`,
  bundle: `All three files together: CHF ${BUNDLE_OFFER.price}, or CHF ${BUNDLE_SAVING} less than separate purchases.`, bundleLink: "View the bundle", independent: "Independent private service, not affiliated with the FSO, Eurostat or the United Nations.",
 },
}[lang];
const rev = lang === "fr" ? "Rév." : "Rev.";
const schemes = [
 { id: "NOGA_2008", name: "NOGA 2008", issuer: lang === "fr" ? "OFS" : lang === "de" ? "BFS" : "FSO", region: copy.switzerland, languages: "FR · DE · IT · EN", area: "n08", tone: "ch" },
 { id: "NOGA_2025", name: "NOGA 2025", issuer: lang === "fr" ? "OFS" : lang === "de" ? "BFS" : "FSO", region: copy.switzerland, languages: "FR · DE · IT · EN", area: "n25", tone: "ch" },
 { id: "NACE_2.0", name: `NACE ${rev} 2`, issuer: "Eurostat", region: copy.europe, languages: "FR · DE · IT · EN", area: "n2", tone: "eu" },
 { id: "NACE_2.1", name: `NACE ${rev} 2.1`, issuer: "Eurostat", region: copy.europe, languages: "FR · DE · IT · EN", area: "n21", tone: "eu" },
 { id: "ISIC_4", name: `ISIC ${rev} 4`, issuer: lang === "fr" ? "ONU" : lang === "de" ? "UNO" : "UN", region: copy.world, languages: "FR · EN · ES", area: "isic", tone: "un" },
];
const standardNames: Record<string, string> = { "NACE 2.1": `NACE ${rev} 2.1`, "NACE 2.0": `NACE ${rev} 2`, "ISIC 4": `ISIC ${rev} 4`, "NOGA 2008": "NOGA 2008" };
const exampleLines = ["NACE 2.1", "NACE 2.0", "NOGA 2008"].flatMap(standard => exampleLinks.filter(link => link.standard === standard).map(link => ({ name: standardNames[standard], code: dottedCode(link.code), relation: copy.relationNames[link.relation], exact: link.relation === "exactMatch" })));
const hasIsic = exampleLinks.some(link => link.standard === "ISIC 4");
const ladder = ladderRows.map((row, index) => ({ code: dottedCode(row!.code), kind: copy.levelNames[index], text: label(row!), swiss: index === 4 }));
const live = { lang, rowsWord: { fr: "lignes", de: "Zeilen", en: "rows" }[lang], waiting: copy.waiting, unavailable: copy.unavailable, checked: copy.checked, codes: copy.codes, classes: copy.classes, columns: copy.columns, viewerEmpty: copy.viewerEmpty, isicLabel: copy.isicLabel, levelLabels: copy.levelLabels };
---
<AtlasLayout title={`${copy.title} | openswissdata`} description={copy.description} image="/og-classifications.png" datasetJsonLd={datasetJsonLd("classifications", lang, copy.description)} productJsonLd={productJsonLd("classifications", lang, { name: copy.title, description: copy.description, image: "/og-classifications.png" })}>
<div class="atlas-product-site fiche" data-class-product data-copy={JSON.stringify(live)}>
 <div class="atlas-shell atlas-breadcrumb"><a href={`${L("/")}#datasets`}>{copy.catalogue}</a><span aria-hidden="true">/</span><span>NOGA · NACE · ISIC</span></div>
 <section class="atlas-hero atlas-product-hero"><div class="atlas-shell atlas-hero-grid"><div class="atlas-hero-copy" data-atlas-enter><p class="atlas-kicker">{copy.eyebrow}</p><h1>{copy.hero}<br/><em>{copy.accent}</em></h1><p class="atlas-lede">{copy.intro}</p><div class="atlas-actions"><a href="#correspondances" class="atlas-btn">{copy.read}<span aria-hidden="true">↓</span></a><a href="#acheter" class="atlas-text-link">{copy.buy} · {offer.price} CHF ↗</a></div><div class="atlas-hero-footnote"><span>CSV · JSON · Parquet · SQL</span><span>Ed25519 · SHA-256</span></div></div><AtlasArtwork /></div></section>
 <div class="atlas-product-nav"><nav class="atlas-shell atlas-product-nav-inner" aria-label={copy.navLabel}><div class="atlas-product-nav-links"><a href="#correspondances">{copy.navMap}</a><a href="#niveaux">{copy.navLevels}</a><a href="#apercu">{copy.navPreview}</a></div><a class="atlas-nav-buy" href="#acheter">{copy.buy}<span>{offer.price} CHF ↗</span></a></nav></div>
 <div class="atlas-shell"><div class="atlas-quality"><div class="atlas-quality-heading"><p class="atlas-kicker">{copy.status}</p><p class="fiche-version" data-class-version role="status">{copy.waiting}</p></div><div class="atlas-quality-grid">{[["rows", copy.statRows], ["links", copy.statLinks], ["exact", copy.statExact], ["approximate", copy.statApprox]].map(([key, text]) => <div><strong data-class-count={key}>—</strong><span>{text}</span></div>)}</div><noscript class="atlas-noscript">{copy.nojs}</noscript></div></div>

 <section class="atlas-section" id="correspondances"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.mapKicker}</p><h2>{copy.mapTitle}</h2></div><p class="atlas-section-intro">{copy.mapIntro}</p></div>
  <div class="fiche-map-plate" data-atlas-enter>
   <div class="fiche-map" aria-hidden="true">
    {schemes.map(scheme => <div class={`fiche-node fiche-node-${scheme.tone} fiche-area-${scheme.area}`}><span class="fiche-node-issuer">{scheme.issuer} · {scheme.region}</span><strong>{scheme.name}</strong><span class="fiche-node-langs">{scheme.languages}</span><span class="fiche-node-count" data-scheme-count={scheme.id}>—</span></div>)}
    <div class="fiche-link fiche-link-exact fiche-area-e1"><span>{copy.exactLink}</span></div>
    <div class="fiche-link fiche-link-exact fiche-area-e2"><span>{copy.exactLink}</span></div>
    <div class="fiche-link fiche-link-approx fiche-area-a1"><span>{copy.approxLink}</span></div>
    <div class="fiche-link fiche-link-approx fiche-link-vertical fiche-area-v1"><span>{copy.approxLink}</span></div>
    <div class="fiche-link fiche-link-none fiche-area-x"><span>{copy.noChain}</span><b>×</b></div>
    <div class="fiche-node fiche-node-ghost fiche-area-ghost"><span class="fiche-node-issuer">× {copy.world}</span><strong>{copy.ghostTitle}</strong><span class="fiche-node-langs">{copy.ghostText}</span></div>
   </div>
   <ul class="fiche-legend">{copy.legend.map(([kind, text]) => <li><span class={`fiche-legend-mark fiche-legend-${kind}`} aria-hidden="true"></span>{text}</li>)}</ul>
  </div>
  <div class="fiche-map-text">
   <div class="fiche-relations" data-atlas-enter><h3>{copy.relationsTitle}</h3><ul class="atlas-limits">{copy.relations.map(item => <li>{item}</li>)}</ul></div>
   <article class="fiche-example" data-atlas-enter>
    <p class="atlas-kicker">{copy.exampleTitle}</p>
    <p class="fiche-example-from"><span>{copy.exampleFrom}</span><strong>{dottedCode(exampleRow.code)}</strong></p>
    <p class="fiche-example-label">{label(exampleRow)}</p>
    <ul class="fiche-example-links">{exampleLines.map(line => <li class:list={{ "is-exact": line.exact }}><span>{line.name}</span><strong>{line.code}</strong><em>{line.relation}</em></li>)}{!hasIsic && <li class="is-none"><span>{`ISIC ${rev} 4`}</span><strong>—</strong><em>{copy.noIsic}</em></li>}</ul>
    <p class="fiche-note">{copy.exampleRef}</p>
   </article>
  </div>
 </div></section>

 <section class="atlas-section atlas-method" id="niveaux"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.levelsKicker}</p><h2>{copy.levelsTitle}</h2></div><p class="atlas-section-intro">{copy.levelsIntro}</p></div>
  <div class="fiche-levels-grid">
   <figure class="fiche-ladder-card" data-atlas-enter>
    <ol class="fiche-ladder">{ladder.map((step, index) => <li class:list={[`fiche-step-${index + 1}`, { "is-swiss": step.swiss }]}><span class="fiche-step-code">{step.code}</span><span class="fiche-step-kind">{step.kind}</span><span class="fiche-step-text">{step.text}</span><span class="fiche-step-chip">{step.swiss ? copy.broaderNace : copy.sameAsNace}</span></li>)}</ol>
    <figcaption class="fiche-note">{copy.ladderCaption} · {referenceVersion}</figcaption>
   </figure>
   <div class="fiche-schemes" data-atlas-enter>
    <h3>{copy.tableTitle}</h3>
    <table class="fiche-scheme-table"><thead><tr>{copy.tableColumns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{schemes.map(scheme => <tr><th scope="row"><strong>{scheme.name}</strong><span>{scheme.issuer} · {scheme.region}</span></th><td class="fiche-langs">{scheme.languages}</td><td data-scheme-table={scheme.id}>—</td></tr>)}</tbody></table>
   </div>
  </div>
 </div></section>

 <section class="atlas-section" id="apercu"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.previewKicker}</p><h2>{copy.previewTitle}</h2></div><p class="atlas-section-intro">{copy.previewIntro}</p></div>
  <div class="fiche-preview-grid">
   <slot />
   <div class="atlas-preview fiche-scheme-viewer" data-class-viewer>
    <div class="atlas-preview-tools"><h3>{copy.viewerTitle}</h3><a href="/api/catalog/classifications?format=csv" class="atlas-text-link">{copy.sample} ↓</a></div>
    <div class="atlas-preview-formats" data-class-tabs hidden><div role="group" aria-label={copy.viewerLabel}>{schemes.map((scheme, index) => <button type="button" data-scheme={scheme.id} aria-pressed={index === 1 ? "true" : "false"} aria-controls="class-sample-table">{scheme.name.replace(`${rev} `, "")}</button>)}</div><span>{copy.viewerNote}</span></div>
    <div class="atlas-table-scroll" id="class-sample-table" tabindex="0" role="region" aria-label={copy.viewerRegion}><table class="atlas-table fiche-class-table"><thead><tr>{copy.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody data-class-rows></tbody></table></div>
    <p class="atlas-preview-status" data-class-status role="status">{copy.waiting}</p>
    <noscript class="atlas-noscript">{copy.viewerNojs}</noscript>
   </div>
  </div>
 </div></section>

 <section class="atlas-section atlas-method" id="archive"><div class="atlas-shell">
  <div class="atlas-section-head" data-atlas-enter><div><p class="atlas-kicker">{copy.archiveKicker}</p><h2>{copy.archiveTitle}</h2></div><a class="atlas-text-link" href={L("/legal/provenance")}>{copy.provenance} ↗</a></div>
  <div class="fiche-archive">
   <div class="fiche-window" data-atlas-enter>
    <div class="atlas-window-title"><span>{copy.archiveWindow}</span><span aria-hidden="true">ZIP</span></div>
    <div class="fiche-window-body">{copy.groups.map(([title, text, files]) => <div class="fiche-file-group"><div><strong>{title}</strong><small>{text}</small></div><ul>{(files as string[]).map(file => <li><code>{file}</code></li>)}</ul></div>)}</div>
   </div>
   <div class="fiche-archive-side" data-atlas-enter>
    <ul class="atlas-limits">{copy.limits.map(item => <li>{item}</li>)}</ul>
    <p class="fiche-pro">{copy.pro}</p>
    <div class="fiche-mcp"><p class="atlas-kicker">MCP · cross_walk</p><h3>{copy.mcpTitle}</h3><p>{copy.mcpText}</p><a class="atlas-text-link" href={`${L("/mcp")}#install`}>{copy.mcpLink} ↗</a></div>
   </div>
  </div>
 </div></section>

 <section class="atlas-section atlas-faq"><div class="atlas-shell atlas-faq-grid"><div data-atlas-enter><p class="atlas-kicker">{copy.faqKicker}</p><h2 class="atlas-section-title">{copy.faqTitle}</h2><a href={L("/legal/cgv")} class="atlas-text-link">{copy.terms} ↗</a></div><div>{copy.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

 <section class="atlas-shell" id="acheter"><div class="atlas-purchase" data-atlas-enter><div><p class="atlas-kicker">{copy.purchaseKicker}</p><h2>{copy.delivery}</h2><p>{copy.serviceText}</p><div class="atlas-actions"><a href="mailto:contact@openswissdata.com" class="atlas-text-link">{copy.contact} ↗</a><a href={L("/account")} class="atlas-text-link">{copy.account} ↗</a></div></div><div class="atlas-purchase-box"><p>{copy.price}</p><div class="atlas-purchase-price"><strong>{offer.price}</strong><span>CHF</span></div><p>{copy.updates}</p><form method="POST" action="/api/checkout/start"><input type="hidden" name="locale" value={lang}/><input type="hidden" name="dataset_ids" value="classifications"/><button class="atlas-btn" type="submit">{copy.buyClass}<span aria-hidden="true">↗</span></button></form><CheckoutNotice /></div></div><p class="fiche-bundle-line">{copy.bundle} <a href={L("/bundle")}>{copy.bundleLink} ↗</a></p><p class="atlas-live-note">{copy.independent}</p></section>
</div>
<script>
 import '../scripts/classifications-product';
</script>
</AtlasLayout>
