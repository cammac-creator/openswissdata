{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "node dist/index.js",
    "healthcheckPath": "/api/health/ready",
    "healthcheckTimeout": 180
  },
  "build": {
    "watchPatterns": [
      "src/**",
      "web/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "railway.json",
      "Dockerfile",
      "nixpacks.toml"
    ]
  }
}
