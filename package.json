{
  "name": "openswissdata",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && mkdir -p dist/db dist/mcp/data && cp src/db/schema.sql dist/db/schema.sql && cp -r src/db/migrations dist/db/migrations && cp src/mcp/data/*.csv dist/mcp/data/ && cp -r src/mcp/data/embeddings dist/mcp/data/embeddings && node dist/scripts/prepare-translation.js && node dist/scripts/prepare-embedding.js && npm run web:build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "security:public": "node scripts/check-public-repository.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx/esm src/db/seed.ts",
    "etl:tares": "tsx etl/tares/release.ts",
    "etl:classifications": "tsx etl/classifications/release.ts",
    "etl:finma": "tsx etl/finma/release.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "backup:db:dry": "tsx scripts/backup-db.ts --dry-run",
    "cleanup:expired": "tsx scripts/cleanup-expired.ts",
    "sync:versions": "tsx scripts/sync-dataset-versions.ts",
    "web:dev": "cd web && npx astro dev",
    "web:build": "npm --prefix web ci && npm --prefix web run build && npm run seo:check",
    "models:prepare:embedding": "tsx src/scripts/prepare-embedding.ts",
    "seo:check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "1.19.17",
    "@huggingface/transformers": "3.8.1",
    "@sentry/node": "10.75.3",
    "@types/yauzl": "^2.10.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.5.0",
    "csv-parse": "7.0.3",
    "csv-stringify": "^6.7.0",
    "franc-min": "^6.2.0",
    "hono": "4.13.9",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "nace-codes": "^1.0.3",
    "parquetjs-lite": "^0.8.7",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "sharp": "0.35.4",
    "esbuild": "0.28.2"
  }
}
