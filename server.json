{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cammac-creator/openswissdata",
  "title": "OpenSwissData",
  "description": "Swiss customs tariff (TARES), FINMA register and warnings, NOGA/NACE/ISIC codes. 3 free tools.",
  "version": "0.3.0",
  "websiteUrl": "https://www.openswissdata.com",
  "repository": {
    "url": "https://github.com/cammac-creator/openswissdata",
    "source": "github",
    "subfolder": "sdks/mcp-server"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@openswissdata/mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENSWISSDATA_API_KEY",
          "description": "Optional existing OAuth token for Pro tools (closed to new subscribers). Without it: 3 free tools, 100 calls/hour/IP.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "OPENSWISSDATA_BASE_URL",
          "description": "Override the remote MCP endpoint (default: https://mcp.openswissdata.com). Useful for staging or self-hosting.",
          "isRequired": false,
          "format": "string",
          "default": "https://mcp.openswissdata.com"
        },
        {
          "name": "OPENSWISSDATA_TIMEOUT_MS",
          "description": "Per-request timeout in milliseconds.",
          "isRequired": false,
          "format": "string",
          "default": "30000"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.openswissdata.com/jsonrpc"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tags": [
        "swiss",
        "switzerland",
        "customs",
        "tariff",
        "hs-code",
        "tares",
        "finma",
        "kyc",
        "noga",
        "nace",
        "isic",
        "compliance"
      ],
      "categories": [
        "government",
        "compliance",
        "finance"
      ]
    }
  }
}
