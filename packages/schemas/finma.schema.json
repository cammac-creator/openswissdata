{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openswissdata.com/schemas/finma/v1",
  "title": "FINMA Registry Dataset",
  "description": "FINMA authorised institutions registry (unified from FINMA's public source lists)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["entity_type", "name", "source_list", "source_url"],
    "properties": {
      "entity_type": {
        "enum": [
          "bank",
          "insurance",
          "asset_manager_collective",
          "asset_manager_individual",
          "securities_firm",
          "fund_representative",
          "payment_institution",
          "supervisory_org",
          "insurance_intermediary",
          "fintech",
          "infrastructure",
          "other"
        ]
      },
      "name": { "type": "string" },
      "uid": { "type": "string", "pattern": "^CHE-\\d{3}\\.\\d{3}\\.\\d{3}$" },
      "lei": { "type": "string", "pattern": "^[A-Z0-9]{20}$" },
      "licence_type": { "type": "string" },
      "licence_date": { "type": "string", "format": "date" },
      "status": { "type": "string" },
      "canton": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "address": { "type": "string" },
      "source_list": { "type": "string" },
      "source_url": { "type": "string", "format": "uri" },
      "supervisory_organisation": {
        "type": "string",
        "description": "Portfolio managers and trustees only: the supervisory organisation that supervises the institution under the Financial Institutions Act (FinIA), as named in FINMA's list vvtr.xlsx. This is not a self-regulatory organisation (SRO) affiliation under the Anti-Money Laundering Act (AMLA). Empty unless name and city match exactly and unambiguously."
      },
      "supervisory_organisation_source_url": { "type": "string", "format": "uri" },
      "supervisory_organisation_observed_on": { "type": "string", "format": "date" }
    }
  }
}
